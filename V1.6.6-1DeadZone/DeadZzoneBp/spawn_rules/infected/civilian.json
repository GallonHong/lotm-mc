{
  "format_version": "1.17.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "mcpe:civilian",
      "population_control": "monster"
    },
    "conditions": [
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:brightness_filter": {
          "min": 0,
          "max": 15,
          "adjust_for_weather": false
        },
        "minecraft:difficulty_filter": {
          "min": 0,
          "max": 2
        },
        "minecraft:herd": {
          "min_size": 3,
          "max_size": 10
        },
        "minecraft:weight": {
          "default": 50
        },
        "minecraft:permute_type": {
          "pool": [
            {
              "weight": 50
            },
            {
              "weight": 45,
              "type": "mcpe:acreamer"
            },
            {
              "weight":20,
              "type": "mcpe:militia"
            }
          ]
        },
        "minecraft:biome_filter": [
          {
            "any_of": [
              {
                "test": "has_biome_tag",
                "operator": "==",
                "value": "overworld"
              },
              {
                "test": "has_biome_tag",
                "operator": "==",
                "value": "overworld_generation"
              }
            ]
          }
        ]
      }
    ]
  }
}