{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "mythicus_sn:airborne_orange_leaves",
            "basic_render_parameters": {
                "material": "particles_alpha",
                "texture": "textures/mythicus/sn/particle/orange_leaf"
            }
        },
        "curves": {
            "variable.size": {
                "type": "linear",
                "input": "v.particle_age",
                "horizontal_range": "v.particle_lifetime",
                "nodes": [0, 0.5, 0.75, 0.88, 0.94, 0.97, 0.99, 1, 1, 1, 1, 1, 0.99, 0.97, 0.94, 0.88, 0.75, 0.5, 0]
            }
        },
        "events": {
            "spawn_surface": {
                "particle_effect": {
                    "effect": "mythicus_sn:surface_orange_leaves",
                    "type": "emitter_bound"
                },
                "expression": "t.season_image = v.data.x;"
            }
        },
        "components": {
            "minecraft:emitter_rate_steady": {
                "spawn_rate": 2,
                "max_particles": 4
            },
            "minecraft:emitter_lifetime_once": {
                "active_time": 30
            },
            "minecraft:emitter_shape_box": {
                "half_dimensions": [0.5, 0.5, 0.5],
                "direction": [1, 0, 1]
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": 11
            },
            "minecraft:particle_expire_if_in_blocks": ["minecraft:water"],
            "minecraft:particle_lifetime_events": {
                "expiration_event": "spawn_surface"
            },
            "minecraft:particle_initial_spin": {
                "rotation": "math.random(0,360)",
                "rotation_rate": 720
            },
            "minecraft:particle_initial_speed": "math.random(1,3)",
            "minecraft:particle_motion_dynamic": {
                "linear_acceleration": [0, "math.random(-0.33,-0.99)", 0],
                "linear_drag_coefficient": "math.random(0.33,0.99)",
                "rotation_drag_coefficient": 1
            },
            "minecraft:particle_appearance_billboard": {
                "size": ["0.1*variable.size", "0.1*variable.size"],
                "facing_camera_mode": "rotate_xyz",
                "uv": {
                    "texture_width": 80,
                    "texture_height": 10,
                    "uv": ["variable.data.x*5", "math.round(variable.particle_random_1)*5"],
                    "uv_size": [4, 4]
                }
            },
            "minecraft:particle_motion_collision": {
                "enabled": "v.particle_age >= 1",
                "collision_drag": 3,
                "collision_radius": 0.02,
                "expire_on_contact": true
            },
            "minecraft:particle_appearance_lighting": {}
        }
    }
}
