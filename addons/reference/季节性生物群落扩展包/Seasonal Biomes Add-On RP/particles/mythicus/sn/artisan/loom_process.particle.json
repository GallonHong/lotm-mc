{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "mythicus_sn:loom_process",
            "basic_render_parameters": {
                "material": "particles_alpha",
                "texture": "textures/mythicus/sn/particle/loom_string"
            }
        },
        "curves": {
            "variable.size": {
                "type": "bezier",
                "input": "v.particle_age",
                "horizontal_range": "v.particle_lifetime",
                "nodes": [
                    0,
                    1,
                    1,
                    1
                ]
            }
        },
        "events": {
            "pop": {
                "particle_effect": {
                    "effect": "mythicus_sn:loom_pop",
                    "type": "emitter"
                }
            }
        },
        "components": {
            "minecraft:emitter_rate_steady": {
                "spawn_rate": 7,
                "max_particles": 100
            },
            "minecraft:emitter_lifetime_once": {
                "active_time": 1
            },
            "minecraft:emitter_shape_box": {
                "offset": [
                    "variable.offset_x*1.1",
                    -0.25,
                    "variable.offset_z*1.1"
                ],
                "half_dimensions": [
                    "variable.offset_z*0.8",
                    0.15,
                    "variable.offset_x*0.8"
                ],
                "surface_only": true,
                "direction": "outwards"
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": "math.random(1,2)"
            },
            "minecraft:particle_lifetime_events": {
                "creation_event": "pop"
            },
            "minecraft:particle_initial_spin": {
                "rotation": "math.round(v.particle_random_3*3)*90"
            },
            "minecraft:particle_initial_speed": 0,
            "minecraft:particle_motion_dynamic": {},
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "0.1*variable.size",
                    "0.1*variable.size"
                ],
                "facing_camera_mode": "rotate_xyz",
                "uv": {
                    "texture_width": 16,
                    "texture_height": 8,
                    "uv": [
                        "math.round(variable.particle_random_1)*8",
                        0
                    ],
                    "uv_size": [
                        8,
                        8
                    ]
                }
            },
            "minecraft:particle_appearance_lighting": {}
        }
    }
}
