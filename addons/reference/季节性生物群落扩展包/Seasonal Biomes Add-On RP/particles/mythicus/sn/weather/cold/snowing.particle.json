{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "mythicus_sn:snowing",
            "basic_render_parameters": {
                "material": "particles_alpha",
                "texture": "textures/mythicus/sn/particle/snowing"
            }
        },
        "components": {
            "minecraft:emitter_rate_steady": {
                "spawn_rate": "(variable.speed.z+1)*(300/5)",
                "max_particles": "(variable.speed.z+1)*(5000/5)"
            },
            "minecraft:emitter_lifetime_once": {
                "active_time": 1
            },
            "minecraft:emitter_shape_disc": {
                "radius": 32,
                "surface_only": true,
                "direction": [
                    0,
                    -1,
                    0
                ]
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": "math.random(16,32)"
            },
            "minecraft:particle_expire_if_not_in_blocks": [
                "minecraft:air"
            ],
            "minecraft:particle_initial_speed": 64,
            "minecraft:particle_motion_parametric": {
                "relative_position": [
                    "(v.particle_random_3*64)-32 + math.sin(v.particle_age*180)",
                    "(192 - variable.speed.y) * math.exp(-16 * (v.particle_age/v.particle_lifetime)) - ( 1 * v.particle_age) - (192 - variable.speed.y)",
                    "(v.particle_random_4*64)-32 + math.sin(v.particle_age*90)"
                ]
            },
            "minecraft:particle_appearance_billboard": {
                "size": [
                    0.2,
                    0.2
                ],
                "facing_camera_mode": "lookat_xyz",
                "uv": {
                    "texture_width": 40,
                    "texture_height": 5,
                    "uv": [
                        "math.round(v.particle_random_3*7)*5",
                        0
                    ],
                    "uv_size": [
                        5,
                        5
                    ]
                }
            },
            "minecraft:particle_motion_collision": {
                "collision_radius": 0.1,
                "expire_on_contact": true
            },
            "minecraft:particle_appearance_lighting": {}
        }
    }
}
