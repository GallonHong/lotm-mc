                "ctl_baby": "controller.animation.villager_v2.baby",
                "ctl_raise_arms": "controller.animation.villager_v2.raise_arms",
                "ctl_move": "controller.animation.villager_v2.move",
                "ctl_general": "controller.animation.villager_v2.general"
            },
            "render_controllers": [
                "controller.render.mythicus_sn.base_villager",
                {
                    "controller.render.mythicus_sn.spring_season_villager": "q.property('mythicus_sn:season_variant') == 'spring'"
                },
                {
                    "controller.render.mythicus_sn.winter_season_villager": "q.property('mythicus_sn:season_variant') == 'winter'"
                },
                {
                    "controller.render.mythicus_sn.fall_season_villager": "q.property('mythicus_sn:season_variant') == 'fall'"
                },
                {
                    "controller.render.mythicus_sn.summer_season_villager": "q.property('mythicus_sn:season_variant') == 'summer'"
                }
            ],
            "spawn_egg": {
