{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "identifier": "mythicus_sn:seasons_sheep",
            "min_engine_version": "1.8.0",
            "materials": {
                "default": "mythicus_sn_sheep"
            },
            "textures": {
                "default": "textures/mythicus/sn/entity/mobs/sheep/sheep",
                "winter": "textures/mythicus/sn/entity/mobs/sheep/winter_sheep",
                "leaves_1": "textures/mythicus/sn/entity/mobs/sheep/sheep_leaves_1",
                "leaves_2": "textures/mythicus/sn/entity/mobs/sheep/sheep_leaves_2",
                "leaves_3": "textures/mythicus/sn/entity/mobs/sheep/sheep_leaves_3",
                "leaves_4": "textures/mythicus/sn/entity/mobs/sheep/sheep_leaves_4",
                "flower.allium": "textures/mythicus/sn/entity/mobs/sheep/allium_sheep",
                "flower.azure_bluet": "textures/mythicus/sn/entity/mobs/sheep/azure_bluet_sheep",
                "flower.blue_orchid": "textures/mythicus/sn/entity/mobs/sheep/blue_orchid_sheep",
                "flower.cornflower": "textures/mythicus/sn/entity/mobs/sheep/cornflower_sheep",
                "flower.daisy": "textures/mythicus/sn/entity/mobs/sheep/daisy_sheep",
                "flower.dandelion": "textures/mythicus/sn/entity/mobs/sheep/dandelion_sheep",
                "flower.orange_tulip": "textures/mythicus/sn/entity/mobs/sheep/orange_tulip_sheep",
                "flower.pink_tulip": "textures/mythicus/sn/entity/mobs/sheep/pink_tulip_sheep",
                "flower.poppyrose": "textures/mythicus/sn/entity/mobs/sheep/poppyrose_sheep",
                "flower.red_tulip": "textures/mythicus/sn/entity/mobs/sheep/red_tulip_sheep"
            },
            "geometry": {
                "default": "geometry.mythicus_sn.seasons_sheep"
            },
            "animations": {
                "walk": "animation.mythicus_sn.seasons_sheep.quadruped.walk",
                "look_at_target": "animation.common.look_at_target",
                "baby_transform": "animation.sheep.baby_transform",
                "wool_summer": "animation.mythicus_sn.seasons_sheep.wool_summer",
                "wool_fall": "animation.mythicus_sn.seasons_sheep.wool_fall",
                "sheared": "animation.mythicus_sn.seasons_sheep.sheared",
                "shake": "animation.mythicus_sn.seasons_sheep.shake",
                "shiver": "animation.mythicus_sn.seasons_sheep.shiver",
                "season_growth.controller": "controller.animation.mythicus_sn.seasons_sheep.growth",
                "shake.controller": "controller.animation.mythicus_sn.seasons_sheep.shake",
                "shiver.controller": "controller.animation.mythicus_sn.seasons_sheep.shiver",
                "cold_breath.controller": "controller.animation.mythicus_sn.generic.breath",
                "cold_breath": "animation.mythicus_sn.generic.cold_breath",
                "snow_shake": "animation.mythicus_sn.generic.snow_shake",
                "leaf_shake": "animation.mythicus_sn.generic.leaf_shake"
            },
            "scripts": {
                "animate": [
                    "season_growth.controller",
                    "shake.controller",
                    "shiver.controller",
                    {
                        "walk": "query.modified_move_speed"
                    },
                    "look_at_target",
                    {
                        "baby_transform": "query.is_baby"
                    },
                    "cold_breath.controller"
                ],
                "pre_animation": [
                    "v.season = query.property('mythicus_sn:season_variant');",
                    "v.flower = query.property('mythicus_sn:flower_variant');",
                    "v.leaves_level = query.property('mythicus_sn:leaves_level');",
                    "v.snow_level = query.property('mythicus_sn:covered_in_snow_level');",
                    "v.is_sheared = query.is_sheared;"
                ]
            },
            "render_controllers": [
                "controller.render.mythicus_sn.seasons_sheep.base",
                {
                    "controller.render.mythicus_sn.seasons_sheep.flowers": "q.property('mythicus_sn:season_variant') == 'spring' && q.property('mythicus_sn:flower_variant') > 0"
                },
                {
                    "controller.render.mythicus_sn.seasons_sheep.leaves": "q.property('mythicus_sn:covered_in_leaves')"
                },
                {
                    "controller.render.mythicus_sn.seasons_sheep.snow": "q.property('mythicus_sn:covered_in_snow')"
                }
            ],
            "particle_effects": {
                "walking_leaves": "mythicus_sn:orange_leaves",
                "walking_snow": "minecraft:snowflake_particle",
                "cold_breath": "mythicus_sn:cold_breath_mob",
                "snow_shake": "mythicus_sn:snow_shake",
                "leaf_shake": "mythicus_sn:leaf_shake"
            },
            "spawn_egg": {
                "texture": "mythicus_sn:spawn_egg_sheep"
            }
        }
    }
}
