                "minecraft:loot": {
                    "table": "loot_tables/entities/chicken.json"
                },
                "minecraft:leashable_to": {
                },
                "minecraft:breedable": {
                    "require_tame": false,
                    "breeds_with": {
                        "mate_type": "mythicus_sn:seasons_chicken",
                        "baby_type": "mythicus_sn:seasons_chicken",
