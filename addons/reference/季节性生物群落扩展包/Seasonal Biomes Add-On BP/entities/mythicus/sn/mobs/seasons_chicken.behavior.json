        "component_groups": {
            "mythicus_sn:find_nest": {
                "minecraft:behavior.move_to_block": {
                    "priority": 4,
                    "speed_multiplier": 1.0,
                    "goal_radius": 0.5,
                    "search_range": 16,
                    "search_height": 2,
                    "target_blocks": [
                        "mythicus_sn:chicken_nest"
                    ],
                    "on_reach": {
