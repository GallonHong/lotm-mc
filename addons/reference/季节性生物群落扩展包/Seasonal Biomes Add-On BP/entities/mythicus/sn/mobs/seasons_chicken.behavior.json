                    },
                    "breed_items": [
                        "wheat_seeds",
                        "beetroot_seeds",
                        "melon_seeds",
                        "pumpkin_seeds",
                        "pitcher_pod",
                        "torchflower_seeds"
                    ],
                    "property_inheritance": {
                        "mythicus_sn:season_variant": {}
                    }
