{
    "format_version": "1.21.0",
    "minecraft:feature_rules": {
        "conditions": {
            "placement_pass": "after_surface_pass",
            "minecraft:biome_filter": [
                {
                    "all_of": [
                        {
                            "test": "has_biome_tag",
                            "value": "mythicus_sn_seasonal_plains",
                            "operator": "=="
                        }
                    ]
                }
            ]
        },
        "description": {
            "identifier": "mythicus_sn:plains_short_grass_scatter",
            "places_feature": "mythicus_sn:mythicus/sn/plains/short_grass"
        },
        "distribution": {
            "iterations": 20,
            "scatter_chance": 100,
            "coordinate_eval_order": "zxy",
            "x": { "extent": [0, 15], "distribution": "uniform" },
            "y": "query.heightmap(variable.worldx, variable.worldz)",
            "z": { "extent": [0, 15], "distribution": "uniform" }
        }
    }
}
