{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.ak74u_oldreload": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"reload_start0": "q.get_equipped_item_name(0) == 'ak74u_old' && (q.scoreboard('ak74ures') == 0) && (q.scoreboard('ak74u') == 0)"
						}
					]
                               },
				"reload_start0": {
					"on_entry": [
						"/title @s actionbar NO AMMO"
					],
					"animations": [
						"reload0"
					],
					"transitions": [
						{
							"default": "(q.all_animations_finished)"
						}
					]
				}
			}
		}
	}
}