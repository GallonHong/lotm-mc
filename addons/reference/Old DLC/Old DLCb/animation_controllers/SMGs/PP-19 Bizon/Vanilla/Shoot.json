{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.bizon_old": {
			"initial_state": "inactive",
			"states": {
				"inactive": {
					"transitions": [
						{
							"fire": "q.get_equipped_item_name(0) == 'bizon_old' && q.is_using_item && (q.scoreboard('bizon') >= 1) && (q.scoreboard('reload') != 4)"
						}
					]
				},
				"firing": {
					"on_entry": [
						"v.bullet_fire = q.life_time;"
					],
					"transitions": [
						{
							"inactive": "q.get_equipped_item_name(0) != 'bizon_old' || !q.is_using_item || (q.scoreboard('bizon') == 0) || (q.scoreboard('reload') == 4)"
						},
						{
							"fire": "(q.life_time - v.bullet_fire) >= 0.03"
						}
					]
				},
				"fire": {
					"on_entry": [
						"@s bizon_old:fire",
						"/scoreboard players remove @s[m=!c,scores={bizon=1..64}] bizon 1",
						"/particle minecraft:eyeofender_death_explode_particle ^ ^1 ^1",
						"/camerashake add @s 0.1265 0.1 rotational",
                                                "/execute @s[scores={bizon=0}] ~~~ function show406_2",
						"/summon sound:bizon_old ^^^"
					],
					"transitions": [
						{
							"firing": "1.0"
						}
					],
					"on_exit": [
						"v.bullet_fire = q.life_time;"
					]
				}
			}
		}
	}
}