			"geometry": {
				"default": "geometry.infected",
				"slim": "geometry.infected_slim"
			},
			"scripts": {
				"initialize": [
					"v.target_yaw = 0;"
				],
				"pre_animation": [
					"v.tcos0 = (Math.cos(q.modified_distance_moved * 38.17) * q.modified_move_speed / v.gliding_speed_value) * 57.3;",
					"v.body_rot = math.sin(q.body_y_rotation-v.target_yaw) * 90;",
					"v.gender = q.property('mcpe:gender');",
					"v.spotted = q.property('mcpe:spotted');",
					"v.death = q.property('mcpe:death');",
					"v.type = q.property('mcpe:type');",
					"v.mouth = q.property('mcpe:mouth');",
					"v.top = q.property('mcpe:top');",
					"v.bottom = q.property('mcpe:bottom');",
					"v.male_eyes = q.property('mcpe:male_eyes');",
					"v.male_sprinter_eyes = q.property('mcpe:male_sprinter_eyes');",
					"v.female_eyes = q.property('mcpe:female_eyes');",
					"v.male_hair = q.property('mcpe:male_hair');",
					"v.female_hair = q.property('mcpe:female_hair');",
					"v.male_skin = q.property('mcpe:male_skin');",
					"v.female_skin = q.property('mcpe:female_skin');",
					"v.dead = q.property('mcpe:dead');",
					"v.head_pose = q.property('mcpe:head_pose');",
					"v.body_pose = q.property('mcpe:body_pose');",
					"v.attack_random = math.random_integer(1, 3);"
				],
				"animate": [
					"root",
					"spotted_controller",
					"attack_controller",
					"rotate_controller",
					{
						"look_at_target_controller": "!v.dead"
					},
					{
						"death_controller": "v.dead"
					},
					{
						"head_pose_controller": "v.head_pose && !v.dead"
					},
					{
						"body_pose_controller": "v.body_pose && !v.dead"
					}
				]
			},
			"animations": {
				"root": "controller.animation.infected.root",
				"look_at_target_controller": "controller.animation.humanoid.look_at_target",
				"look_at_target_default": "animation.humanoid.look_at_target.default",
				"look_at_target_gliding": "animation.humanoid.look_at_target.gliding",
				"look_at_target_swimming": "animation.humanoid.look_at_target.swimming",
				"walk": "animation.infected.move",
				"run": "animation.infected.runner",
				"idle": "animation.infected.bob2",
				"jump": "animation.infected.jump",
				"crawler": "animation.infected.crawl.move",
				"spotted_male": "animation.infected.spotted_male",
				"spotted_female": "animation.infected.spotted_female",
				"attack1": "animation.infected.attack1",
				"attack2": "animation.infected.attack2",
				"attack3": "animation.infected.attack3",
				"rotate_right": "animation.rotate_right",
				"rotate_left": "animation.rotate_left",
				
				"spotted_controller": "controller.animation.infected.spotted",
				"head_pose_controller": "controller.animation.head_pose",
				"body_pose_controller": "controller.animation.body_pose",
				"death_controller": "controller.animation.death.general",
				"attack_controller": "controller.animation.infected.attack",
				"rotate_controller": "controller.animation.rotate",
				
