				"controller.render.variant_mouth",
				"controller.render.militia_top",
				"controller.render.militia_bottom",
				{
					"controller.render.male_hair": "v.gender == 'male'"
				},
				{
					"controller.render.female_hair": "v.gender == 'female'"
				},
				{
					"controller.render.male_eyes": "v.gender == 'male' && v.type == 'normal' && !v.dead"
				},
				{
					"controller.render.male_sprinter_eyes": "v.gender == 'male' && v.type == 'runner' && !v.dead"
				},
				{
					"controller.render.female_eyes": "v.gender == 'female' && v.type == 'normal' && !v.dead"
				},
				{
					"controller.render.female_sprinter_eyes": "v.gender == 'female' && v.type == 'runner' && !v.dead"
				}
			],
