{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.dg.run": {
            "initial_state": "default",
            "states": {
                "default": {
                    "animations": [
                        {
                            "dg_first_person": "variable.dg"
                        }
                    ],
                    "transitions": [
                        {
                            "hold_to_run": "variable.dg && q.is_sprinting && q.is_on_ground"
                        },
                        {
                            "scope": "variable.dg && q.is_sneaking && q.is_alive"
                        },
                        {
                            "fire": "variable.dg && q.item_remaining_use_duration > 1 && q.is_alive"
                        }
                    ]
                },
                "hold_to_run": {
                    "animations": [
                        "dg_first_person_hold_to_run"
                    ],
                    "transitions": [
                        {
                            "run": "q.all_animations_finished"
                        }
                    ]
                },
                "run": {
                    "animations": [
                        "dg_first_person_run"
                    ],
                    "transitions": [
                        {
                            "run_to_hold": "!q.is_on_ground || !q.is_sprinting || !variable.dg || !q.is_alive"
                        },
                        {
                            "fire": "variable.dg && q.item_remaining_use_duration > 1 && q.is_alive"
                        }
                    ]
                },
                "run_to_hold": {
                    "animations": [
                        "dg_first_person_run_to_hold"
                    ],
                    "transitions": [
                        {
                            "default": "q.all_animations_finished"
                        }
                    ]
                },
                "scope": {
                    "animations": [
                        "dg_first_person_scope"
                    ],
                    "transitions": [
                        {
                            "default": "!q.is_sneaking || !variable.dg || !q.is_alive"
                        },
                        {
                            "scopehold": "q.all_animations_finished || !q.is_alive"
                        }
                    ]
                },
                "scopehold": {
                    "animations": [
                        "dg_first_person_scopehold"
                    ],
                    "transitions": [
                        {
                            "scopehold_to_default": "!q.is_sneaking"
                        },
                        {
                            "default": "!variable.dg || !q.is_alive"
                        },
                        {
                            "scopefire": "q.item_remaining_use_duration > 1 || !q.is_alive"
                        }
                    ]
                },
                "scopehold_to_default": {
                    "animations": [
                        "dg_first_person_scopehold_to_default"
                    ],
                    "transitions": [
                        {
                            "default": "q.all_animations_finished || !q.is_alive"
                        }
                    ]
                },
                "fire": {
                    "animations": [
                        "dg_first_person_fire1"
                    ],
                    "transitions": [
                        {
                            "default": "!variable.dg || !q.is_using_item || !q.is_alive"
                        },
                        {
                            "scope": "q.is_sneaking"
                        }
                    ]
                },
                "scopefire": {
                    "animations": [
                        "dg_first_person_scopefire"
                    ],
                    "transitions": [
                        {
                            "scopehold": "!q.is_using_item || !q.is_alive"
                        },
                        {
                            "scopehold_to_default": "!q.is_sneaking"
                        }
                    ]
                }
            }
        }
    }
}