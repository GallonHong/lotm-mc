{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.jmgs_npc_zombie.main": {
			"initial_state": "idle",
			"states": {
				"idle": {
					"animations": [
						"z_standby",
						"z_idle",
						{"z_target": "query.has_target == 1"}
					],
					"transitions": [
						{"walking": "q.ground_speed > 0.2"},
						{"run": "q.ground_speed > 2.0"}
					],
					"blend_transition": 0.5
				},
				"walking": {
					"animations": [
						"z_idle2",
						"walk",
						{"z_target": "query.has_target == 1"}
					],
					"transitions": [
						{"idle": "q.ground_speed < 0.2"},
						{"run": "q.ground_speed > 2.0"}
					],
					"blend_transition": 0.5
				},
				"run": {
					"animations": [
						"z_idle",
						"run",
						{"z_target": "query.has_target == 1"}
					],
					"transitions": [
						{"walking": "q.ground_speed < 1.2"}
					],
					"blend_transition": 0.5
				}
			}
		}
	}
}