{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.pmo_entity_air_boat_lite": {
			"initial_state": "idle",
			"states": {
				"idle": {
					"animations": ["idle"],
					"transitions": [
						{"walking": "q.ground_speed > 1.0"}
					],
					"blend_transition": 2
				},
				"walking": {
					"animations": ["walk"],
					"transitions": [
						{"idle": "q.ground_speed < 0.5"}
					],
					"blend_transition": 1
				}
			}
		}
	}
}