{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.pmo_entity_bike.main": {
			"initial_state": "standby",
			"states": {
				"standby": {
					"animations": ["spawn"],
					"transitions": [
						{"idle": "query.has_rider == 1"}
					],
					"blend_transition": 1
				},
				"idle": {
					"animations": ["idle"],
					"transitions": [
						{"walk": "query.ground_speed > 1.0"},
						{"standby": "query.has_rider == 0"}
					],
					"blend_transition": 1
				},
				"walk": {
					"animations": ["walk"],
					"transitions": [
						{"idle": "query.ground_speed == 0"},
						{"standby": "query.has_rider == 0"}
					],
					"blend_transition": 1
				}
			}
		}
	}
}