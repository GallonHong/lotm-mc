{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.jmgs_npc_new.attack": {
			"initial_state": "idle",
			"states": {
				"idle": {
					"transitions": [
						{"attacking": "variable.attack_time > 0.0"}
					]
				},
				"attacking": {
					"animations": ["attacking"],
					"transitions": [
						{"idle": "variable.attack_time <= 0.0"}
					]
				}
			}
		}
	}
}