{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": {
			"identifier": "jmgs:item_woodwind",
			"materials": {
				"default": "entity_alphatest",
				"enchanted": "entity_alphatest_glint"
			},
			"textures": {
				"default": "textures/entity/pamobile/pmo_entity_music_woodwind",
				"enchanted": "textures/misc/enchanted_item_glint"
			},
			"geometry": {
				"default": "geometry.jmgs_item_woodwind"
			},
			"scripts": {
				"pre_animation": ["v.main_hand = c.item_slot == 'main_hand';", "v.off_hand = c.item_slot == 'off_hand';"],
				"animate": [
					{
						"hold_first_person": "v.main_hand && c.is_first_person"
					},
					{
						"hold_third_person": "v.main_hand && !c.is_first_person"
					}
				]
			},
			"render_controllers": ["controller.render.item_default"],
			"animations": {
				"hold_first_person": "animation.jmgs_item_woodwind.hold_first_person",
				"hold_third_person": "animation.jmgs_item_woodwind.hold_third_person"
			}
		}
	}
}