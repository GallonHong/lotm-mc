        "blue": "animation.jmgs_entity_none.blue",
        "red": "animation.jmgs_entity_none.red",
        "item": "animation.jmgs_entity_none.item",
        "phone": "animation.jmgs_entity_none.phone",
        "none": "animation.jmgs_entity_none.idle",
        "die": "animation.jmgs_entity_none.die"
