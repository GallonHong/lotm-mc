        "mark_variant_5": "geometry.ewo_bottom_map",
        "mark_variant_6": "geometry.jmgs_none"
      },
      "particle_effects": {
        "white_effects": "jmgs:balloon_gas",
        "blue_effects": "pmo:loading",
        "red_effects": "pmo:magic",
        "item_effects": "jmgs:item",
        "phone_effects": "jmgs:phone"
      },
       "sound_effects": {
        "chest_open": "mob.shulker.bullet.hit"
      },
      "render_controllers": [
        "controller.render.jmgs_entity_none"
      ],
      "enable_attachables": true
