{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "pmo:role_fight5",
      "materials": {
        "default": "skeleton"
      },
      "textures": {
        "default": "textures/entity/pamobile/pmo_role_fight5"
      },
      "geometry": {
        "default": "geometry.pmo_role_fight5"
      },
      "scripts": {
        "animate": [
          {"fly": "query.is_on_ground == 0"},
          "look_at_target",
          "idle",
          {"die": "!query.is_alive"}
        ]
      },
      "animations": {
        "idle": "animation.pmo_role_fight5.idle",
        "fly": "animation.pmo_role_fight5.fly",
        "look_at_target_default": "animation.humanoid.look_at_target.default",
        "look_at_target_gliding": "animation.humanoid.look_at_target.gliding",
        "look_at_target_swimming": "animation.humanoid.look_at_target.swimming",
        "look_at_target": "controller.animation.humanoid.look_at_target",
        "die": "animation.pmo_entity_mecha.boom"
      },
      "spawn_egg": {
        "texture": "pmo:role_fight5",
        "texture_index": 0
      },
      "sound_effects": {
        "fire": "pmo_projectile_a1_shot0",
        "empty": "all_gun_empty",
        "mag_out": "klb_mag_out",
        "boom": "jmgs.build_boom"
      },
      "particle_effects": {
        "large_explosion": "minecraft:large_explosion",
        "jmgs_gunfiresmoke": "jmgs:gunfiresmoke",
        "knockback_roar_particle": "minecraft:knockback_roar_particle",
        "lava_particle": "minecraft:lava_particle",
        "dragon_death_explosion_emitter": "minecraft:dragon_death_explosion_emitter"
      },
      "render_controllers": [
        "controller.render.skeleton"
      ],
      "enable_attachables": true
    }
  }
}