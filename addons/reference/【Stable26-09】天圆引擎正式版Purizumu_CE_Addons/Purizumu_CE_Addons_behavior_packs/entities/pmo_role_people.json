{
  "format_version": "1.12.0",
  "minecraft:entity": {
    "description": {
      "identifier": "pmo:role_people",
      "runtime_identifier": "minecraft:villager",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "lead",
          "toy",
          "skins",
          "villager"
        ]
      },
      "minecraft:breathable": {
        "totalSupply": 15,
        "suffocateTime": 0
      },
      "minecraft:health": {
        "value": 20,
        "max": 20
      },
      "minecraft:collision_box": {
        "height": 1.8,
        "width": 0.6
      },
      "minecraft:nameable": {
        "alwaysShow": false,
        "allowNameTagRenaming": false
      },
      "minecraft:movement": {
        "value": 0.28
      },
      "minecraft:dweller": {
        "dwelling_type": "village",
        "dweller_role": "defender",
        "update_interval_base": 60,
        "update_interval_variant": 40,
        "can_find_poi": false,
        "can_migrate": true,
        "first_founding_reward": 0
      },
      "minecraft:navigation.walk": {
        "is_amphibious": true,
        "can_path_over_water": false,
        "can_pass_doors": true,
        "can_open_doors": true,
        "can_walk": true,
        "avoid_water": true,
        "blocks_to_avoid": [
          {
            "name": "minecraft:gray_concrete"
          }
        ]
      },
      "minecraft:navigation.generic": {
        "avoid_blocks": [
          "minecraft:gray_concrete",
          "minecraft:cyan_terracotta"
        ],
        "avoid_sun": false,
        "can_path_over_blocks": [
          "minecraft:cobblestone",
          "minecraft:stone_block_slab",
          "minecraft:smooth_stone_double_slab"
        ]
      },
      "minecraft:behavior.avoid_block": {
        "priority": 9,
        "tick_interval": 5,
        "search_range": 8,
        "search_height": 4,
        "sprint_speed_modifier": 1.1,
        "target_selection_method": "nearest",
        "target_blocks": [
          "minecraft:gray_concrete",
          "minecraft:cyan_terracotta",
          "minecraft:soul_torch",
          "minecraft:item.soul_campfire"
        ],
        "avoid_block_sound": "retreat",
        "sound_interval": {
          "range_min": 2,
          "range_max": 5
        }
      },
      "minecraft:annotation.open_door": {},
      "minecraft:movement.basic": {},
      "minecraft:can_climb": {},
      "minecraft:damage_sensor": [
        {
          "on_damage": {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "lightning"
            },
            "event": "become_witch"
          },
          "deals_damage": false
        },
        {
          "on_damage": {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "zombie"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "husk"
                }
              ],
              "all_of": [
                {
                  "test": "has_damage",
                  "value": "fatal"
                }
              ]
            },
            "event": "become_zombie"
          }
        }
      ],
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.move_indoors": {
        "priority": 4,
        "speed_multiplier": 0.8
      },
      "minecraft:behavior.restrict_open_door": {
        "priority": 5
      },
      "minecraft:behavior.open_door": {
        "priority": 6,
        "close_door_after": true
      },
      "minecraft:behavior.move_towards_restriction": {
        "priority": 7,
        "speed_multiplier": 0.6
      },
      "minecraft:behavior.share_items": {
        "priority": 8,
        "max_dist": 3,
        "goal_radius": 2,
        "speed_multiplier": 0.5,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "villager"
            }
          }
        ]
      },
      "minecraft:behavior.random_stroll": {
        "priority": 11,
        "speed_multiplier": 0.6
      },
      "minecraft:behavior.look_at_player": {
        "priority": 12,
        "look_distance": 8,
        "probability": 0.02
      },
      "minecraft:physics": {},
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 10 : 0"
