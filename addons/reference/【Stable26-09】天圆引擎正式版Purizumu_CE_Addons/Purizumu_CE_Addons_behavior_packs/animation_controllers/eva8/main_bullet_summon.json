			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"presummon1": "variable.summon = 0.08; variable.presummon = query.life_time; return (q.is_alive);"
						}
					]
				},
				"presummon1": {
					"transitions": [
						{
							"summon1": "(query.life_time - variable.presummon) >= variable.summon"
						}
					]
