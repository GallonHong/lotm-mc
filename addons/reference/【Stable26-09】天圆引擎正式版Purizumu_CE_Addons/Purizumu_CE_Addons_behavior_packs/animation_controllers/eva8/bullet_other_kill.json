{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.eva8_bullet_other_kill": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"die": "variable.hurtdelay = 0.2; variable.previoushurttime = query.life_time; return (q.is_alive);"
						}
					]
				},
				"die": {
					"transitions": [
						{
							"default": "(query.life_time - variable.previoushurttime) >= variable.hurtdelay"
						}
					],
					"on_exit": [
						"/kill @s"
					]
				}
			}
		}
	}
}