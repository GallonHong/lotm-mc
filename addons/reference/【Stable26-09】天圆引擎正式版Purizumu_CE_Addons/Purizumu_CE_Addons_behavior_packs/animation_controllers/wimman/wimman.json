						"/title @s actionbar §b6-6",
						"@s wimman:ammo_6"
					],
					"transitions": [
						{
							"wimman_6_2": "variable.wimmandelay = 0.29; variable.previouswimmantime = query.life_time; return (q.item_remaining_use_duration > 1 && query.get_equipped_item_name == 'wimman' && q.is_alive);"
						},
						{
							"setup": "!query.is_alive"
						}
					]
				},
				"wimman_6_2": {
					"transitions": [
						{
							"wimman_5_1": "(query.life_time - variable.previouswimmantime) >= variable.wimmandelay && query.get_equipped_item_name == 'wimman'"
						}
					],
					"on_entry": [
						"/title @s actionbar §b5-6",
