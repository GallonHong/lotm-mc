# 手机进入菜单
scoreboard players set @a[scores={bar=-7},rxm=88] bar -900
scoreboard players set @a[scores={bar=-6},rxm=88] bar -700
scoreboard players set @a[scores={bar=-5},rxm=88] bar -500
scoreboard players set @a[scores={bar=-4},rxm=88] bar -400
