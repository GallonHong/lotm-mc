# 底部状态栏显示
execute @a[scores={bar=1,notice=..9},rxm=30] ~ ~ ~ titleraw @s actionbar {"rawtext":[{"text":"§c权限：§e"},{"score":{"name":"@s","objective":"level"}},{"text":"§r 声望：§b"},{"score":{"name":"@s","objective":"prestige"}},{"text":"§r 精力：§b"},{"score":{"name":"@s","objective":"global_hp"}},{"text":"§r 主线：§b"},{"score":{"name":"@s","objective":"task"}},{"text":"§r-§b"},{"score":{"name":"@s","objective":"temp"}}]}
execute @a[scores={bar=2,notice=..9},rxm=30] ~ ~ ~ titleraw @s actionbar {"rawtext":[{"text":"§c权限等级"},{"score":{"name":"@s","objective":"level"}},{"text":"§r玩家："},{"selector":"@s"},{"text":"，您已在线§e"},{"score":{"name":"@s","objective":"playtime"}},{"text":"§r分钟"},{"text":" \n金币:§b"},{"score":{"name":"@s","objective":"coin"}},{"text":" §r猫毛：§b"},{"score":{"name":"@s","objective":"hair"}},{"text":" §r声望：§b"},{"score":{"name":"@s","objective":"prestige"}},{"text":" §r校验值：§b"},{"score":{"name":"@s","objective":"temp"}},{"text":"\n§r公会号：§b"},{"score":{"name":"@s","objective":"guild"}},{"text":" §r精力：§b"},{"score":{"name":"@s","objective":"global_hp"}},{"text":" §r警戒值：§b"},{"score":{"name":"@s","objective":"alert"}},{"text":" §r主线进程：§b"},{"score":{"name":"@s","objective":"task"}}]}
execute @a[scores={bar=1..3,notice=..9},rx=30] ~ ~ ~ titleraw @s actionbar {"rawtext":[{"text":"▶ §c"},{"score":{"name":"@s","objective":"level"}},{"text":"§e"},{"score":{"name":"@s","objective":"playtime"}},{"text":"§b"},{"score":{"name":"@s","objective":"task"}},{"text":"§r"},{"score":{"name":"@s","objective":"temp"}},{"text":" ◀"},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[scores={playtime=..3}]"},{"text":"\n§r低头显示状态"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[scores={robber=1..}]"},{"text":"\n§c§l您正被通缉中"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[scores={bar=3}]"},{"text":"\n§d§l战斗模式§e§l"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[scores={bar=3}]"},{"score":{"name":"@s","objective":"mp"}}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[scores={bar=4}]"},{"text":"\n§1§l工程师模式"}]}}]}
execute @a[scores={bar=3,notice=..9},rxm=30] ~ ~ ~ titleraw @s actionbar {"rawtext":[{"text":"§c【战斗模式】§r驾驶员："},{"selector":"@s"},{"text":"，锁敌：§e"},{"selector":"@e[r=100,rm=0.5,c=1,family=monster]"},{"text":"\n§r▶副武："},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[scores={arms1=1}]"},{"text":"§l§b高频刃·长剑§r"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[scores={arms1=2}]"},{"text":"§l§b粒子铳·响尾蛇§r"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[scores={arms1=3}]"},{"text":"§l§b热线铳·战术家§r"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[scores={arms1=4}]"},{"text":"§l§b锁链铳·手锯§r"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[scores={arms1=5}]"},{"text":"§l§b脉冲铳·原子能§r"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[scores={arms1=6}]"},{"text":"§l§b爆能铳·白矮星§r"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[scores={arms1=7}]"},{"text":"§l§b斩舰刀·阿修罗§r"}]}},{"text":"§r ▶主武："},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[scores={arms2=1}]"},{"text":"§l§b霰射弹·火炎§r"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[scores={arms2=2}]"},{"text":"§l§b穿甲弹·迅猛龙§r"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[scores={arms2=3}]"},{"text":"§l§b追踪弹·心流§r"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[scores={arms2=4}]"},{"text":"§l§b爆裂弹·斑蝰蛇§r"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[scores={arms2=5}]"},{"text":"§l§b龙息弹·轰雷§r"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[scores={arms2=6}]"},{"text":"§l§b特种弹·飓风§r"}]}},{"text":"\n§r▶机载武器："},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[scores={arms3=1}]"},{"text":"§l§b35mm高射炮·铁瀑§r"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[scores={arms3=2}]"},{"text":"§l§b中程弹道导弹·地狱魔§r"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[scores={arms3=3}]"},{"text":"§l§b105mm电磁轨道炮·彗星§r"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[scores={arms3=4}]"},{"text":"§l§b390mm天基歼星炮·超新星§r"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[scores={arms3=5}]"},{"text":"§l§b喷气跳跃§r"}]}},{"text":"§r 校验值：§b"},{"score":{"name":"@s","objective":"temp"}},{"text":"\n§r余能§e"},{"score":{"name":"@s","objective":"mp"}},{"text":"§r度"},{"text":"§r 声望：§b"},{"score":{"name":"@s","objective":"prestige"}},{"text":"§r 主线进度：§b"},{"score":{"name":"@s","objective":"task"}}]}
execute @a[tag=admin,scores={bar=5},rxm=30] ~ ~ ~ titleraw @s actionbar {"rawtext":[{"text":"§c【工程师模式】§r操作员："},{"selector":"@s"},{"text":"，您已在线§e"},{"score":{"name":"@s","objective":"playtime"}},{"text":"§r分钟"},{"text":"\n§r▶当前工具："},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[hasitem={item=jmgs:toolbox_brush,location=slot.weapon.mainhand,slot=0}]"},{"text":"§l§b刷子工具§r ▶功能特性：§l§b材料和尺寸可自定义。\n§r▶使用方法：§l§b手持此工具，在脚底填充指定材料。"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[hasitem={item=jmgs:toolbox_paint,location=slot.weapon.mainhand,slot=0}]"},{"text":"§l§b改造工具§r ▶功能特性：§l§b材料和尺寸可自定义。\n§r▶使用方法：§l§b手持此工具，替换附近指定方块为另一个方块。"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[hasitem={item=jmgs:toolbox_shovel,location=slot.weapon.mainhand,slot=0}]"},{"text":"§l§b挖洞工具§r ▶功能特性：§l§b不可自定义半径5圆球挖洞。\n§r▶使用方法：§l§b手持此工具，以自身为圆心挖洞雕刻。"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[hasitem={item=jmgs:toolbox_clone_spawn_egg,location=slot.weapon.mainhand,slot=0}]"},{"text":"§l§b延长工具§r ▶功能特性：§l§bA.向上延长 B.朝前延长 C.斜上延迟。\n§r▶使用方法：§l§b放置此工具，并对其进行重命名为【上、前、斜上】方向可变。"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[hasitem={item=jmgs:toolbox_spot_spawn_egg,location=slot.weapon.mainhand,slot=0}]"},{"text":"§l§b随机工具§r ▶功能特性：§l§b 可以自定义要随机替换的材质。\n§r▶使用方法：§l§b放置后随机替换附近的指定方块。"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[hasitem={item=jmgs:toolbox_line_spawn_egg,location=slot.weapon.mainhand,slot=0}]"},{"text":"§l§b连线工具§r ▶功能特性：§l§b 可自定义连线材料。\n§r▶使用方法：§l§b放置两个此工具，它们会互相靠近，并连线。"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[hasitem={item=jmgs:toolbox_water_spawn_egg,location=slot.weapon.mainhand,slot=0}]"},{"text":"§l§b填坑工具§r ▶功能特性：§l§b 可自定义填坑材质\n§r▶使用方法：§l§b先在坑里倒水，再手持此工具，让水填平。\n放置此工具可以替换水为指定材质。"}]}},{"translate":"%%2","with":{"rawtext":[{"selector":"@s[hasitem={item=jmgs:toolbox_template_spawn_egg,location=slot.weapon.mainhand,slot=0}]"},{"text":"§l§b模板工具§r ▶功能特性：§l§bA.结构模板 B.方块模板 可自定义。\n§r▶使用方法：§l§b放置此工具，并对其进行重命名为【结构模板、方块模板】。"}]}}]}
