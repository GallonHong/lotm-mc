# 天圆终端进入菜单
scoreboard players set @a[tag=admin,scores={bar=11},rxm=88] bar 20
scoreboard players set @a[tag=admin,scores={bar=12},rxm=88] bar 30
scoreboard players set @a[tag=admin,scores={bar=13},rxm=88] bar 50
scoreboard players set @a[tag=admin,scores={bar=14},rxm=88] bar 70
scoreboard players set @a[tag=admin,scores={bar=15},rxm=88] bar 90
scoreboard players set @a[tag=admin,scores={bar=16},rxm=88] bar 120
playsound random.toast @a[tag=admin,scores={bar=10..199},rxm=88] ~ ~ ~ 1 0.7 1

# 天圆终端二级菜单滚回最开始
scoreboard players set @a[scores={bar=29}] bar 21
scoreboard players set @a[scores={bar=40..49}] bar 31
scoreboard players set @a[scores={bar=60..69}] bar 51
scoreboard players set @a[scores={bar=80..89}] bar 71
scoreboard players set @a[scores={bar=99..100}] bar 91
scoreboard players set @a[scores={bar=142..149}] bar 121

