{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.tactile_aim_fpp": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": [
						{
							"awp_delluminated": "!q.is_sneaking"
						}
					],
					"transitions": [
						{
							"m4_fpp_aim": "variable.is_first_person&&variable.tactile_gun&&q.is_sneaking"
						}
					],
					"blend_transition": 0.25,
					"blend_via_shortest_path": true
				},
				"m4_fpp_aim": {
					"animations": [
						{
							"tactile_fpp_aim": "variable.is_first_person&&variable.tactile_gun&&q.property('mk556:scope')=='n'&&q.property('hengker:reload')=='n'"
						},
						{
							"tactile_acog_aim": "variable.is_first_person&&variable.tactile_gun&&q.property('mk556:scope')=='acog'&&q.property('hengker:reload')=='n'"
						},
						{
							"tactile_scout_aim": "variable.is_first_person&&variable.tactile_gun&&q.property('mk556:scope')=='scout'&&q.property('hengker:reload')=='n'"
						},
						{
							"tactile_holo_aim": "variable.is_first_person&&variable.tactile_gun&&q.property('mk556:scope')=='holo'&&q.property('hengker:reload')=='n'"
						},
						{
							"tactile_reddot_aim": "variable.is_first_person&&variable.tactile_gun&&q.property('mk556:scope')=='reddot'&&q.property('hengker:reload')=='n'"
						}
					],
					"transitions": [
						{
							"default": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')||!q.is_sneaking"
						}
					],
					"blend_transition": 0.25,
					"blend_via_shortest_path": true
				}
			}
		},
		"controller.animation.tactile_hold_fpp": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"m4_fpp_draw": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')&&variable.is_first_person"
						}
					]
				},
				"m4_fpp_draw": {
					"animations": [
						{
							"tactile_fpp_draw": "variable.is_first_person&&v.tactile_gun"
						}
					],
					"transitions": [
						{
							"m4_fpp_hold": "v.is_first_person&&variable.tactile_gun&&!q.is_ignited&&q.all_animations_finished"
						},
						{
							"m4_fpp_bolt": "v.is_first_person&&v.tactile_gun&&q.is_ignited&&q.property('pistol:anim')=='loaded'&&q.all_animations_finished"
						}
					],
					"blend_transition": 0.1,
					"blend_via_shortest_path": true
				},
				"m4_fpp_hold": {
					"animations": [
						{
							"tactile_fpp_hold": "variable.is_first_person"
						}
					],
					"transitions": [
						{
							"m4_fpp_run": "!query.is_using_item&&variable.is_first_person&&variable.tactile_gun&&query.is_sprinting"
						},
						{
							"m4_fpp_reload": "variable.is_first_person&&(variable.tactile_gun&&q.property('hengker:reload')=='reload')"
						},
						{
							"m4_fpp_changemag": "variable.is_first_person&&(variable.tactile_gun&&q.property('hengker:reload')=='change')"
						},
						{
							"m4_fpp_shoot": "variable.is_first_person&&v.tactile_gun&&!q.is_ignited&&q.is_using_item&&q.property('pistol:anim')=='loaded'&&!query.is_item_name_any('slot.weapon.offhand',0,'hengker:lencana_polisi')&&q.property('hengker:nomag')=='ada'&&q.property('hengker:reload')=='n'"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')"
						},
						{
							"m4_fpp_inspect": "variable.is_first_person&&(variable.tactile_gun&&q.property('hengker:reload')=='inspect')"
						},
						{
							"m4_fpp_check": "variable.is_first_person&&(variable.tactile_gun&&q.property('hengker:reload')=='check')"
						},
						{
							"m4_fpp_attachment": "variable.is_first_person&&(variable.tactile_gun&&q.property('hengker:reload')=='heal')"
						}
					],
					"blend_transition": 0.15,
					"blend_via_shortest_path": true
				},
				"m4_fpp_check": {
					"animations": [
						{
							"tactile_fpp_check": "variable.is_first_person&&v.tactile_gun"
						}
					],
					"transitions": [
						{
							"m4_fpp_hold": "variable.is_first_person&&v.tactile_gun&&q.is_using_item&&q.all_animations_finished||q.property('hengker:reload')=='n'"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')"
						},
						{
							"m4_fpp_attachment": "variable.is_first_person&&(variable.tactile_gun&&q.property('hengker:reload')=='heal')"
						}
					]
				},
				"m4_fpp_shoot": {
					"animations": [
						{
							"tactile_fpp_shoot": "v.is_first_person&&v.tactile_gun"
						}
					],
					"transitions": [
						{
							"m4_fpp_hold": "v.tactile_gun&&!q.is_ignited&&q.all_animations_finished"
						},
						{
							"m4_fpp_reload": "variable.is_first_person&&(variable.tactile_gun&&q.property('hengker:reload')=='reload')&&q.all_animations_finished"
						},
						{
							"m4_fpp_changemag": "variable.is_first_person&&(variable.tactile_gun&&q.property('hengker:reload')=='change')&&q.all_animations_finished"
						},
						{
							"m4_fpp_inspect": "variable.is_first_person&&(variable.tactile_gun&&q.property('hengker:reload')=='inspect')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')"
						}
					]
				},
				"m4_fpp_bolt": {
					"animations": [
						{
							"tactile_fpp_bolt": "v.is_first_person&&v.tactile_gun"
						}
					],
					"transitions": [
						{
							"m4_fpp_hold": "v.tactile_gun&&!q.is_ignited&&q.all_animations_finished"
						},
						{
							"m4_fpp_inspect": "variable.is_first_person&&(variable.tactile_gun&&q.property('hengker:reload')=='inspect')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')"
						}
					],
					"blend_transition": 0.25,
					"blend_via_shortest_path": true
				},
				"m4_fpp_inspect": {
					"animations": [
						{
							"tactile_inspect": "variable.is_first_person&&v.tactile_gun"
						}
					],
					"transitions": [
						{
							"m4_fpp_hold": "variable.is_first_person&&v.tactile_gun&&q.is_using_item||q.property('hengker:reload')=='n'||q.all_animations_finished"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')"
						},
						{
							"m4_fpp_attachment": "variable.is_first_person&&(variable.tactile_gun&&q.property('hengker:reload')=='heal')"
						}
					]
				},
				"unequip": {
					"animations": [
						{
							"tactile_fpp_unequip": "v.is_first_person"
						}
					],
					"transitions": [
						{
							"default": "!v.tactile_gun"
						},
						{
							"m4_fpp_draw": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')&&q.all_animations_finished"
						}
					]
				},
				"m4_fpp_changemag": {
					"animations": [
						{
							"tactile_fpp_changemag": "variable.is_first_person&&variable.tactile_gun&&q.property('hengker:reload')=='change'"
						}
					],
					"transitions": [
						{
							"default": "!variable.tactile_gun||!q.is_alive"
						},
						{
							"m4_fpp_hold": "variable.tactile_gun&&q.all_animations_finished||q.property('hengker:reload')!='change'"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')"
						},
						{
							"m4_fpp_attachment": "variable.is_first_person&&(variable.tactile_gun&&q.property('hengker:reload')=='heal')"
						}
					]
				},
				"m4_fpp_run": {
					"animations": [
						{
							"tactile_fpp_run": "variable.is_first_person&&variable.tactile_gun&&!q.property('hengker:reload')!='heal'"
						}
					],
					"transitions": [
						{
							"m4_fpp_hold": "variable.is_first_person&&variable.tactile_gun&&!query.is_sprinting&&!q.is_using_item"
						},
						{
							"m4_fpp_reload": "variable.is_first_person&&(variable.tactile_gun&&q.property('hengker:reload')=='reload')"
						},
						{
							"m4_fpp_changemag": "variable.is_first_person&&(v.tactile_gun&&q.property('hengker:reload')=='change')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')"
						},
						{
							"m4_fpp_attachment": "variable.is_first_person&&(variable.tactile_gun&&q.property('hengker:reload')=='heal')"
						}
					],
					"blend_transition": 0.25,
					"blend_via_shortest_path": true
				},
				"m4_fpp_reload": {
					"animations": [
						{
							"tactile_fpp_reload": "variable.is_first_person&&variable.tactile_gun"
						}
					],
					"transitions": [
						{
							"m4_fpp_hold": "variable.is_first_person&&variable.tactile_gun&&(variable.tactile_gun&&q.property('hengker:reload')=='n')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')"
						},
						{
							"m4_fpp_attachment": "variable.is_first_person&&(variable.tactile_gun&&q.property('hengker:reload')=='heal')"
						}
					]
				},
				"m4_fpp_attachment": {
					"animations": [
						{
							"attachment_display": "variable.is_first_person&&q.variant==0"
						},
						{
							"attachment_muzzle": "variable.is_first_person&&q.variant==1"
						},
						{
							"attachment_laser": "variable.is_first_person&&q.variant==2"
						},
						{
							"attachment_scope": "variable.is_first_person&&q.variant==3"
						},
						{
							"attachment_stock": "variable.is_first_person&&q.variant==4"
						},
						{
							"attachment_mag": "variable.is_first_person&&q.variant==5"
						},
						{
							"attachment_grip": "variable.is_first_person&&q.variant==6"
						}
					],
					"transitions": [
						{
							"m4_fpp_hold": "variable.is_first_person&&variable.tactile_gun&&(variable.tactile_gun&&q.property('hengker:reload')=='n')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')"
						}
					],
					"blend_transition": 0.25,
					"blend_via_shortest_path": true
				}
			}
		},
		"controller.animation.tactile_hold_tpp": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": [
						{
							"tactile_tpp_draw": "variable.tactile_gun&&variable.is_third_person"
						}
					],
					"transitions": [
						{
							"m4_tpp_hold": "query.all_animations_finished&&variable.tactile_gun&&variable.is_third_person"
						},
						{
							"m4_tpp_bolt": "v.is_third_person&&v.tactile_gun&&q.is_ignited&&q.property('pistol:anim')=='loaded'&&q.all_animations_finished"
						}
					]
				},
				"m4_tpp_hold": {
					"animations": [
						{
							"tactile_tpp_hold": "variable.is_third_person&&variable.tactile_gun&&!q.is_sneaking"
						},
						{
							"tactile_tpp_aim": "variable.is_third_person&&variable.tactile_gun&&q.is_sneaking"
						}
					],
					"transitions": [
						{
							"m4_tpp_run": "variable.is_third_person&&variable.tactile_gun&&query.is_sprinting"
						},
						{
							"m4_tpp_reload": "variable.is_third_person&&(variable.tactile_gun&&q.property('hengker:reload')=='reload')"
						},
						{
							"m4_tpp_changemag": "variable.is_third_person&&(v.tactile_gun&&q.property('hengker:reload')=='change')"
						},
						{
							"m4_tpp_shoot": "variable.is_third_person&&(v.tactile_gun&&q.property('hengker:reload')=='n')&&!q.is_ignited&&q.is_using_item&&q.property('pistol:anim')=='loaded'&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')&&q.property('hengker:nomag')=='ada'"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')"
						}
					]
				},
				"m4_tpp_shoot": {
					"animations": [
						{
							"tactile_tpp_shoot": "variable.is_third_person&&v.tactile_gun"
						}
					],
					"transitions": [
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')||!q.is_alive"
						},
						{
							"m4_tpp_hold": "v.is_third_person&&v.tactile_gun&&q.all_animations_finished"
						}
					]
				},
				"m4_tpp_bolt": {
					"animations": [
						{
							"tactile_tpp_bolt": "variable.is_third_person&&v.tactile_gun"
						}
					],
					"transitions": [
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')||!q.is_alive"
						},
						{
							"m4_tpp_hold": "v.is_third_person&&v.tactile_gun&&!q.is_ignited&&q.all_animations_finished"
						}
					]
				},
				"m4_tpp_changemag": {
					"animations": [
						{
							"tactile_tpp_changemag": "variable.is_third_person&&v.tactile_gun&&q.property('hengker:reload')=='change'"
						}
					],
					"transitions": [
						{
							"default": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')||!q.is_alive"
						},
						{
							"m4_tpp_hold": "v.is_third_person&&v.tactile_gun&&q.property('hengker:reload')!='change'"
						}
					]
				},
				"m4_tpp_run": {
					"animations": [
						{
							"tactile_tpp_run": "variable.is_third_person&&variable.tactile_gun"
						}
					],
					"transitions": [
						{
							"m4_tpp_hold": "variable.is_third_person&&variable.tactile_gun&&!query.is_sprinting"
						},
						{
							"m4_tpp_reload": "variable.is_third_person&&(variable.tactile_gun&&q.property('hengker:reload')=='reload')"
						},
						{
							"m4_tpp_changemag": "variable.is_third_person&&(v.tactile_gun&&q.property('hengker:reload')=='change')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')"
						}
					],
					"blend_transition": 0.1,
					"blend_via_shortest_path": true
				},
				"m4_tpp_reload": {
					"animations": [
						{
							"tactile_tpp_reload": "variable.is_third_person&&variable.tactile_gun"
						}
					],
					"transitions": [
						{
							"m4_tpp_hold": "variable.is_third_person&&(variable.tactile_gun&&q.property('hengker:reload')=='n')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')"
						}
					]
				},
				"unequip": {
					"animations": [
						{
							"tactile_tpp_unequip": "variable.is_third_person&&variable.tactile_gun"
						}
					],
					"transitions": [
						{
							"default": "!v.tactile_gun"
						}
					]
				}
			}
		}
	}
}