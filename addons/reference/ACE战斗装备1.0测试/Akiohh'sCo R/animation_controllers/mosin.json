{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.mosin_aim_fpp": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": [
						{
							"awp_delluminated": "!q.is_sneaking"
						}
					],
					"transitions": [
						{
							"m4_fpp_aim": "variable.is_first_person&&variable.mosin_gun&&q.is_sneaking"
						}
					],
					"blend_transition": 0.25,
					"blend_via_shortest_path": true
				},
				"m4_fpp_aim": {
					"animations": [
						{
							"mosin_fpp_aim": "variable.is_first_person&&variable.mosin_gun&&q.property('mk556:scope')=='n'&&q.property('hengker:reload')=='n'"
						},
						{
							"mosin_exclusive_aim": "variable.is_first_person&&variable.mosin_gun&&q.property('mk556:scope')=='exclusive'&&q.property('hengker:reload')=='n'"
						}
					],
					"transitions": [
						{
							"default": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:mosin')||!q.is_sneaking"
						}
					],
					"blend_transition": 0.25,
					"blend_via_shortest_path": true
				}
			}
		},
		"controller.animation.mosin_hold_fpp": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"m4_fpp_draw": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:mosin')&&variable.is_first_person"
						}
					]
				},
				"m4_fpp_draw": {
					"animations": [
						{
							"mosin_fpp_draw": "variable.is_first_person&&v.mosin_gun"
						}
					],
					"transitions": [
						{
							"m4_fpp_hold": "v.is_first_person&&variable.mosin_gun&&!q.is_ignited&&q.all_animations_finished"
						},
						{
							"m4_fpp_bolt": "v.is_first_person&&v.mosin_gun&&q.is_ignited&&q.property('pistol:anim')=='loaded'&&q.all_animations_finished"
						}
					],
					"blend_transition": 0.1,
					"blend_via_shortest_path": true
				},
				"m4_fpp_hold": {
					"animations": [
						{
							"mosin_fpp_hold": "variable.is_first_person"
						}
					],
					"transitions": [
						{
							"m4_fpp_run": "!query.is_using_item&&variable.is_first_person&&variable.mosin_gun&&query.is_sprinting"
						},
						{
							"m4_fpp_reload": "variable.is_first_person&&(variable.mosin_gun&&q.property('hengker:reload')=='reload')"
						},
						{
							"m4_fpp_changemag": "variable.is_first_person&&(variable.mosin_gun&&q.property('hengker:reload')=='change')"
						},
						{
							"m4_fpp_shoot": "variable.is_first_person&&v.mosin_gun&&!q.is_ignited&&q.is_using_item&&q.property('pistol:anim')=='loaded'&&!query.is_item_name_any('slot.weapon.offhand',0,'hengker:lencana_polisi')&&q.property('hengker:reload')=='n'"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:mosin')"
						},
						{
							"m4_fpp_inspect": "variable.is_first_person&&(variable.mosin_gun&&q.property('hengker:reload')=='inspect')"
						},
						{
							"m4_fpp_check": "variable.is_first_person&&(variable.mosin_gun&&q.property('hengker:reload')=='check')"
						},
						{
							"m4_fpp_attachment": "variable.is_first_person&&(variable.mosin_gun&&q.property('hengker:reload')=='heal')"
						}
					],
					"blend_transition": 0.15,
					"blend_via_shortest_path": true
				},
				"m4_fpp_check": {
					"animations": [
						{
							"mosin_fpp_check": "variable.is_first_person&&v.mosin_gun"
						}
					],
					"transitions": [
						{
							"m4_fpp_hold": "variable.is_first_person&&v.mosin_gun&&q.is_using_item&&q.all_animations_finished||q.property('hengker:reload')=='n'"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:mosin')"
						},
						{
							"m4_fpp_attachment": "variable.is_first_person&&(variable.mosin_gun&&q.property('hengker:reload')=='heal')"
						}
					]
				},
				"m4_fpp_shoot": {
					"animations": [
						{
							"mosin_fpp_shoot": "v.is_first_person&&v.mosin_gun"
						}
					],
					"transitions": [
						{
							"m4_fpp_hold": "v.mosin_gun&&!q.is_ignited&&q.all_animations_finished"
						},
						{
							"m4_fpp_reload": "variable.is_first_person&&(variable.mosin_gun&&q.property('hengker:reload')=='reload')"
						},
						{
							"m4_fpp_changemag": "variable.is_first_person&&(variable.mosin_gun&&q.property('hengker:reload')=='change')&&q.all_animations_finished"
						},
						{
							"m4_fpp_inspect": "variable.is_first_person&&(variable.mosin_gun&&q.property('hengker:reload')=='inspect')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:mosin')"
						}
					]
				},
				"m4_fpp_bolt": {
					"animations": [
						{
							"mosin_fpp_bolt": "v.is_first_person&&v.mosin_gun"
						}
					],
					"transitions": [
						{
							"m4_fpp_hold": "v.mosin_gun&&!q.is_ignited&&q.all_animations_finished"
						},
						{
							"m4_fpp_inspect": "variable.is_first_person&&(variable.mosin_gun&&q.property('hengker:reload')=='inspect')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:mosin')"
						}
					],
					"blend_transition": 0.25,
					"blend_via_shortest_path": true
				},
				"m4_fpp_inspect": {
					"animations": [
						{
							"mosin_inspect": "variable.is_first_person&&v.mosin_gun"
						}
					],
					"transitions": [
						{
							"m4_fpp_hold": "variable.is_first_person&&v.mosin_gun&&q.is_using_item||q.property('hengker:reload')=='n'||q.all_animations_finished"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:mosin')"
						},
						{
							"m4_fpp_attachment": "variable.is_first_person&&(variable.mosin_gun&&q.property('hengker:reload')=='heal')"
						}
					]
				},
				"unequip": {
					"animations": [
						{
							"mosin_fpp_unequip": "v.is_first_person"
						}
					],
					"transitions": [
						{
							"default": "!v.mosin_gun"
						},
						{
							"m4_fpp_draw": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:mosin')&&q.all_animations_finished"
						}
					]
				},
				"m4_fpp_changemag": {
					"animations": [
						{
							"mosin_fpp_changemag": "variable.is_first_person&&variable.mosin_gun&&q.property('hengker:reload')=='change'"
						}
					],
					"transitions": [
						{
							"default": "!variable.mosin_gun||!q.is_alive"
						},
						{
							"m4_fpp_release": "variable.mosin_gun&&q.is_using_item&&q.all_animations_finished"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:mosin')"
						},
						{
							"m4_fpp_attachment": "variable.is_first_person&&(variable.mosin_gun&&q.property('hengker:reload')=='heal')"
						}
					]
				},
				"m4_fpp_release": {
					"animations": [
						{
							"mosin_fpp_release": "variable.is_first_person&&variable.mosin_gun"
						}
					],
					"transitions": [
						{
							"m4_fpp_hold": "variable.is_first_person&&variable.mosin_gun&&query.all_animations_finished&&q.property('hengker:reload')=='n'"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:mosin')"
						},
						{
							"m4_fpp_attachment": "variable.is_first_person&&(variable.mosin_gun&&q.property('hengker:reload')=='heal')"
						}
					]
				},
				"m4_fpp_run": {
					"animations": [
						{
							"mosin_fpp_run": "variable.is_first_person&&variable.mosin_gun&&!q.property('hengker:reload')!='heal'"
						}
					],
					"transitions": [
						{
							"m4_fpp_hold": "variable.is_first_person&&variable.mosin_gun&&!query.is_sprinting&&!q.is_using_item"
						},
						{
							"m4_fpp_reload": "variable.is_first_person&&(variable.mosin_gun&&q.property('hengker:reload')=='reload')"
						},
						{
							"m4_fpp_changemag": "variable.is_first_person&&(v.mosin_gun&&q.property('hengker:reload')=='change')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:mosin')"
						},
						{
							"m4_fpp_attachment": "variable.is_first_person&&(variable.mosin_gun&&q.property('hengker:reload')=='heal')"
						}
					],
					"blend_transition": 0.25,
					"blend_via_shortest_path": true
				},
				"m4_fpp_reload": {
					"animations": [
						{
							"mosin_fpp_reload": "variable.is_first_person&&variable.mosin_gun"
						}
					],
					"transitions": [
						{
							"m4_fpp_hold": "variable.is_first_person&&variable.mosin_gun&&(q.all_animations_finished&&q.property('hengker:reload')=='n')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:mosin')"
						},
						{
							"m4_fpp_attachment": "variable.is_first_person&&(variable.mosin_gun&&q.property('hengker:reload')=='heal')"
						}
					]
				},
				"m4_fpp_attachment": {
					"animations": [
						{
							"attachment_display": "variable.is_first_person&&q.variant==0"
						},
						{
							"attachment_muzzle": "variable.is_first_person&&q.variant==1"
						},
						{
							"attachment_laser": "variable.is_first_person&&q.variant==2"
						},
						{
							"attachment_scope": "variable.is_first_person&&q.variant==3"
						},
						{
							"attachment_stock": "variable.is_first_person&&q.variant==4"
						},
						{
							"attachment_mag": "variable.is_first_person&&q.variant==5"
						},
						{
							"attachment_grip": "variable.is_first_person&&q.variant==6"
						}
					],
					"transitions": [
						{
							"m4_fpp_hold": "variable.is_first_person&&variable.mosin_gun&&(variable.mosin_gun&&q.property('hengker:reload')=='n')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:mosin')"
						}
					],
					"blend_transition": 0.25,
					"blend_via_shortest_path": true
				}
			}
		},
		"controller.animation.mosin_hold_tpp": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": [
						{
							"mosin_tpp_draw": "variable.mosin_gun&&variable.is_third_person"
						}
					],
					"transitions": [
						{
							"m4_tpp_hold": "query.all_animations_finished&&variable.mosin_gun&&variable.is_third_person"
						},
						{
							"m4_tpp_bolt": "v.is_third_person&&v.mosin_gun&&q.is_ignited&&q.property('pistol:anim')=='loaded'&&q.all_animations_finished"
						}
					]
				},
				"m4_tpp_hold": {
					"animations": [
						{
							"mosin_tpp_hold": "variable.is_third_person&&variable.mosin_gun&&!q.is_sneaking"
						},
						{
							"mosin_tpp_aim": "variable.is_third_person&&variable.mosin_gun&&q.is_sneaking"
						}
					],
					"transitions": [
						{
							"m4_tpp_run": "variable.is_third_person&&variable.mosin_gun&&query.is_sprinting"
						},
						{
							"m4_tpp_reload": "variable.is_third_person&&(variable.mosin_gun&&q.property('hengker:reload')=='reload')"
						},
						{
							"m4_tpp_changemag": "variable.is_third_person&&(v.mosin_gun&&q.property('hengker:reload')=='change')"
						},
						{
							"m4_tpp_shoot": "variable.is_third_person&&(v.mosin_gun&&q.property('hengker:reload')=='n')&&!q.is_ignited&&q.is_using_item&&q.property('pistol:anim')=='loaded'&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')&&q.property('hengker:nomag')=='ada'"
						},
						{
							"m4_tpp_check": "variable.is_third_person&&(v.mosin_gun&&q.property('hengker:reload')=='check')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:mosin')"
						}
					]
				},
				"m4_tpp_shoot": {
					"animations": [
						{
							"mosin_tpp_shoot": "variable.is_third_person&&v.mosin_gun"
						}
					],
					"transitions": [
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:mosin')||!q.is_alive"
						},
						{
							"m4_tpp_hold": "v.is_third_person&&v.mosin_gun&&q.all_animations_finished"
						}
					]
				},
				"m4_tpp_bolt": {
					"animations": [
						{
							"mosin_tpp_bolt": "variable.is_third_person&&v.mosin_gun"
						}
					],
					"transitions": [
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:mosin')||!q.is_alive"
						},
						{
							"m4_tpp_hold": "v.is_third_person&&v.mosin_gun&&!q.is_ignited&&q.all_animations_finished"
						}
					]
				},
				"m4_tpp_changemag": {
					"animations": [
						{
							"mosin_tpp_changemag": "variable.is_third_person&&v.mosin_gun&&q.property('hengker:reload')=='change'"
						}
					],
					"transitions": [
						{
							"default": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:mosin')||!q.is_alive"
						},
						{
							"m4_tpp_release": "v.is_third_person&&v.mosin_gun&&q.is_using_item"
						}
					]
				},
				"m4_tpp_release": {
					"animations": [
						{
							"mosin_tpp_changemag2": "variable.is_third_person&&v.mosin_gun"
						}
					],
					"transitions": [
						{
							"m4_tpp_hold": "v.is_third_person&&v.mosin_gun&&q.all_animations_finished"
						},
						{
							"default": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:mosin')||!q.is_alive"
						}
					]
				},
				"m4_tpp_check": {
					"animations": [
						{
							"mosin_tpp_changemag": "variable.is_third_person&&v.mosin_gun"
						}
					],
					"transitions": [
						{
							"m4_tpp_hold": "v.is_third_person&&v.mosin_gun&&q.property('hengker:reload')!='check'"
						},
						{
							"default": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:mosin')||!q.is_alive"
						}
					]
				},
				"m4_tpp_run": {
					"animations": [
						{
							"mosin_tpp_run": "variable.is_third_person&&variable.mosin_gun"
						}
					],
					"transitions": [
						{
							"m4_tpp_hold": "variable.is_third_person&&variable.mosin_gun&&!query.is_sprinting"
						},
						{
							"m4_tpp_reload": "variable.is_third_person&&(variable.mosin_gun&&q.property('hengker:reload')=='reload')"
						},
						{
							"m4_tpp_changemag": "variable.is_third_person&&(v.mosin_gun&&q.property('hengker:reload')=='change')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:mosin')"
						}
					],
					"blend_transition": 0.1,
					"blend_via_shortest_path": true
				},
				"m4_tpp_reload": {
					"animations": [
						{
							"mosin_tpp_reload": "variable.is_third_person&&variable.mosin_gun"
						}
					],
					"transitions": [
						{
							"m4_tpp_hold": "variable.is_third_person&&(variable.mosin_gun&&q.property('hengker:reload')=='n')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:mosin')"
						}
					]
				},
				"unequip": {
					"animations": [
						{
							"mosin_tpp_unequip": "variable.is_third_person&&variable.mosin_gun"
						}
					],
					"transitions": [
						{
							"default": "!v.mosin_gun"
						}
					]
				}
			}
		}
	}
}