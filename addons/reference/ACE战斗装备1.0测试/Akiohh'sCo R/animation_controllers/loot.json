{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.ram_hold_fpp": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"draw": "v.ram_loot||query.is_item_name_any('slot.weapon.mainhand',0,'bridge:ram')"
						}
					]
				},
				"draw": {
					"animations": [
						{
							"ram_fpp_draw": "v.is_first_person&&v.ram_loot"
						}
					],
					"transitions": [
						{
							"hold": "v.ram_loot&&query.all_animations_finished"
						}
					]
				},
				"hold": {
					"animations": [
						{
							"ram_fpp_hold": "v.is_first_person&&v.ram_loot"
						}
					],
					"transitions": [
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'bridge:ram')"
						},
						{
							"inspect": "query.is_item_name_any('slot.weapon.mainhand',0,'bridge:ram')&&q.property('hengker:reload')=='inspect'"
						}
					],
					"blend_transition": 0.15,
					"blend_via_shortest_path": true
				},
				"inspect": {
					"animations": [
						{
							"ram_fpp_inspect": "v.is_first_person&&v.ram_loot"
						}
					],
					"transitions": [
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'bridge:ram')"
						},
						{
							"hold": "query.is_item_name_any('slot.weapon.mainhand',0,'bridge:ram')&&q.all_animations_finished||q.property('hengker:reload')!='inspect'"
						}
					],
					"blend_transition": 0.15,
					"blend_via_shortest_path": true
				},
				"unequip": {
					"animations": [
						{
							"ram_fpp_unequip": "v.is_first_person&&v.ram_loot"
						}
					],
					"transitions": [
						{
							"default": "!v.ram_loot"
						},
						{
							"draw": "v.ram_loot&&q.all_animations_finished"
						}
					]
				}
			}
		},
