				{
					"magazine5": "query.property('mk556:mag')=='n' && q.property('hengker:nomag')=='ada'"
				},
				{
					"magazine4": "query.property('mk556:mag')=='drum' && q.property('hengker:nomag')=='ada'"
				},
				{
					"magazine6": "query.property('mk556:mag')=='extended' && q.property('hengker:nomag')=='ada'"
				},
				{
					"silencer": "query.property('mk556:muzzle')=='silencer'"
				},
				{
					"bullet": "query.property('mk556:mag')=='drum' && q.property('hengker:nomag')=='ada' && q.is_stackable"
				},
				{
					"bullet2": "q.property('hengker:nomag')=='ada' && q.is_stackable"
				},
				{
					"bullet3": "q.property('hengker:nomag')=='ada' && q.is_stackable"
				}
			],
			"is_hurt_color": {
				"a": 0,
				"b": 0,
				"g": 0,
				"r": 0
			}
		},
