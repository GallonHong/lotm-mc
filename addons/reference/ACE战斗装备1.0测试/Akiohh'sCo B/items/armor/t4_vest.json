{
	"format_version": "1.20.50",
	"minecraft:item": {
		"description": {
			"identifier": "hengker:t4_vest",
			"menu_category": {
				"category": "equipment",
				"group": "itemGroup.name.chestplate"
			}
		},
		"components": {
			"minecraft:max_stack_size": 1,
			"minecraft:icon": {
				"texture": "t4_vest"
			},
			"minecraft:display_name": {
				"value": "重型背心\n\n§7价格: 42$"
			},
			"minecraft:glint": false,
			"minecraft:durability": {
				"damage_chance": {
					"min": 80,
					"max": 100
				},
				"max_durability": 120
			},
			"minecraft:wearable": {
				"slot": "slot.armor.chest",
				"protection": 8
			},
			"minecraft:repairable": {
				"repair_items": [
					{
						"items": [
							"minecraft:iron_ingot"
						],
