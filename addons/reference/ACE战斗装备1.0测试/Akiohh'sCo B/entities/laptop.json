{
	"format_version": "1.20.80",
	"minecraft:entity": {
		"description": {
			"identifier": "bridge:laptop",
			"is_spawnable": true,
			"is_summonable": true,
			"is_experimental": false,
			"scripts": {
				"animate": [
					"mujur"
				]
			},
			"animations": {
				"mujur": "controller.animation.mujur"
			}
		},
		"component_groups": {
			"dodolan": {
				"minecraft:trade_resupply": {},
				"minecraft:trade_table": {
					"display_name": "SHOP",
					"new_screen": true,
					"persist_trades": false,
					"table": "trading/dodol.json"
				},
				"minecraft:behavior.trade_with_player": {
					"priority": 1,
					"max_distance_from_player": 3
				},
				"minecraft:interact": {
					"interactions": [
						{
							"interact_text": "Restart Shop",
							"cooldown": 0.5,
							"swing": true,
							"on_interact": {
								"target": "self",
								"filters": {
									"all_of": [
										{
											"subject": "player",
											"test": "is_sneaking",
											"value": true
										}
									]
								},
								"event": "restart_check"
							}
						}
					]
				}
			},
			"cooldown": {
				"minecraft:timer": {
					"looping": false,
					"time": 0.3,
					"time_down_event": {
						"target": "self",
						"event": "done"
					}
				}
			},
			"mujur_nengen": {
				"minecraft:variant": {
					"value": 0
				}
			},
			"mujur_ngarep": {
				"minecraft:variant": {
					"value": 1
				}
			},
			"mujur_mburi": {
				"minecraft:variant": {
					"value": 2
				}
			},
			"mujur_ngiwo": {
				"minecraft:variant": {
					"value": 3
				}
			}
		},
		"components": {
			"minecraft:health": {
				"value": 2
			},
			"minecraft:pushable": {
				"is_pushable": false,
				"is_pushable_by_piston": true
			},
			"minecraft:collision_box": {
				"width": 0.7,
				"height": 0.65
			},
			"minecraft:loot": {
				"table": "loot_tables/block/laptop_matek.json"
			},
			"minecraft:knockback_resistance": {
				"value": 1
			},
			"minecraft:damage_sensor": {
				"triggers": [
					{
						"on_damage": {
							"filters": {
								"subject": "player",
								"test": "is_sneaking",
								"value": true
							},
							"target": "self"
						},
						"deals_damage": true
					},
					{
						"on_damage": {
							"filters": {
								"subject": "self",
								"test": "is_variant",
								"value": 0
							},
							"target": "self",
							"event": "ngarep"
						},
						"deals_damage": false
					},
					{
						"on_damage": {
							"filters": {
								"subject": "self",
								"test": "is_variant",
								"value": 1
							},
							"target": "self",
							"event": "mburi"
						},
						"deals_damage": false
					},
					{
						"on_damage": {
							"filters": {
								"subject": "self",
								"test": "is_variant",
								"value": 2
							},
							"target": "self",
							"event": "ngiwo"
						},
						"deals_damage": false
					},
					{
						"on_damage": {
							"filters": {
								"subject": "self",
								"test": "is_variant",
								"value": 3
							},
							"target": "self",
							"event": "nengen"
						},
						"deals_damage": false
					}
				]
			},
			"minecraft:physics": {
				"has_collision": true,
				"has_gravity": true
			},
			"minecraft:type_family": {
				"family": [
					"environment"
				]
			}
		},
		"events": {
			"minecraft:entity_spawned": {
				"add": {
					"component_groups": [
						"mujur_ngiwo",
						"dodolan"
					]
				}
			},
			"restart_check": {
				"queue_command": {
					"command": [
						"execute as @s run scriptevent hengker:restart_check"
					]
				}
			},
			"bridge:restart": {
				"add": {
					"component_groups": [
						"cooldown"
					]
				},
				"remove": {
					"component_groups": [
						"dodolan"
					]
				}
			},
			"done": {
				"add": {
					"component_groups": [
						"dodolan"
					]
				},
				"remove": {
					"component_groups": [
						"cooldown"
					]
				}
			},
			"ngiwo": {
				"add": {
					"component_groups": [
						"mujur_ngiwo"
					]
				},
				"remove": {
					"component_groups": [
						"mujur_ngarep",
						"mujur_mburi",
						"mujur_nengen"
					]
				}
			},
			"nengen": {
				"add": {
					"component_groups": [
						"mujur_nengen"
					]
				},
				"remove": {
					"component_groups": [
						"mujur_ngarep",
						"mujur_mburi",
						"mujur_ngiwo"
					]
				}
			},
			"ngarep": {
				"add": {
					"component_groups": [
						"mujur_ngarep"
					]
				},
				"remove": {
					"component_groups": [
						"mujur_ngiwo",
						"mujur_mburi",
						"mujur_nengen"
					]
				}
			},
			"mburi": {
				"add": {
					"component_groups": [
						"mujur_mburi"
					]
				},
				"remove": {
					"component_groups": [
						"mujur_ngarep",
						"mujur_ngiwo",
						"mujur_nengen"
					]
				}
			}
		}
	}
}