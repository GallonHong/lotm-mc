				},
				"gagal": {
					"on_entry": [
						"/stopsound @s",
						"/event entity @s hengker:rilotend"
					],
					"transitions": [
						{
							"default": "1"
						}
					]
				},
				"isi_peluru": {
					"on_entry": [
						"variable.ngentot=query.life_time;",
						"/event entity @s[tag=!cooldown] hengker:rilotchange"
					],
					"transitions": [
						{
							"mengisi_peluru": "1"
						}
					]
				},
				"mengisi_peluru": {
					"animations": [
						"tactile_changemag"
					],
					"transitions": [
						{
							"gagal": "query.get_equipped_item_name('main_hand')!='tactile'||q.property('hengker:reload')!='change'"
						},
						{
							"selesai30": "q.is_alive&&(query.life_time-variable.ngentot)>=1.78"
						}
					]
				},
				"selesai30": {
					"on_entry": [
						"/event entity @s hengker:rilotend"
					],
					"transitions": [
						{
							"default": "1"
						}
					]
				}
			}
		},
