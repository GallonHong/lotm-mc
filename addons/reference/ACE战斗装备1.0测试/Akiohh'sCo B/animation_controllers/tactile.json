{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.tactile": {
			"initial_state": "default",
			"states": {
				"default": {
					"on_entry": [],
					"transitions": [
						{
							"draw": "q.mark_variant==0&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')"
						},
						{
							"preshoot": "q.mark_variant==3&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')"
						},
						{
							"unequip": "q.mark_variant==3&&!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')"
						}
					],
					"on_exit": [
						"/hud @s hide crosshair",
						"/event entity @s equip:tactile"
					]
				},
				"draw": {
					"on_entry": [
						"/tag add @s cooldown"
					],
					"animations": [
						"tactile_draw"
					],
					"transitions": [
						{
							"preshoot": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')&&q.all_animations_finished&&!q.is_ignited"
						},
						{
							"cooldown": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')&&q.all_animations_finished&&q.is_ignited"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')&&q.all_animations_finished"
						}
					]
				},
				"unequip": {
					"on_entry": [
						"/tag @s add cooldown"
					],
					"animations": [
						"tactile_unequip"
					],
					"transitions": [
						{
							"default": "query.all_animations_finished"
						}
					],
					"on_exit": [
						"/event entity @s mk556:laser_off",
						"/tag @s remove cooldown",
						"/hud @s reset crosshair"
					]
				},
				"cooldown": {
					"animations": [
						"tactile_cooldown"
					],
					"on_entry": [
						"/event entity @s bridge:is_ignited"
					],
					"transitions": [
						{
							"preshoot": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')&&q.all_animations_finished"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')"
						}
					],
					"on_exit": [
						"/event entity @s bridge:not_ignited"
					]
				},
				"preshoot": {
					"on_entry": [
						"/event entity @s[scores={tactile=2..}] bridge:not_ignited",
						"/event entity @s[scores={tactile=2..}] pistol:loaded",
						"/event entity @s[tag=!tactilebulletin,scores={tactile=1}] pistol:empty"
					],
					"transitions": [
						{
							"shoot": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')&&q.main_hand_item_use_duration&&q.scoreboard('tactile')>0&&!q.is_sneaking&&q.property('hengker:reload')=='n'&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')&&!q.is_sprinting&&!q.is_ignited&&q.property('hengker:nomag')=='ada'"
						},
						{
							"aim": "!q.is_sprinting&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')&&q.main_hand_item_use_duration&&q.scoreboard('tactile')>0&&q.is_sneaking&&q.property('hengker:reload')=='n'&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')&&!q.is_ignited"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')"
						},
						{
							"check": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')&&q.property('hengker:reload')=='check'&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')"
						},
						{
							"display": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')&&query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')&&q.property('hengker:reload')=='heal'"
						}
					]
				},
				"check": {
					"animations": [
						"tactile_check"
					],
					"transitions": [
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')"
						},
						{
							"preshoot": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')&&q.all_animations_finished"
						}
					],
					"on_exit": [
						"/event entity @s hengker:rilotend"
					]
				},
				"display": {
					"on_entry": [
						"/event entity @s hengker:attachment"
					],
					"transitions": [
						{
							"preshoot": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')&&(q.is_sneaking||q.property('hengker:reload')!='heal')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')"
						}
					],
					"on_exit": [
						"/event entity @s hengker:rilotend",
						"/event entity @s gun:display"
					]
				},
				"shoot": {
					"animations": [
						"tactile_shoot"
					],
					"on_entry": [
						"/camerashake add @s[tag=tactilebulletin,scores={tactile=1}] 0.08 0.7 rotational",
						"/camerashake add @s[tag=!tactilebulletin,scores={tactile=2..}] 0.08 0.7 rotational",
						"/event entity @s bridge:is_ignited"
					],
					"transitions": [
						{
							"preshoot": "q.all_animations_finished||!q.is_alive"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')"
						}
					]
				},
				"aim": {
					"animations": [
						"tactile_aim"
					],
					"on_entry": [
						"/camerashake add @s[tag=tactilebulletin,scores={tactile=1}] 0.06 0.5 rotational",
						"/camerashake add @s[tag=!tactilebulletin,scores={tactile=2..}] 0.06 0.5 rotational",
						"/event entity @s bridge:is_ignited"
					],
					"transitions": [
						{
							"preshoot": "q.all_animations_finished||!q.is_alive"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')"
						}
					]
				}
			}
		},
		"controller.animation.tactile.silencer": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": [
						"cooldown"
					],
					"transitions": [
						{
							"silencer": "query.property('hengker:reload')=='heal'&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')&&q.is_using_item&&q.variant==1"
						}
					],
					"on_exit": [
						"/event entity @s[m=c] mk556:silencer",
						"/tag @s[m=c] add tactile_silencer",
						"/playsound muzzle.general @s[m=c]"
					]
				},
				"silencer": {
					"animations": [
						"cooldown"
					],
					"transitions": [
						{
							"sek_sabar": "query.property('hengker:reload')=='heal'&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')&&q.is_using_item&&q.variant==1&&q.all_animations_finished"
						}
					],
					"on_exit": [
						"/event entity @s[m=c] mk556:muzzle",
						"/tag @s[m=c] remove tactile_silencer",
						"/playsound muzzle.general @s[m=c]"
					]
				},
				"sek_sabar": {
					"animations": [
						"cooldown"
					],
					"transitions": [
						{
							"default": "query.all_animations_finished"
						}
					]
				}
			}
		},
