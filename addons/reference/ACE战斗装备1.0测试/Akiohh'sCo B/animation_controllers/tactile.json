		"controller.animation.tactileinspect": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"inspect": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')&&q.property('hengker:reload')=='inspect'"
						}
					],
					"on_exit": [
						"/tag @s add cooldown"
					]
				},
				"inspect": {
					"animations": [
						"tactile_inspect_empty"
					],
					"transitions": [
						{
							"default": "query.all_animations_finished||!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')||q.is_using_item"
						}
					],
					"on_exit": [
						"/tag @s remove cooldown",
						"/event entity @s hengker:rilotend"
					]
				}
			}
		},
		"controller.animation.tactile.sneak": {
			"initial_state": "default",
			"states": {
				"default": {
					"on_entry": [
						"/hud @s reset status_effects",
						"/effect @s speed 0 0 true",
						"/effect @s slowness 0 0 true"
					],
					"transitions": [
						{
							"sneak": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')&&q.is_sneaking&&query.property('mk556:scope')=='n'&&q.property('hengker:reload')=='n'"
						},
						{
							"holo": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')&&q.is_sneaking&&(query.property('mk556:scope')=='holo'||query.property('mk556:scope')=='reddot')&&q.property('hengker:reload')=='n'"
						},
						{
							"acog": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')&&q.is_sneaking&&query.property('mk556:scope')=='acog'&&q.property('hengker:reload')=='n'"
						},
						{
							"scout": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')&&q.is_sneaking&&query.property('mk556:scope')=='scout'&&q.property('hengker:reload')=='n'"
						}
					],
					"on_exit": [
						"/hud @s hide status_effects",
						"/effect @s speed infinite 7 true"
					]
				},
				"sneak": {
					"on_entry": [
						"/effect @s slowness infinite 0 true"
					],
					"transitions": [
						{
							"default": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')||!q.is_sneaking||q.property('hengker:reload')!='n'"
						}
					],
					"on_exit": [
						"/hud @s reset status_effects",
						"/effect @s speed 0 0 true",
						"/effect @s slowness 0 0 true"
					]
				},
				"holo": {
					"on_entry": [
						"/effect @s slowness infinite 1 true"
					],
					"transitions": [
						{
							"default": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')||!q.is_sneaking||q.property('hengker:reload')!='n'"
						}
					],
					"on_exit": [
						"/hud @s reset status_effects",
						"/effect @s speed 0 0 true",
						"/effect @s slowness 0 0 true"
					]
				},
				"acog": {
					"on_entry": [
						"/effect @s slowness infinite 4 true",
						"/effect @s speed infinite 54 true"
					],
					"transitions": [
						{
							"default": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')||!q.is_sneaking||q.property('hengker:reload')!='n'"
						}
					],
					"on_exit": [
						"/hud @s reset status_effects",
						"/effect @s speed 0 0 true",
						"/effect @s slowness 0 0 true"
					]
				},
				"scout": {
					"on_entry": [
						"/effect @s slowness infinite 10 true",
						"/effect @s speed infinite 255 true"
					],
					"transitions": [
						{
							"default": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')||!q.is_sneaking||q.property('hengker:reload')!='n'"
						}
					],
					"on_exit": [
						"/effect @s speed 0 0 true",
						"/effect @s slowness 0 7 true"
					]
				}
			}
		},
		"controller.animation.tactilereload": {
			"initial_state": "prereload",
			"states": {
				"prereload": {
					"transitions": [
						{
							"reload": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')&&q.scoreboard('tactile')<1&&q.is_using_item&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')&&q.property('hengker:nomag')=='gaada'"
						}
					]
				},
				"fail": {
					"on_entry": [
						"/event entity @s hengker:rilotend",
						"/event entity @s bridge:is_ignited",
						"/event entity @s pistol:empty",
						"/execute as @s run scriptevent hengker:tactile_changemag",
						"/event entity @s hengker:nomag",
						"/tag @s add tactilenomag",
						"/stopsound @s"
					],
					"transitions": [
						{
							"prereload": "1"
						}
					]
				},
				"reload": {
					"on_entry": [
						"/execute as @s[tag=!cooldown] run scriptevent hengker:tactile_reload",
						"/execute as @s[tag=!cooldown] run tag @s[scores={tactile=1..}] remove tactilenomag",
						"/execute as @s[tag=!cooldown] run event entity @s[scores={tactile=1..}] hengker:mag",
						"/execute as @s[tag=!cooldown] run event entity @s[hasitem={item=bridge:tactile_mag,quantity=1..}] hengker:rilot",
						"variable.ngentot2=query.life_time;"
					],
					"transitions": [
						{
							"reloading": "q.scoreboard('tactile')>0&&q.property('hengker:reload')=='reload'&&q.property('mk556:mag')=='n'&&q.is_alive"
						},
						{
							"fail": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')||(q.property('hengker:reload')!='reload'&&(query.life_time-variable.ngentot2)>=0.25)"
						}
					]
				},
				"reloading": {
					"animations": [
						"tactile_reload"
					],
					"on_entry": [
						"/tag @s remove tactilenomag",
						"/event entity @s hengker:mag"
					],
					"transitions": [
						{
							"done": "q.all_animations_finished&&q.is_alive"
						},
						{
							"fail": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')||!q.is_alive||q.property('hengker:reload')=='hit'"
						}
					]
				},
				"done": {
					"on_exit": [
						"/event entity @s hengker:rilotend",
						"/event entity @s[tag=tactilebulletin,scores={tactile=1..}] pistol:loaded",
						"/tag @s remove tactilenomag",
						"/event entity @s[tag=!tactilebulletin,scores={tactile=1}] pistol:empty",
						"/stopsound @s"
					],
					"transitions": [
						{
							"prereload": "1"
						}
					]
				}
			}
		},
		"controller.animation.tactilechangemag": {
			"initial_state": "default",
			"states": {
				"default": {
					"on_entry": [
						"/stopsound @s"
					],
					"transitions": [
						{
							"isi_peluru": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile')&&q.property('hengker:reload')=='change'"
						}
