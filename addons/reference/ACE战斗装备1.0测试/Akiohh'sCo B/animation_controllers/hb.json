{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.hb": {
			"initial_state": "default",
			"states": {
				"default": {
					"on_entry": [],
					"transitions": [
						{
							"draw": "q.mark_variant==0&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hb')"
						},
						{
							"preshoot": "q.mark_variant==5&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hb')"
						},
						{
							"unequip": "q.mark_variant==5&&!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hb')"
						}
					],
					"on_exit": [
						"/hud @s hide crosshair",
						"/event entity @s equip:hb"
					]
				},
				"draw": {
					"on_entry": [
						"/tag add @s cooldown"
					],
					"animations": [
						"hb_draw"
					],
					"transitions": [
						{
							"preshoot": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hb')&&q.all_animations_finished"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hb')&&q.all_animations_finished"
						}
					]
				},
				"unequip": {
					"on_entry": [
						"/tag @s add cooldown"
					],
					"animations": [
						"hb_unequip"
					],
					"transitions": [
						{
							"default": "query.all_animations_finished"
						}
					],
					"on_exit": [
						"/event entity @s mk556:laser_off",
						"/tag @s remove cooldown",
						"/hud @s reset crosshair"
					]
				},
				"preshoot": {
					"transitions": [
						{
							"shoot": "!q.is_sprinting&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hb')&&q.main_hand_item_use_duration&&q.scoreboard('hb')>0&&!q.is_sneaking&&q.property('hengker:reload')=='n'&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')"
						},
						{
							"aim": "!q.is_sprinting&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hb')&&q.main_hand_item_use_duration&&q.scoreboard('hb')>0&&q.is_sneaking&&q.property('hengker:reload')=='n'&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')"
						},
						{
							"check": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hb')&&q.property('hengker:reload')=='check'&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hb')"
						},
						{
							"display": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hb')&&query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')&&q.property('hengker:reload')=='heal'"
						}
					]
				},
				"check": {
					"animations": [
						"hb_check"
					],
					"transitions": [
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hb')"
						},
						{
							"preshoot": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hb')&&q.all_animations_finished"
						}
					],
					"on_exit": [
						"/event entity @s hengker:rilotend"
					]
				},
				"display": {
					"on_entry": [
						"/event entity @s hengker:attachment"
					],
					"transitions": [
						{
							"preshoot": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hb')&&(q.is_sneaking||q.property('hengker:reload')!='heal')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hb')"
						}
					],
					"on_exit": [
						"/event entity @s hengker:rilotend",
						"/event entity @s gun:display"
					]
				},
				"shoot": {
					"animations": [
						"hb_shoot"
					],
					"on_entry": [
						"/camerashake add @s[tag=!cooldown,scores={hb=2..}] 0.055 0.075 rotational",
						"/camerashake add @s[tag=!hbnormal,tag=!hbcqb,tag=!hbsimple] 0.08 0.3 rotational"
					],
					"transitions": [
						{
							"preshoot": "q.all_animations_finished||!q.is_alive"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hb')"
						}
					]
				},
				"aim": {
					"animations": [
						"hb_aim"
					],
					"on_entry": [
						"/camerashake add @s[tag=!cooldown,scores={hb=2..}] 0.055 0.075 rotational",
						"/camerashake add @s[tag=!hbnormal,tag=!hbcqb,tag=!hbsimple] 0.08 0.3 rotational"
					],
					"transitions": [
						{
							"preshoot": "q.all_animations_finished||!q.is_alive"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hb')"
						}
					]
				}
			}
		},
