		"controller.animation.hbreload": {
			"initial_state": "prereload",
			"states": {
				"prereload": {
					"transitions": [
						{
							"reload": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hb')&&q.scoreboard('hb')<1&&q.is_using_item&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')&&q.property('hengker:nomag')=='gaada'"
						}
					]
				},
				"fail": {
					"on_entry": [
						"/event entity @s hengker:rilotend",
						"/execute as @s run scriptevent hengker:hb_changemag",
						"/event entity @s hengker:nomag",
						"/tag @s add hbnomag",
						"/stopsound @s"
					],
					"transitions": [
						{
							"prereload": "1"
						}
					]
				},
				"reload": {
					"on_entry": [
						"/execute as @s[tag=!cooldown] run scriptevent hengker:hb_reload",
						"/execute as @s[tag=!cooldown] run tag @s[scores={hb=1..}] remove hbnomag",
						"/execute as @s[tag=!cooldown] run event entity @s[scores={hb=1..}] hengker:mag",
						"/execute as @s[tag=!cooldown] run event entity @s[hasitem={item=bridge:hb_mag,quantity=1..}] hengker:rilot",
						"/execute as @s[tag=!cooldown] run event entity @s[hasitem={item=bridge:hb_mag_drum,quantity=1..}] hengker:rilot",
						"/execute as @s[tag=!cooldown] run event entity @s[hasitem={item=bridge:hb_mag_extended,quantity=1..}] hengker:rilot",
						"variable.ngentot2=query.life_time;"
					],
					"transitions": [
						{
							"reloading": "q.scoreboard('hb')>0&&q.property('hengker:reload')=='reload'&&q.property('mk556:mag')=='n'&&q.is_alive"
						},
						{
							"reloading_extended": "q.scoreboard('hb')>0&&q.property('hengker:reload')=='reload'&&q.property('mk556:mag')=='extended'&&q.is_alive"
						},
						{
							"reloading_drum": "q.scoreboard('hb')>0&&q.property('hengker:reload')=='reload'&&q.property('mk556:mag')=='drum'&&q.is_alive"
						},
						{
