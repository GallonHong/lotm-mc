		"controller.animation.hkcreload": {
			"initial_state": "prereload",
			"states": {
				"prereload": {
					"transitions": [
						{
							"reload": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')&&q.scoreboard('hkc')<1&&q.is_using_item&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')&&q.property('hengker:nomag')=='gaada'"
						}
					]
				},
				"fail": {
					"on_entry": [
						"/event entity @s hengker:rilotend",
						"/execute as @s run scriptevent hengker:hkc_changemag",
						"/event entity @s hengker:nomag",
						"/tag @s add hkcnomag",
						"/stopsound @s"
					],
					"transitions": [
						{
							"prereload": "1"
						}
					]
				},
				"reload": {
					"on_entry": [
						"/execute as @s[tag=!cooldown] run scriptevent hengker:hkc_reload",
						"/execute as @s[tag=!cooldown] run tag @s[scores={hkc=1..}] remove hkcnomag",
						"/execute as @s[tag=!cooldown] run event entity @s[scores={hkc=1..}] hengker:mag",
						"/execute as @s[tag=!cooldown] run event entity @s[hasitem={item=bridge:hkc_mag,quantity=1..}] hengker:rilot",
						"/execute as @s[tag=!cooldown] run event entity @s[hasitem={item=bridge:hkc_mag_drum,quantity=1..}] hengker:rilot",
						"/execute as @s[tag=!cooldown] run event entity @s[hasitem={item=bridge:hkc_mag_extended,quantity=1..}] hengker:rilot",
						"variable.ngentot2=query.life_time;"
					],
					"transitions": [
						{
							"reloading": "q.scoreboard('hkc')>0&&q.property('hengker:reload')=='reload'&&q.property('mk556:mag')=='n'&&q.is_alive"
						},
						{
							"reloading_extended": "q.scoreboard('hkc')>0&&q.property('hengker:reload')=='reload'&&q.property('mk556:mag')=='extended'&&q.is_alive"
						},
						{
							"reloading_drum": "q.scoreboard('hkc')>0&&q.property('hengker:reload')=='reload'&&q.property('mk556:mag')=='drum'&&q.is_alive"
						},
						{
							"fail": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')||(q.property('hengker:reload')!='reload'&&(query.life_time-variable.ngentot2)>=0.25)"
						}
					]
				},
				"reloading": {
					"animations": [
						"hkc_reload"
					],
					"transitions": [
						{
							"done": "q.all_animations_finished&&q.is_alive"
						},
						{
							"fail": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')||!q.is_alive||q.property('hengker:reload')=='hit'"
						}
					]
				},
				"reloading_extended": {
					"animations": [
						"hkc_reload_extended"
					],
					"transitions": [
						{
							"done": "q.all_animations_finished&&q.is_alive"
						},
						{
							"fail": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')||!q.is_alive||q.property('hengker:reload')=='hit'"
						}
					]
				},
				"reloading_drum": {
					"animations": [
						"hkc_reload_drum"
					],
					"transitions": [
						{
							"done": "q.all_animations_finished&&q.is_alive"
						},
						{
							"fail": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')||!q.is_alive||q.property('hengker:reload')=='hit'"
						}
					]
				},
				"done": {
					"on_exit": [
						"/event entity @s hengker:rilotend",
						"/tag @s remove hkcnomag",
						"/stopsound @s"
					],
					"transitions": [
						{
							"prereload": "1"
						}
					]
				}
			}
		},
