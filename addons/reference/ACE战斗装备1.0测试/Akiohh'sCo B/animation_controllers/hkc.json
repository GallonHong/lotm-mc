{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.hkc": {
			"initial_state": "default",
			"states": {
				"default": {
					"on_entry": [],
					"transitions": [
						{
							"draw": "q.mark_variant==0&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')"
						},
						{
							"preshoot": "q.mark_variant==6&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')"
						},
						{
							"unequip": "q.mark_variant==6&&!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')"
						}
					],
					"on_exit": [
						"/hud @s hide crosshair",
						"/event entity @s equip:hkc"
					]
				},
				"draw": {
					"on_entry": [
						"/tag add @s cooldown"
					],
					"animations": [
						"hkc_draw"
					],
					"transitions": [
						{
							"preshoot": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')&&q.all_animations_finished"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')&&q.all_animations_finished"
						}
					]
				},
				"unequip": {
					"on_entry": [
						"/tag @s add cooldown"
					],
					"animations": [
						"hkc_unequip"
					],
					"transitions": [
						{
							"default": "query.all_animations_finished"
						}
					],
					"on_exit": [
						"/event entity @s mk556:laser_off",
						"/tag @s remove cooldown",
						"/hud @s reset crosshair"
					]
				},
				"preshoot": {
					"transitions": [
						{
							"shoot": "q.property('mk556:grip')!='n'&&!q.is_sprinting&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')&&q.main_hand_item_use_duration&&q.scoreboard('hkc')>0&&!q.is_sneaking&&q.property('hengker:reload')=='n'&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')"
						},
						{
							"shoot": "q.property('mk556:grip')=='n'&&!q.is_sprinting&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')&&q.main_hand_item_use_duration&&q.scoreboard('hkc')>0&&q.is_sneaking&&q.property('hengker:reload')=='n'&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')"
						},
						{
							"nogrip": "q.property('mk556:grip')=='n'&&!q.is_sprinting&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')&&q.main_hand_item_use_duration&&q.scoreboard('hkc')>0&&!q.is_sneaking&&q.property('hengker:reload')=='n'&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')"
						},
						{
							"aim": "q.property('mk556:grip')!='n'&&!q.is_sprinting&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')&&q.main_hand_item_use_duration&&q.scoreboard('hkc')>0&&q.is_sneaking&&q.property('hengker:reload')=='n'&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')"
						},
						{
							"check": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')&&q.property('hengker:reload')=='check'&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')||!q.is_alive"
						},
						{
							"display": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')&&query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')&&q.property('hengker:reload')=='heal'"
						}
					]
				},
				"check": {
					"animations": [
						"hkc_check"
					],
					"transitions": [
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')||!q.is_alive"
						},
						{
							"preshoot": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')&&q.all_animations_finished"
						}
					],
					"on_exit": [
						"/event entity @s hengker:rilotend"
					]
				},
				"display": {
					"on_entry": [
						"/event entity @s hengker:attachment"
					],
					"transitions": [
						{
							"preshoot": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')&&(q.is_sneaking||q.property('hengker:reload')!='heal')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')||!q.is_alive"
						}
					],
					"on_exit": [
						"/event entity @s hengker:rilotend",
						"/event entity @s gun:display"
					]
				},
				"shoot": {
					"animations": [
						"hkc_shoot"
					],
					"on_entry": [
						"/camerashake add @s[tag=!cooldown,scores={hkc=2..}] 0.055 0.075 rotational",
						"/camerashake add @s[tag=!hkcnormal,tag=!hkccqb,tag=!hkcsimple] 0.08 0.3 rotational"
					],
					"transitions": [
						{
							"preshoot": "q.all_animations_finished||!q.is_alive"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')||!q.is_alive"
						}
					]
				},
				"nogrip": {
					"animations": [
						"hkc_nguwawor"
					],
					"on_entry": [
						"/camerashake add @s[tag=!cooldown,scores={hkc=2..}] 0.055 0.075 rotational",
						"/camerashake add @s[tag=!hkcnormal,tag=!hkccqb,tag=!hkcsimple] 0.08 0.3 rotational"
					],
					"transitions": [
						{
							"preshoot": "q.all_animations_finished||!q.is_alive"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')||!q.is_alive"
						}
					]
				},
				"aim": {
					"animations": [
						"hkc_aim"
					],
					"on_entry": [
						"/camerashake add @s[tag=!cooldown,scores={hkc=2..}] 0.055 0.075 rotational",
						"/camerashake add @s[tag=!hkcnormal,tag=!hkccqb,tag=!hkcsimple] 0.08 0.3 rotational"
					],
					"transitions": [
						{
							"preshoot": "q.all_animations_finished||!q.is_alive"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc')||!q.is_alive"
						}
					]
				}
			}
		},
