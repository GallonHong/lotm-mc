{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.ram": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"draw": "q.mark_variant==0&&query.is_item_name_any('slot.weapon.mainhand',0,'bridge:ram')"
						},
						{
							"unequip": "q.mark_variant==8&&!query.is_item_name_any('slot.weapon.mainhand',0,'bridge:ram')"
						},
						{
							"hold": "q.mark_variant==8&&query.is_item_name_any('slot.weapon.mainhand',0,'bridge:ram')"
						}
					],
					"on_exit": [
						"/event entity @s equip:ram"
					]
				},
				"draw": {
					"animations": [
						"ram_draw"
					],
					"transitions": [
						{
							"hold": "query.is_item_name_any('slot.weapon.mainhand',0,'bridge:ram')&&q.all_animations_finished"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'bridge:ram')&&q.all_animations_finished"
						}
					]
				},
				"unequip": {
					"animations": [
						"ram_unequip"
					],
					"transitions": [
						{
							"default": "query.all_animations_finished"
						}
					],
					"on_exit": [
						"/event entity @s unequip:ram"
					]
				},
				"hold": {
					"transitions": [
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'bridge:ram')"
						},
						{
							"inspect": "query.is_item_name_any('slot.weapon.mainhand',0,'bridge:ram')&&q.property('hengker:reload')=='inspect'"
						}
					]
				},
				"inspect": {
					"animations": [
						"ram_inspect"
					],
					"transitions": [
						{
							"hold": "query.is_item_name_any('slot.weapon.mainhand',0,'bridge:ram')&&q.all_animations_finished"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'bridge:ram')"
						}
					],
					"on_exit": [
						"@s hengker:rilotend"
					]
				}
			}
		},
