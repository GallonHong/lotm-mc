						}
					]
				},
				"hold": {
					"transitions": [
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'bridge:tank')"
						},
						{
							"inspect": "query.is_item_name_any('slot.weapon.mainhand',0,'bridge:tank')&&q.property('hengker:reload')=='inspect'"
						}
					]
				},
				"inspect": {
