{
    "format_version": "1.19.80",
    "minecraft:entity": {
        "description": {
            "identifier": "pb_dmgi:training_dummy",
            "is_spawnable": true,
            "is_summonable": true,
            "is_experimental": false,
            "animations": {
                "dummy_regen": "animation.pb_dmgi.dummy_regen",
                "control": "controller.animation.pb_dmgi.dummy_switch"
            },
            "scripts": {
                "animate": [
                    "dummy_regen",
                    "control"
                ]
            },
            "properties": {
                "pb_dmgi:menu": {
                    "type": "bool",
                    "client_sync": true,
                    "default": false
                }
            }
        },
        "component_groups": {
            "pb:despawn": {
                "minecraft:instant_despawn": {}
            },
            "pb:interact": {
                "minecraft:interact": {
                    "interactions": [
                        {
                            "on_interact": {
                                "filters": {
                                    "test": "is_family",
                                    "subject": "other",
                                    "value": "player"
                                },
                                "event": "evt:open_menu"
                            },
                            "use_item": false,
                            "swing": true,
                            "interact_text": "pb_dmgi_action.interact.menu"
                        }
                    ]
                }
            },
            "pb:damage_all": {
                "minecraft:damage_sensor": {
                    "triggers": [
                        {
                            "on_damage": {
                                "filters": {
                                    "test": "has_damage",
                                    "value": "fatal"
                                }
                            },
                            "deals_damage": false
                        },
                        {
                            "on_damage": {
                                "filters": {
                                    "test": "has_damage",
                                    "operator": "not",
                                    "value": "fatal"
                                }
                            },
                            "deals_damage": true,
                            "damage_multiplier": 1.0
