{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "pb_dmgi:explosion",
            "basic_render_parameters": {
                "material": "particles_add",
                "texture": "textures/pb/dmgi/particle/explode_animated_32"
            }
        },
        "components": {
            "minecraft:emitter_initialization": {
                "creation_expression": "variable.size = 0.4;variable.size_variant = 0.4;variable.spawn_radius = 0.3;variable.particle_growth = 0.2;variable.lifetime = 0.2;"
            },
            "minecraft:emitter_rate_instant": {
                "num_particles": "variable.damage"
            },
            "minecraft:emitter_lifetime_once": {
                "active_time": 1
            },
            "minecraft:emitter_shape_point": {
                "offset": [
                    0,
                    1,
                    0
                ]
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": "Math.random(variable.lifetime, variable.lifetime*1.5)"
            },
            "minecraft:particle_initial_spin": {
                "rotation": "(variable.particle_random_3-0.5)*60",
                "rotation_rate": "(variable.particle_random_1-0.5)*40"
            },
            "minecraft:particle_initial_speed": "Math.random(6,8)",
            "minecraft:particle_motion_dynamic": {
                "linear_drag_coefficient": 5
            },
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "variable.size+(variable.particle_random_1*variable.size_variant)+(variable.particle_age*variable.particle_growth)",
                    "variable.size+(variable.particle_random_1*variable.size_variant)+(variable.particle_age*variable.particle_growth)"
                ],
                "facing_camera_mode": "rotate_xyz",
                "uv": {
                    "texture_width": 32,
                    "texture_height": 256,
                    "flipbook": {
                        "base_UV": [
                            0,
                            32
                        ],
                        "size_UV": [
                            32,
                            32
                        ],
                        "step_UV": [
                            0,
                            32
                        ],
                        "frames_per_second": 12,
                        "max_frame": 7,
                        "stretch_to_lifetime": true
                    }
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": {
                    "interpolant": "variable.particle_age",
                    "gradient": {
                        "0.0": "#B3FFFFFF",
                        "0.18": "#CFFFCE50",
                        "0.46": "#4F787777"
                    }
                }
            }
        }
    }
}
