{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "pb_dmgi:hit_comic",
            "basic_render_parameters": {
                "material": "particles_blend",
                "texture": "textures/pb/dmgi/particle/comic_impact"
            }
        },
        "curves": {
            "variable.size_curve": {
                "type": "linear",
                "input": "v.particle_age",
                "horizontal_range": "v.particle_lifetime",
                "nodes": [
                    0.14,
                    1.15,
                    1.18,
                    1.19,
                    1.12,
                    1.07,
                    0
                ]
            },
            "variable.alpha_curve": {
                "type": "linear",
                "input": "v.particle_age",
                "horizontal_range": "v.particle_lifetime",
                "nodes": [
                    1,
                    0.34,
                    0
                ]
            }
        },
        "components": {
            "minecraft:emitter_initialization": {
                "creation_expression": "variable.size = 0.6;variable.lifetime = 1.0;variable.size_variant = 0.1;"
            },
            "minecraft:emitter_rate_instant": {
                "num_particles": 1
            },
            "minecraft:emitter_lifetime_once": {
