{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "pb_dmgi:explosion_ember",
            "basic_render_parameters": {
                "material": "particles_blend",
                "texture": "textures/pb/dmgi/particle/flash_2"
            }
        },
        "components": {
            "minecraft:emitter_initialization": {
                "creation_expression": "variable.size = 0.3;variable.lifetime = 1.0;variable.size_variant = 0.3;"
            },
            "minecraft:emitter_rate_instant": {
                "num_particles": "variable.damage*1.5"
            },
            "minecraft:emitter_lifetime_once": {
                "active_time": 1
            },
            "minecraft:emitter_shape_sphere": {
                "offset": [
                    0,
                    1.9,
                    0
                ],
                "radius": 0.2,
                "direction": "outwards"
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": "(variable.particle_random_1+0.3)*variable.lifetime"
            },
            "minecraft:particle_initial_spin": {
                "rotation": "variable.particle_random_1*360",
                "rotation_rate": "(variable.particle_random_2-0.5)*90"
            },
            "minecraft:particle_initial_speed": "(variable.particle_random_1*6)+8",
            "minecraft:particle_motion_dynamic": {
                "linear_acceleration": [
                    0,
                    -9.5,
                    0
                ],
                "linear_drag_coefficient": 4
            },
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "variable.size+(variable.size_variant*variable.particle_random_4)-(variable.particle_age*0.4)",
                    "variable.size+(variable.size_variant*variable.particle_random_4)-(variable.particle_age*0.4)"
                ],
                "facing_camera_mode": "lookat_xyz",
                "uv": {
                    "texture_width": 64,
                    "texture_height": 64,
                    "uv": [
                        0,
                        0
                    ],
                    "uv_size": [
                        64,
                        64
                    ]
                }
            },
            "minecraft:particle_motion_collision": {
                "coefficient_of_restitution": 2,
                "collision_radius": 0.25,
                "expire_on_contact": true
            },
            "minecraft:particle_appearance_tinting": {
                "color": {
                    "interpolant": "variable.particle_age",
                    "gradient": {
                        "0.0": "#FFFFFFFF",
                        "0.39": "#D1FFC100",
                        "1.0": "#DB571806"
                    }
                }
            }
        }
    }
}
