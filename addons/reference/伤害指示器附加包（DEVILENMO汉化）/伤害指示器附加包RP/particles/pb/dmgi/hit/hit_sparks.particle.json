{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "pb_dmgi:hit_sparks",
            "basic_render_parameters": {
                "material": "particles_add",
                "texture": "textures/pb/dmgi/particle/spark_90_2"
            }
        },
        "components": {
            "minecraft:emitter_initialization": {
                "creation_expression": "variable.size = 0.2;variable.lifetime = 0.25;variable.size_variant = 0.2;variable.age_growth = 1.0;"
            },
            "minecraft:emitter_rate_instant": {
                "num_particles": "variable.damage*3"
            },
            "minecraft:emitter_lifetime_once": {
                "active_time": 1
            },
            "minecraft:emitter_shape_sphere": {
                "offset": [
                    0,
                    1.0,
                    0
                ],
                "radius": 0.2,
                "surface_only": true,
                "direction": "outwards"
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": "(variable.particle_random_1*variable.lifetime)+0.1"
            },
            "minecraft:particle_initial_speed": "(variable.particle_random_1*6)+12",
            "minecraft:particle_motion_dynamic": {
                "linear_drag_coefficient": "3-(variable.particle_age*5)"
            },
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "3*math.clamp(((variable.size+variable.size_variant*variable.particle_random_4)-variable.particle_age*variable.age_growth),0.1,2)",
                    "1*math.clamp(((variable.size+variable.size_variant*variable.particle_random_4)-variable.particle_age*variable.age_growth),0.1,2)"
                ],
                "facing_camera_mode": "lookat_direction",
                "uv": {
                    "texture_width": 32,
                    "texture_height": 32,
                    "uv": [
                        0,
                        0
                    ],
                    "uv_size": [
                        32,
                        32
                    ]
                }
            },
            "minecraft:particle_motion_collision": {
                "coefficient_of_restitution": 2,
                "collision_radius": 0.25,
                "expire_on_contact": true
            },
            "minecraft:particle_appearance_tinting": {
                "color": {
                    "interpolant": "variable.particle_age",
                    "gradient": {
                        "0.0": "#FFFFFFFF",
                        "0.07": "#FFB9B9B9",
                        "0.2": "#00676767"
                    }
                }
            }
        }
    }
}
