{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.makercamp_dr.inventory_drone.inventory": {
			"states": {
				"default": {
					"transitions": [
						{
							"open": "v.inventory_open"
						}
					]
				},
				"open": {
					"animations": [
						"open"
					],
					"transitions": [
						{
							"close": "!v.inventory_open"
						}
					]
				},
				"close": {
					"animations": [
						"close"
					],
					"transitions": [
						{
							"open": "v.inventory_open"
						}
					]
				}
			}
		}
	}
}