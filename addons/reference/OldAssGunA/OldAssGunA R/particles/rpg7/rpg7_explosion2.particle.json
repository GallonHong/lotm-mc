{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "mw:rpg7_explosion2",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "better_smoke"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 80
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.1
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, 0.1, 0],
				"radius": 0.01,
				"surface_only": true,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(2,1)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-360,360)",
				"rotation_rate": "math.random(200,-200)"
			},
			"minecraft:particle_initial_speed": "math.random(80,20)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [6, 5, 6],
				"linear_drag_coefficient": 4
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.particle_age*2.5+2", "v.particle_age*2.5+2"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 32,
					"texture_height": 32,
					"uv": [0, 0],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 18,
				"collision_radius": 0.001
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#35FFFFFF",
						"1.0": "#00FFFFFF"
					}
				}
			}
		}
	}
}