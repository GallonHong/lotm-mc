{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ab_ve:water_splash",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/asiagobagels/vehicles/particle/particles_"
			}
		},
		"curves": {
			"variable.size": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [1, 1, 1, 0.65, 0, 0]
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 25
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.3,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "1+(variable.particle_random_1/1)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)"
			},
			"minecraft:particle_initial_speed": 2,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -1, 0],
				"linear_drag_coefficient": 3
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(0.06+(variable.particle_random_1/10))*variable.size", "(0.06+(variable.particle_random_1/10))*variable.size"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": ["2+math.floor(variable.particle_random_1*2)*8", 3],
					"uv_size": [4, 4]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 1,
				"coefficient_of_restitution": 0.3,
				"collision_radius": 0.2,
				"expire_on_contact": true
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age/variable.particle_lifetime",
					"gradient": {
						"0.0": "#FF004BFF",
						"1.0": "#ffffff00"
					}
				}
			}
		}
