{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ab_ve:water_projectile",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/asiagobagels/vehicles/particle/particles_"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 100,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, 1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "1+(variable.particle_random_1/5)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)"
			},
			"minecraft:particle_initial_speed": 0.1,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -0.3, 0],
				"linear_drag_coefficient": -0.4
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.12+(variable.particle_random_1/10)", "0.12+(variable.particle_random_1/10)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": ["25+math.floor(variable.particle_random_1*4)*8", 13],
					"uv_size": [4, 4]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 1,
				"coefficient_of_restitution": 0.3,
				"collision_radius": 0.2,
				"expire_on_contact": true
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_random_1",
					"gradient": {
						"0.0": "#ffffffff",
						"1.0": "#406059FF"
					}
				}
			}
		}
