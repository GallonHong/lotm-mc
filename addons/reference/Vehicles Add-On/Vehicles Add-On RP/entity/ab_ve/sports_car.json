{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "ab_ve:sports_car",
			"materials": {
				"default": "entity_alphatest",
				"light": "entity_emissive_alpha",
				"cracks": "entity_alphablend"
			},
			"textures": {
				"white": "textures/asiagobagels/vehicles/entity/sports_car/white",
				"light_gray": "textures/asiagobagels/vehicles/entity/sports_car/light_gray",
				"gray": "textures/asiagobagels/vehicles/entity/sports_car/gray",
				"black": "textures/asiagobagels/vehicles/entity/sports_car/black",
				"brown": "textures/asiagobagels/vehicles/entity/sports_car/brown",
				"red": "textures/asiagobagels/vehicles/entity/sports_car/red",
				"orange": "textures/asiagobagels/vehicles/entity/sports_car/orange",
				"yellow": "textures/asiagobagels/vehicles/entity/sports_car/yellow",
				"lime": "textures/asiagobagels/vehicles/entity/sports_car/lime",
				"green": "textures/asiagobagels/vehicles/entity/sports_car/green",
				"cyan": "textures/asiagobagels/vehicles/entity/sports_car/cyan",
				"light_blue": "textures/asiagobagels/vehicles/entity/sports_car/light_blue",
				"blue": "textures/asiagobagels/vehicles/entity/sports_car/blue",
				"purple": "textures/asiagobagels/vehicles/entity/sports_car/purple",
				"magenta": "textures/asiagobagels/vehicles/entity/sports_car/magenta",
				"pink": "textures/asiagobagels/vehicles/entity/sports_car/pink",
				"crack_0": "textures/asiagobagels/vehicles/overlay/invisible",
				"crack_1": "textures/asiagobagels/vehicles/overlay/512/crack_0",
				"crack_2": "textures/asiagobagels/vehicles/overlay/512/crack_1",
				"crack_3": "textures/asiagobagels/vehicles/overlay/512/crack_2"
			},
			"geometry": {
				"default": "geometry.ab_ve.sports_car",
				"cracks": "geometry.ab_ve.crack.sports_car"
			},
			"animations": {
				"wheels": "animation.ab_ve.racing_car.wheels",
				"wobble": "animation.ab_ve.sports_car.wobble",
				"light": "animation.ab_ve.sports_car.light",
				"speed_lines": "animation.ab_ve.speed_lines",
				"spawn": "animation.ab_ve.spawn",
				"spawning":"controller.animation.ab_ve.spawn_animation",
				"speed_lines_controller": "controller.animation.ab_ve.speed_lines"
			},
			"scripts": {
				"initialize": [
					"variable.speed = 0;",
					"variable.wheel_turns = Math.random(-80, 80);",
					"variable.shake_dir = 1;"
				],
				"pre_animation": [
					"variable.speed = query.ground_speed;",
					"variable.wheel_turns = (variable.wheel_turns + query.yaw_speed) / 2;"
				],
				"animate": [
					{
						"wheels": "query.modified_move_speed"
					},
					{
						"wobble": "query.modified_move_speed"
					},
					{
						"light": "query.property('ab_ve:light')"
					},
					"spawning",
					"speed_lines_controller"
				]
			},
			"particle_effects": {
				"headlight": "ab_ve:headlight",
				"backlight": "ab_ve:backlight",
				"exhaust": "ab_ve:exhaust",
				"speed_lines": "ab_ve:speed_lines"
			},
			"render_controllers": [
				"controller.render.ab_ve.vehicles.color",
				"controller.render.ab_ve.vehicles.crack"
			]
		}
	}
}