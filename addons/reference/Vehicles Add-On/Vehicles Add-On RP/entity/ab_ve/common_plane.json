{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "ab_ve:common_plane",
			"materials": {
				"default": "entity_alphatest",
				"light": "entity_emissive_alpha",
				"cracks": "entity_alphablend"
			},
			"textures": {
				"white": "textures/asiagobagels/vehicles/entity/common_plane/white",
				"light_gray": "textures/asiagobagels/vehicles/entity/common_plane/light_gray",
				"gray": "textures/asiagobagels/vehicles/entity/common_plane/gray",
				"black": "textures/asiagobagels/vehicles/entity/common_plane/black",
				"brown": "textures/asiagobagels/vehicles/entity/common_plane/brown",
				"red": "textures/asiagobagels/vehicles/entity/common_plane/red",
				"orange": "textures/asiagobagels/vehicles/entity/common_plane/orange",
				"yellow": "textures/asiagobagels/vehicles/entity/common_plane/yellow",
				"lime": "textures/asiagobagels/vehicles/entity/common_plane/lime",
				"green": "textures/asiagobagels/vehicles/entity/common_plane/green",
				"cyan": "textures/asiagobagels/vehicles/entity/common_plane/cyan",
				"light_blue": "textures/asiagobagels/vehicles/entity/common_plane/light_blue",
				"blue": "textures/asiagobagels/vehicles/entity/common_plane/blue",
				"purple": "textures/asiagobagels/vehicles/entity/common_plane/purple",
				"magenta": "textures/asiagobagels/vehicles/entity/common_plane/magenta",
				"pink": "textures/asiagobagels/vehicles/entity/common_plane/pink",
				"crack_0": "textures/asiagobagels/vehicles/overlay/invisible",
				"crack_1": "textures/asiagobagels/vehicles/overlay/512/crack_0",
				"crack_2": "textures/asiagobagels/vehicles/overlay/512/crack_1",
				"crack_3": "textures/asiagobagels/vehicles/overlay/512/crack_2"
			},
			"geometry": {
				"default": "geometry.ab_ve.common_plane",
				"cracks": "geometry.ab_ve.crack.common_plane"
			},
			"animations": {
				"idle": "animation.ab_ve.common_plane.idle",
				"moving": "animation.ab_ve.common_plane.moving",
				"wheels": "animation.ab_ve.private_plane.wheels",
				"speed_lines": "animation.ab_ve.speed_lines",
				"spawn": "animation.ab_ve.spawn",
				"spawning":"controller.animation.ab_ve.spawn_animation",
				"speed_lines_controller": "controller.animation.ab_ve.speed_lines"
			},
			"scripts": {
				"initialize": [
					"variable.speed = 0;",
					"variable.wheel_turns = Math.random(-80, 80);",
					"variable.shake_dir = 1;"
				],
				"pre_animation": [
					"variable.speed = query.ground_speed;",
					"variable.wheel_turns = (variable.wheel_turns + query.yaw_speed) / 2;"
				],
				"animate": [
					{
						"idle": "!query.is_moving && query.has_rider"
					},
					{
						"moving": "query.modified_move_speed*3"
					},
					{
						"wheels": "query.modified_move_speed"
					},
					"spawning",
					"speed_lines_controller"
				]
			},
			"particle_effects": {
				"speed_lines": "ab_ve:speed_lines"
			},
			"render_controllers": [
				"controller.render.ab_ve.vehicles.color",
				"controller.render.ab_ve.vehicles.crack"
			]
		}
	}
}