{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "ab_ve:jetski",
			"materials": {
				"default": "entity_alphatest",
				"light": "entity_emissive_alpha",
				"cracks": "entity_alphablend"
			},
			"textures": {
				"white": "textures/asiagobagels/vehicles/entity/jetski/white",
				"light_gray": "textures/asiagobagels/vehicles/entity/jetski/light_gray",
				"gray": "textures/asiagobagels/vehicles/entity/jetski/gray",
				"black": "textures/asiagobagels/vehicles/entity/jetski/black",
				"brown": "textures/asiagobagels/vehicles/entity/jetski/brown",
				"red": "textures/asiagobagels/vehicles/entity/jetski/red",
				"orange": "textures/asiagobagels/vehicles/entity/jetski/orange",
				"yellow": "textures/asiagobagels/vehicles/entity/jetski/yellow",
				"lime": "textures/asiagobagels/vehicles/entity/jetski/lime",
				"green": "textures/asiagobagels/vehicles/entity/jetski/green",
				"cyan": "textures/asiagobagels/vehicles/entity/jetski/cyan",
				"light_blue": "textures/asiagobagels/vehicles/entity/jetski/light_blue",
				"blue": "textures/asiagobagels/vehicles/entity/jetski/blue",
				"purple": "textures/asiagobagels/vehicles/entity/jetski/purple",
				"magenta": "textures/asiagobagels/vehicles/entity/jetski/magenta",
				"pink": "textures/asiagobagels/vehicles/entity/jetski/pink",
				"crack_0": "textures/asiagobagels/vehicles/overlay/invisible",
				"crack_1": "textures/asiagobagels/vehicles/overlay/128/crack_0",
				"crack_2": "textures/asiagobagels/vehicles/overlay/128/crack_1",
				"crack_3": "textures/asiagobagels/vehicles/overlay/128/crack_2"
			},
			"geometry": {
				"default": "geometry.ab_ve.jetski",
				"cracks": "geometry.ab_ve.crack.jetski"
			},
			"animations": {
				"wheels": "animation.ab_ve.jetski.steering",
				"speed_lines": "animation.ab_ve.speed_lines",
				"spawn": "animation.ab_ve.spawn",
				"spawning":"controller.animation.ab_ve.spawn_animation",
				"speed_lines_controller": "controller.animation.ab_ve.speed_lines"
			},
			"scripts": {
				"initialize": [
					"variable.speed = 0;",
					"variable.wheel_turns = Math.random(-80, 80);",
					"variable.shake_dir = 1;"
				],
				"pre_animation": [
					"variable.speed = query.ground_speed;",
					"variable.wheel_turns = (variable.wheel_turns + query.yaw_speed) / 2;"
				],
				"animate": [
					{
						"wheels": "query.modified_move_speed"
					},
					"spawning",
					"speed_lines_controller"
				]
			},
			"particle_effects": {
				"headlight": "ab_ve:headlight",
				"speed_lines": "ab_ve:speed_lines",
				"exhaust": "ab_ve:exhaust"
			},
			"render_controllers": [
				"controller.render.ab_ve.vehicles.color",
				"controller.render.ab_ve.vehicles.crack"
			]
		}
	}
}