{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "minecraft:rain_splash_particle",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/particles"
      }
    },
    "events": {
      "drp:rain": {
        "randomize": [
          {
            "weight": 1,
            "particle_effect": {
              "effect": "drp:rain_ripple",
              "type": "particle"
            }
          },
          {
            "weight": 1,
            "particle_effect": {
              "effect": "",
              "type": "emitter"
            }
          },
          {
            "weight": 1,
            "particle_effect": {
              "effect": "drp:rain_fog",
              "type": "particle"
            }
          },
          {
            "weight": 1,
            "particle_effect": {
              "effect": "",
              "type": "emitter"
            }
          }
        ]
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.lift = math.random(1, 4);"
      },
      "minecraft:emitter_rate_manual": {
        "max_particles": 300
      },
      "minecraft:emitter_lifetime_expression": {
        "activation_expression": 1
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "Math.Random(0.25, 0.35)"
      },
      "minecraft:particle_lifetime_events": {
        "creation_event": [
          "drp:rain_oak_leaves",
          "drp:rain_birch_leaves",
          "drp:rain_spruce_leaves",
          "drp:rain_acacia_leaves",
          "drp:rain_jungle_leaves",
          "drp:rain_dark_oak_leaves",
          "drp:rain_mangrove_leaves",
          "drp:rain_azalea_leaves",
          "drp:rain_cherry_leaves",
          "drp:rain_pale_oak_leaves",
          "drp:rain"
        ]
      },
      "minecraft:particle_initial_speed": "variable.lift",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "-6*variable.lift",
          0
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.175,
          0.175
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            "24+Math.Round(variable.particle_random_1*3.0)*8",
            8
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_motion_collision": {
        "collision_drag": 10,
        "coefficient_of_restitution": 0.1,
        "collision_radius": 0.01
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#EBFFFFFF",
            "0.66": "#F0FFFFFF",
            "1.0": "#00FFFFFF"
          }
        }
      }
    }
  }
}
