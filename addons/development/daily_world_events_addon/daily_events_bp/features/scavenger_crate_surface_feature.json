{
  "format_version": "1.21.50",
  "minecraft:single_block_feature": {
    "description": {
      "identifier": "daily:scavenger_crate_surface_feature"
    },
    "places_block": [
      {
        "block": "daily:loot_crate_scavenger",
        "weight": 1
      }
    ],
    "may_attach_to": {
      "auto_rotate": false,
      "min_sides_must_attach": 1,
      "bottom": [
        "minecraft:grass_block",
        "minecraft:dirt",
        "minecraft:coarse_dirt",
        "minecraft:podzol",
        "minecraft:mycelium",
        "minecraft:moss_block",
        "minecraft:mud",
        "minecraft:stone",
        "minecraft:deepslate",
        "minecraft:sand",
        "minecraft:red_sand",
        "minecraft:gravel",
        "minecraft:hardened_clay"
      ]
    },
    "enforce_survivability_rules": true,
    "enforce_placement_rules": true,
    "may_replace": ["minecraft:air"]
  }
}
