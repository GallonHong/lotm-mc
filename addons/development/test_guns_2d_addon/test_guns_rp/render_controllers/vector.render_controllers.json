{
  "format_version": "1.10",
  "render_controllers": {
    "controller.render.first_vector": {
      "arrays": {
        "textures": {
          "array.swords": [
            "texture.f1",
            "texture.f2",
            "texture.f3",
            "texture.f4",
            "texture.f5"
          ]
        }
      },
      "geometry": "geometry.first",
      "materials": [
        {
          "*": "variable.is_enchanted ? material.enchanted : material.default"
        }
      ],
      "textures": [
        "array.swords[(query.anim_time * 8)]"
      ]
    },
    "controller.render.third_vector": {
      "arrays": {
        "textures": {
          "array.swords": [
            "texture.f1",
            "texture.f2",
            "texture.f3",
            "texture.f4",
            "texture.f5"
          ]
        }
      },
      "geometry": "geometry.third",
      "materials": [
        {
          "*": "variable.is_enchanted ? material.enchanted : material.default"
        }
      ],
      "textures": [
        "array.swords[(query.anim_time * 8)]"
      ]
    }
  }
}