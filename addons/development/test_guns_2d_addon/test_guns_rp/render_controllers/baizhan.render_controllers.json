{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.baizhan.held": {
      "geometry": "array.legendary_shapes[math.mod(math.floor(query.anim_time * 8), 8)]",
      "materials": [
        {
          "*": "variable.is_enchanted ? material.enchanted : material.default"
        }
      ],
      "textures": [
        "array.legendary_frames[math.mod(math.floor(query.anim_time * 8), 8)]"
      ],
      "part_visibility": [
        {
          "*": "!variable.tg3d_sneaking"
        }
      ],
      "arrays": {
        "textures": {
          "array.legendary_frames": [
            "texture.f1",
            "texture.f2",
            "texture.f3",
            "texture.f4",
            "texture.f5",
            "texture.f6",
            "texture.f7",
            "texture.f8"
          ]
        },
        "geometries": {
          "array.legendary_shapes": [
            "geometry.f1",
            "geometry.f2",
            "geometry.f3",
            "geometry.f4",
            "geometry.f5",
            "geometry.f6",
            "geometry.f7",
            "geometry.f8"
          ]
        }
      }
    },
    "controller.render.baizhan.mount": {
      "geometry": "array.legendary_shapes[math.mod(math.floor(query.anim_time * 8), 8)]",
      "materials": [
        {
          "*": "material.default"
        }
      ],
      "textures": [
        "array.legendary_frames[math.mod(math.floor(query.anim_time * 8), 8)]"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "mount_body": "query.distance_from_camera > 2.5"
        },
        {
          "mount_tripod": "query.distance_from_camera > 2.5"
        },
        {
          "bolt": "query.distance_from_camera > 2.5"
        },
        {
          "feed_cover": "query.distance_from_camera > 2.5"
        },
        {
          "mount_barrel": "query.distance_from_camera > 2.5 || math.abs(query.property('test_gun:aim_pitch')) < 25"
        }
      ],
      "arrays": {
        "textures": {
          "array.legendary_frames": [
            "texture.f1",
            "texture.f2",
            "texture.f3",
            "texture.f4",
            "texture.f5",
            "texture.f6",
            "texture.f7",
            "texture.f8"
          ]
        },
        "geometries": {
          "array.legendary_shapes": [
            "geometry.f1",
            "geometry.f2",
            "geometry.f3",
            "geometry.f4",
            "geometry.f5",
            "geometry.f6",
            "geometry.f7",
            "geometry.f8"
          ]
        }
      }
    }
  }
}
