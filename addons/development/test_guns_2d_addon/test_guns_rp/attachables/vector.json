{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "test_gun:vector",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/guns/vector_base",
        "f1": "textures/guns/stg/stgsf_1",
        "f2": "textures/guns/stg/stgsf_2",
        "f3": "textures/guns/stg/stgsf_3",
        "f4": "textures/guns/stg/stgsf_4",
        "f5": "textures/guns/stg/stgsf_5",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "first": "geometry.sword.first_person",
        "third": "geometry.sword.third_person"
      },
      "animations": {
        "wield": "animation.cso.wield",
        "shoot": "animation.cso.wield_first_person_pull"
      },
      "scripts": {
        "animate": [
          "wield",
          {
            "shoot": "q.is_using_item && c.is_first_person"
          }
        ]
      },
      "render_controllers": [
        {
          "controller.render.first_vector": "c.is_first_person"
        },
        {
          "controller.render.third_vector": "!c.is_first_person"
        }
      ]
    }
  }
}