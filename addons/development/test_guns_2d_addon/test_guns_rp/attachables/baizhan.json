{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "test_gun:baizhan",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/entity/baizhan",
        "enchanted": "textures/misc/enchanted_item_glint",
        "f1": "textures/entity/dynamic/baizhan_f1",
        "f2": "textures/entity/dynamic/baizhan_f2",
        "f3": "textures/entity/dynamic/baizhan_f3",
        "f4": "textures/entity/dynamic/baizhan_f4",
        "f5": "textures/entity/dynamic/baizhan_f5",
        "f6": "textures/entity/dynamic/baizhan_f6",
        "f7": "textures/entity/dynamic/baizhan_f7",
        "f8": "textures/entity/dynamic/baizhan_f8"
      },
      "geometry": {
        "default": "geometry.baizhan",
        "f1": "geometry.baizhan_f1",
        "f2": "geometry.baizhan_f2",
        "f3": "geometry.baizhan_f3",
        "f4": "geometry.baizhan_f4",
        "f5": "geometry.baizhan_f5",
        "f6": "geometry.baizhan_f6",
        "f7": "geometry.baizhan_f7",
        "f8": "geometry.baizhan_f8"
      },
      "animations": {
        "hold_first": "animation.tg3d.hold_first",
        "hold_third": "animation.tg3d.hold_third",
        "idle": "animation.tg3d.idle",
        "sprint": "animation.tg3d.sprint",
        "aim_first": "animation.tg3d.aim_first",
        "aim_third": "animation.tg3d.aim_third",
        "still": "animation.tg3d.still",
        "weapon_action": "animation.tg3d.weapon_action",
        "tg3d_pose_direct": "animation.tg3d.pose_direct",
        "tg3d_muzzle_direct": "animation.tg3d.muzzle_direct",
        "baizhan_mechanism": "animation.baizhan.mechanism"
      },
      "scripts": {
        "animate": [
          {
            "hold_first": "context.is_first_person"
          },
          {
            "hold_third": "!context.is_first_person"
          },
          "tg3d_pose_direct",
          "weapon_action",
          {
            "tg3d_muzzle_direct": "variable.tg3d_fire_pulse"
          },
          {
            "aim_first": "context.is_first_person"
          },
          "baizhan_mechanism"
        ],
        "pre_animation": [
          "variable.tg3d_aim = math.clamp((context.owning_entity -> (variable.tg3d_hand_aim ?? query.is_sneaking)), 0, 1);",
          "variable.tg3d_view_aim_y = (context.owning_entity -> (variable.tg3d_view_aim_y ?? -0.506524));",
          "variable.tg3d_view_aim_x = (context.owning_entity -> (variable.tg3d_view_aim_x ?? 5.0));",
          "variable.tg3d_sneaking = (context.owning_entity -> query.is_sneaking);",
          "variable.tg3d_sprinting = (context.owning_entity -> query.is_sprinting);",
          "variable.tg3d_using = (context.owning_entity -> query.is_using_item);",
          "variable.tg3d_owner_age = (context.owning_entity -> query.life_time);",
          "variable.tg3d_shot = (context.owning_entity -> (variable.tg3d_shot ?? 0));",
          "variable.tg3d_stamp = (context.owning_entity -> (variable.tg3d_stamp ?? -100));",
          "variable.tg3d_owner_gun = (context.owning_entity -> (variable.tg3d_gun ?? 0));",
          "variable.tg3d_owner_kind = (context.owning_entity -> (variable.tg3d_kind ?? 0));",
          "variable.tg3d_progress = math.clamp((context.owning_entity -> (variable.tg3d_progress ?? 0)), 0, 1);",
          "variable.tg3d_valid = context.item_slot == 'main_hand' && variable.tg3d_owner_gun == 26 && variable.tg3d_owner_age >= variable.tg3d_stamp && variable.tg3d_owner_age - variable.tg3d_stamp < 0.3;",
          "variable.tg3d_reloading = variable.tg3d_valid && variable.tg3d_owner_kind == 2;",
          "variable.tg3d_kick = variable.tg3d_valid && variable.tg3d_owner_kind == 1 ? math.clamp(math.min(variable.tg3d_progress / 0.2, (1 - variable.tg3d_progress) / 0.8), 0, 1) : 0;",
          "variable.tg3d_reload_shape = variable.tg3d_reloading ? math.sin(variable.tg3d_progress * 180) : 0;",
          "variable.tg3d_pose_run = variable.tg3d_pose_run + ((!variable.tg3d_reloading && !variable.tg3d_sneaking && variable.tg3d_sprinting && !variable.tg3d_using ? 1 : 0) - variable.tg3d_pose_run) * math.clamp(query.delta_time * 12, 0, 1);",
          "variable.tg3d_pose_idle = !variable.tg3d_reloading && !variable.tg3d_sneaking ? 1 - variable.tg3d_pose_run : 0;",
          "variable.tg3d_fire_pulse = variable.tg3d_valid && variable.tg3d_owner_kind == 1 && variable.tg3d_shot != variable.tg3d_seen_shot;",
          "variable.tg3d_seen_shot = variable.tg3d_valid && variable.tg3d_owner_kind == 1 ? variable.tg3d_shot : variable.tg3d_seen_shot;"
        ],
        "initialize": [
          "variable.tg3d_seen_shot = 0;",
          "variable.tg3d_pose_run = 0;"
        ]
      },
      "render_controllers": [
        "controller.render.baizhan.held"
      ],
      "particle_effects": {
        "muzzle_flash": "test_gun:muzzle_flash_circle"
      }
    }
  }
}
