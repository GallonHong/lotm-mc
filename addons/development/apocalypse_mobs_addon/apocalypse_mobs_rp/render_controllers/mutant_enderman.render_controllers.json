{
  "format_version": "1.8.0",
  "render_controllers": {
	"controller.render.mutant_enderman_death": {

		"overlay_color": {
		  "r": "0.5 + Math.cos( query.anim_time * 360*3 ) * 0.1+ Math.min(Math.max(0, query.anim_time * 0.15 - 0) , 1) * 1",
		  "g": "0",
		  "b": "0.5 + Math.cos( query.anim_time * 360*3 ) * 0.1+ Math.min(Math.max(0, query.anim_time * 0.15 - 0) , 1) * 1",
		  "a": "0.5 + Math.cos( query.anim_time * 360*3 ) * 0.1+ Math.min(Math.max(0, query.anim_time * 0.15 - 0) , 1) * 1"
		},
		"is_hurt_color": {
			"r": 1,
			"g": 0,
			"b": 0,
			"a": "(!query.is_powered * 0.6)+(!query.is_alive * -0.6)"
		  },
      "arrays": {
	
        "materials": {
          "Array.materials": [ "Material.default", "Material.invisible" ]
        },
        "geometries": {
          "Array.geos": [ "Geometry.default", "Geometry.clone" ]
        },
				"textures": {
					"Array.skins": [
						"Texture.default",
						"Texture.clone"
					]
				}
			},
			
      "geometry": "Array.geos[query.variant]",
	  "materials": [ 
		  { "*": "Array.materials[query.is_invisible]" }
	 ],
			"textures": ["Array.skins[query.variant]"]
		},
    "controller.render.mutant_enderman": {
		"is_hurt_color": {
			"r": 1,
			"g": 0,
			"b": 0,
			"a": "(!query.is_powered * 0.6)+(!query.is_alive * -0.6)"
		  },
      "arrays": {
	
        "materials": {
          "Array.materials": [ "Material.default", "Material.invisible" ]
        },
        "geometries": {
          "Array.geos": [ "Geometry.default", "Geometry.clone" ]
        },
				"textures": {
					"Array.skins": [
						"Texture.default",
						"Texture.clone"
					]
				}
			},
			
      "geometry": "Array.geos[query.variant]",
	  "materials": [ 
		  { "*": "Array.materials[query.is_invisible]" }
	 ],
			"textures": ["Array.skins[query.variant]"]
		},
	
		"controller.render.mutant_enderman_eyes": {
			"overlay_color": {
				"r": 1,
				"g": 1,
				"b": 1,
				"a": 0.15
				  },
				  "is_hurt_color": {
					"r": 1,
					"g": 0,
					"b": 0,
					"a": "(!query.is_powered * 0.6)+(!query.is_alive * -0.6)"
				  },
			"geometry": "Geometry.default",
	  
			"materials": [ { "*": "Material.eyes" } ],
			"textures": [ "Texture.eyes" ],
		
		  "part_visibility": [ { "*": "!query.is_powered" } ],
			"ignore_lighting": true
		  },

		  "controller.render.endersoul_block": {
			"geometry": "Geometry.default",
	  
			"materials": [ { "*": "Material.default" } ],
			"textures": [ "Texture.default" ],
			
		
			"uv_anim": {
			  "offset": [
				"query.life_time * 0.4*0.2",
				"query.life_time * 0.4*0.2"
			  ],
				"scale": [ 1, 1 ]
			},
			"overlay_color" : {
				"r": "1.0",
				"g": "1.0",
				"b": "1.0",
				"a": "0.0"
				},
			"ignore_lighting": true
		  },
		  "controller.render.mutant_enderman_screech": {
			"geometry": "Geometry.layer",
	  
			"materials": [ { "*": "Material.armor" } ],
			"textures": [ "Texture.armor" ],
			"overlay_color": {
			  "r": 1.0,
			  "g": 1.0,
			  "b": 1.0,
			  "a": 1.0
		  },
			"part_visibility": [ { "*": "query.is_roaring" } ],
			"uv_anim": {
			  "offset": [
				"(query.is_roaring ? (Math.cos(query.life_time * 10.1) * 2) : 0.0)",
				"(query.is_roaring ? (Math.cos (query.life_time * 11.62) * 2) : 0.0)"
			  ],
				"scale": [ 1, 1 ]
			},
			"light_color_multiplier": 0.55,
			"ignore_lighting": true
		  }
	}
}