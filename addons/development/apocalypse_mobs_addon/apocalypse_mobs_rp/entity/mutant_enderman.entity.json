{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "apoc_boss:mutant_enderman",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/enderman/mutant_enderman"
      },
      "geometry": {
        "default": "geometry.mutant_enderman"
      },
      "animations": {
        "idle": "animation.menderman.general",
        "walk": "animation.menderman.walk",
        "attack": "animation.menderman.attack",
        "look_at_target": "animation.menderman.look_at_target"
      },
      "render_controllers": [
        "controller.render.apoc.default"
      ],
      "enable_attachables": true,
      "spawn_egg": {
        "texture": "egg_mutant_enderman"
      },
      "scripts": {
        "animate": [
          "idle",
          {
            "walk": "query.modified_move_speed > 0.01"
          },
          {
            "attack": "query.is_swinging_arm"
          },
          "look_at_target"
        ]
      }
    }
  }
}
