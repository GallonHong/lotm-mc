{
	"format_version": "1.8.0",
	"render_controllers": {
    "controller.render.mutant_zombie": {
		"is_hurt_color": {
			"r": 1,
			"g": 0,
			"b": 0,
			"a": "(query.is_alive * 0.6)+(!query.is_alive * 0.6)"
		},
		"overlay_color": {
		"r": "(query.is_stunned * 1)",
		"g": 0,
		"b": 0,
		"a": "(query.is_stunned * 0.6)"
		  },
        "arrays": {
			
        "geometries": {
          "Array.geos": [ "Geometry.default", "Geometry.zombie_villager", "Geometry.aris" ]
        },
				"textures": {
					"Array.skins": [
						"Texture.default",
						"Texture.zombie_villager",
						"Texture.aris"
					]
				}
			},
		
      "geometry": "Array.geos[query.variant]",
			"materials": [{
				"*": "Material.default"
			}],
			"textures": ["Array.skins[query.variant]"]
		}
	}
}