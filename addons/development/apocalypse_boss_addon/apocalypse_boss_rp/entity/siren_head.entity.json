{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "apoc_boss:siren_head",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/apoc_diag/siren_head_default"
      },
      "geometry": {
        "default": "geometry.apoc_diag.siren_head"
      },
      "render_controllers": [
        "controller.render.apoc_diag.body"
      ],
      "spawn_egg": {
        "base_color": "#26292D",
        "overlay_color": "#913026"
      },
      "animations": {
        "idle": "animation.apoc_diag.siren_head.idle",
        "walk": "animation.apoc_diag.siren_head.walk",
        "run": "animation.apoc_diag.siren_head.run",
        "smash": "animation.apoc_diag.siren_head.smash",
        "scream": "animation.apoc_diag.siren_head.scream",
        "stomp": "animation.apoc_diag.siren_head.stomp",
        "death": "animation.apoc_diag.siren_head.death"
      },
      "scripts": {
        "scale": "1.2",
        "animate": [
          {
            "idle": "query.modified_move_speed <= 0.05"
          },
          {
            "walk": "query.modified_move_speed > 0.05 && query.modified_move_speed < 0.75"
          },
          {
            "run": "query.modified_move_speed >= 0.75"
          },
          {
            "smash": "variable.attack_time > 0.0"
          }
        ]
      }
    }
  }
}
