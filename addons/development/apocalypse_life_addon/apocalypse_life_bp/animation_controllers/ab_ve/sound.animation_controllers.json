{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.ab_ve.sound_controller.vehicle": {
            "states": {
                "default": {
                    "transitions": [
                        {
                            "idle": "query.has_rider"
                        }
                    ],
                    "on_exit": [
                        "/playsound ab_ve.cars.enter @a ~~~ 1 1 0.01"
                    ]
                },
                "idle": {
                    "transitions": [
                        {
                            "startup": "query.ground_speed > 0.5 && query.has_rider"
                        },
                        {
                            "exiting": "!query.has_rider"
                        }
                    ],
                    "animations": [
                        "idle_sound_animation",
                        "stop_engine_sound_animation"
                    ]
                },
                "startup": {
                    "transitions": [
                        {
                            "moving": "query.ground_speed > 0.5 && query.has_rider"
                        },
                        {
                            "exiting": "!query.has_rider"
                        }
                    ],
                    "on_entry": [
                        "/playsound ab_ve.cars.startup @a ~~~ 1 1 0.01"
                    ]
                },
                "moving": {
                    "transitions": [
                        {
                            "idle": "query.ground_speed < 0.5 && query.has_rider"
                        },
                        {
                            "exiting": "!query.has_rider"
                        }
                    ],
                    "animations": [
                        "engine_sound_animation",
                        "stop_idle_sound_animation"
                    ],
                    "on_exit": [
                        "/playsound ab_ve.cars.stop @a ~~~ 1 1 0.01"
                    ]
                },
                "exiting": {
                    "transitions": [
                        {
                            "default": "query.has_rider"
                        }
                    ],
                    "animations": [
                        "stop_engine_sound_animation",
                        "stop_idle_sound_animation"
                    ],
                    "on_entry": [
                        "/playsound ab_ve.cars.exit @a ~~~ 1 1 0.01"
                    ]
                }
            }
        },
