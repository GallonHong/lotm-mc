{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.makercamp_dr.laser_drone.shoot": {
			"states": {
				"default": {
					"animations": [
						"laser_hide"
					],
					"transitions": [
						{
							"laser_start": "v.is_shooting"
						}
					],
					"blend_via_shortest_path": true
				},
				"laser_start": {
					"animations": [
						"laser_start",
						{
							"sound.beam.start": "!v.is_controlled_by_player"
						},
						{
							"sound.beam.start.controlled": "v.is_controlled_by_player"
						}
					],
					"transitions": [
						{
							"laser_loop": "q.any_animation_finished"
						}
					]
				},
				"laser_loop": {
					"on_entry": [
						"v.cooldown = q.life_time + 0.1;"
					],
					"animations": [
						"laser_loop",
						{
							"sound.beam": "!v.is_controlled_by_player"
						},
						{
							"sound.beam.controlled": "v.is_controlled_by_player"
						}
					],
					"transitions": [
						{
							"laser_end": "!v.is_shooting"
						}
					]
				},
				"laser_end": {
					"animations": [
						"laser_end"
					],
					"transitions": [
						{
							"default": "q.all_animations_finished"
						},
						{
							"laser_start": "v.is_shooting"
						}
					]
				}
			}
		},
		"controller.animation.makercamp_dr.laser_drone.aim": {
			"states": {
				"default": {
					"transitions": [
						{
							"aim": "q.has_target || (v.active_state && v.is_shooting)"
						}
					],
					"blend_transition": 0.4
				},
				"aim": {
					"animations": [
						"laser_aim"
					],
					"transitions": [
						{
							"stop_aim": "!q.has_target || (v.active_state && !v.is_shooting)"
						}
					],
					"on_exit": [
						"v.target_x_rotation = query.target_x_rotation;",
						"v.target_y_rotation = query.target_y_rotation;"
					],
					"blend_transition": 0.1
				},
				"stop_aim": {
					"animations": [
						"laser_aim_last"
					],
					"on_entry": [
						"v.delay = q.life_time + 0.8;"
					],
					"transitions": [
						{
							"aim": "q.has_target || (v.active_state && v.is_shooting)"
						},
						{
							"default": "!q.has_target && v.delay < q.life_time"
						}
					],
					"blend_transition": 0.2
				}
			}
		}
	}
}