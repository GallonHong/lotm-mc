{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.makercamp_dr.mob_transporer.shoot": {
			"states": {
				"default": {
					"animations": [
						"hide_beam"
					],
					"transitions": [
						{
							"beam_start": "v.is_shooting"
						}
					],
					"blend_via_shortest_path": true
				},
				"beam_start": {
					"animations": [
						"beam_start"
					],
					"transitions": [
						{
							"beam_loop": "q.all_animations_finished"
						}
					]
				},
				"beam_loop": {
					"animations": [
						"beam_hold"
					],
					"transitions": [
						{
							"beam_end": "!v.is_shooting"
						}
					]
				},
				"beam_end": {
					"animations": [
						"beam_end"
					],
					"transitions": [
						{
							"default": "q.all_animations_finished"
						},
						{
							"beam_start": "v.is_shooting"
						}
					]
				}
			}
		}
	}
}