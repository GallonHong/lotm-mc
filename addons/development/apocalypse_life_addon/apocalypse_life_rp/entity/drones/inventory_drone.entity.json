{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "makercamp_dr:inventory_drone",
			"materials": {
				"default": "entity_alphatest",
				"blend": "entity_alphablend",
				"customblend": "makercamp_dr_customblend",
				"emissive": "entity_emissive_alpha"
			},
			"textures": {
				"default": "textures/makercamp/dr/entity/inventory_drone"
