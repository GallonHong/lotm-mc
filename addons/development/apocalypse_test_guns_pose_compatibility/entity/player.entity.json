      "render_controllers": [
        {
          "controller.render.player.first_person": "variable.is_first_person && !variable.is_holding_gun && !variable.tg3d_shield_main && !variable.tg3d_shield_off"
        },
        {
          "controller.render.tg3d.player_hands": "variable.is_first_person && !query.is_spectator && (variable.is_holding_gun || variable.tg3d_shield_main || variable.tg3d_shield_off)"
        },
        {
