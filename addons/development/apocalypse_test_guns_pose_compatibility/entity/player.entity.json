          "variable.is_holding_gun = query.is_alive ? (variable.is_holding_rifle || variable.is_holding_pistol) : 0.0;",
          "variable.scope_visible = query.is_alive ? (variable.is_holding_gun && query.is_sneaking && variable.is_first_person && query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:m82','test_gun:svd')) : 0.0;",
          "variable.tg3d_shield_main = query.is_item_name_any('slot.weapon.mainhand', 0, 'test_gun:riot_shield', 'test_gun:flash_shield');",
          "variable.tg3d_shield_off = query.is_item_name_any('slot.weapon.offhand', 0, 'test_gun:riot_shield', 'test_gun:flash_shield');",
          "variable.tg3d_free_offhand = query.get_equipped_item_name('off_hand') == '';",
          "variable.tg3d_hand_valid = variable.is_holding_gun && query.life_time >= variable.tg3d_stamp && query.life_time - variable.tg3d_stamp < 0.3;",
          "variable.tg3d_hand_reload = variable.tg3d_hand_valid && variable.tg3d_kind == 2 ? math.sin(math.clamp(variable.tg3d_progress,0,1) * 180) : 0;",
          "variable.tg3d_hand_kick = variable.tg3d_hand_valid && variable.tg3d_kind == 1 ? math.clamp(math.min(variable.tg3d_progress / 0.2, (1-variable.tg3d_progress) / 0.8),0,1) : 0;",
          "variable.tg3d_hand_aim = variable.tg3d_hand_aim + ((variable.is_holding_gun && query.is_sneaking && !(variable.tg3d_hand_valid && variable.tg3d_kind == 2) ? 1 : 0) - variable.tg3d_hand_aim) * math.clamp(query.delta_time * 16, 0, 1);",
          "variable.tg3d_hand_run = variable.tg3d_hand_run + ((variable.is_holding_gun && query.is_sprinting && !query.is_sneaking && !query.is_using_item && !(variable.tg3d_hand_valid && variable.tg3d_kind == 2) ? 1 : 0) - variable.tg3d_hand_run) * math.clamp(query.delta_time * 12, 0, 1);",
          "variable.tg3d_guard = variable.tg3d_guard + ((query.is_sneaking ? 1 : 0) - variable.tg3d_guard) * math.clamp(query.delta_time * 12,0,1);",
          "variable.tg3d_view_aim_x = query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:usas12') ? 5.0 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:m82') ? 5.0 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:m79') ? 5.0 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:m1897') ? 5.0 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:deagle') ? 5.0 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:rpk') ? 5.0 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:m1014') ? 5.0 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:ak47') ? 5.0 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:scarh') ? 5.0 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:glock') ? 5.0 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:bizon') ? 5.0 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:rpg') ? 5.0 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:p90') ? 5.0 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:m1014_ward') ? 5.0 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:vector') ? 2.5 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:arx') ? 5.0 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:svd') ? 5.0 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:ak47_commander') ? 5.0 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:pkm') ? 5.0 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:shotgun') ? 5.0 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:arc_emitter') ? 5.0 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:mgl') ? 5.0 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:dbss') ? 5.0 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:ak74u') ? 5.0 : 0;",
          "variable.tg3d_view_aim_y = query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:usas12') ? -0.09 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:m82') ? 0.31 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:m79') ? 0.01 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:m1897') ? 2.785 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:deagle') ? 0.81 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:rpk') ? 0.81 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:m1014') ? 2.785 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:ak47') ? 0.81 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:scarh') ? -0.89 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:glock') ? 0.335 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:bizon') ? 1.41 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:rpg') ? 1.41 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:p90') ? -0.94 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:m1014_ward') ? 2.785 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:vector') ? 0.5 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:arx') ? -0.565 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:svd') ? 0.935 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:ak47_commander') ? -0.848404 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:pkm') ? -0.506524 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:shotgun') ? 2.785 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:arc_emitter') ? 0.385 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:mgl') ? -0.54 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:dbss') ? 2.41 : query.is_item_name_any('slot.weapon.mainhand',0,'test_gun:ak74u') ? 0.31 : 0;"
        ],
