{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ab_ve:heal_aura_2",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/asiagobagels/vehicles/particle/particles_"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 25,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"offset": ["6 * math.cos(120 * math.pi * variable.emitter_age / variable.emitter_lifetime)", 0.2, "6 * math.sin(120* math.pi * variable.emitter_age / variable.emitter_lifetime)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 3
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)",
				"rotation_rate": "v.particle_random_1*5"
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, "v.particle_random_1*0.2", 0],
				"linear_drag_coefficient": 1
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.2, 0.2],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [15, 48],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FF1D2B34",
						"0.17": "#FF39FA9D"
					}
				}
			}
		}
	}
}