{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "vxg:bullet_hit_spark",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.height=0.025;v.width=0.025;v.acceleration=3;"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": "v.count"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.12
			},
			"minecraft:emitter_shape_point": {
				"direction": [
					"v.dir.x+math.random(-v.rand,v.rand)",
					"v.dir.y+math.random(-v.rand,v.rand)",
					"v.dir.z+math.random(-v.rand,v.rand)"
				]
			},
			"minecraft:particle_initialization": {
				"per_update_expression": "v.life_ratio=v.particle_age/v.particle_lifetime;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.3,0.35)"
			},
			"minecraft:particle_expire_if_in_blocks": [
				"minecraft:water",
				"minecraft:flowing_water"
			],
			"minecraft:particle_initial_spin": {
				"rotation": 0
			},
			"minecraft:particle_initial_speed": "math.random(1,8)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					"math.random(v.acceleration/2,v.acceleration)",
					"math.random(v.acceleration/2,v.acceleration)",
					"math.random(v.acceleration/2,v.acceleration)"
				],
				"linear_drag_coefficient": 0.3
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"v.width",
					"v.height"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [
							42,
							82
						],
						"size_UV": [
							4,
							4
						],
						"step_UV": [
							-8,
							0
						],
						"frames_per_second": 4,
						"max_frame": 4,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_motion_collision": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFEE5",
						"0.42": "#F2FFDA3A",
						"0.76": "#B0F19200",
						"0.86": "#75FF5F00",
						"1.0": "#2B360000"
					}
				}
			}
		}
	}
}