{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "vxg:bullet_hit_smoke",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.size=math.random(0.08,0.1);v.count=8;"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": "v.count"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.12
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_initialization": {
				"per_update_expression": "v.life_ratio=v.particle_age/v.particle_lifetime;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.3,0.4)"
			},
			"minecraft:particle_expire_if_in_blocks": [
				"minecraft:water",
				"minecraft:flowing_water"
			],
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0,180)"
			},
			"minecraft:particle_initial_speed": "math.random(1,2)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					"math.random(-0.5,0.5)",
					"math.random(0.5,1)",
					"math.random(-0.5,0.5)"
				],
				"linear_drag_coefficient": 2.6
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"v.size+(v.life_ratio*0.4)",
					"v.size+(v.life_ratio*0.4)"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [
							32,
							72
						],
						"size_UV": [
							8,
							8
						],
						"step_UV": [
							-8,
							0
						],
						"frames_per_second": 4,
						"max_frame": 4,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.05": "#F2FFF219",
						"0.06": "#F0F56A00",
						"0.08": "#80444444",
						"1.0": "#1C5E5E5E"
					}
				}
			}
		}
	}
}