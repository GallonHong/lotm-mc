{
	"format_version": "1.10.0",
	"render_controllers": {
		"controller.render.hkc.first_person": {
			"textures": [
				"texture.default"
			],
			"geometry": "geometry.aug_fpp",
			"materials": [
				{
					"*": "material.scope"
				},
				{
					"leftArm": "material.default"
				},
				{
					"rightArm": "material.default"
				}
			],
			"part_visibility": [
				{
					"*": true
				},
				{
					"rightArm": "query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'map' || v.hkc_gun"
				},
				{
					"rightSleeve": "query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'map' || v.hkc_gun"
				},
				{
					"leftArm": "(query.get_equipped_item_name(0, 1) == 'map' && query.get_equipped_item_name('off_hand') != 'shield') || (query.get_equipped_item_name('off_hand') == 'map' && !query.item_is_charged) || (!query.item_is_charged && (variable.item_use_normalized > 0 && variable.item_use_normalized < 1.0)) || v.hkc_gun"
				},
				{
					"leftSleeve": "(query.get_equipped_item_name(0, 1) == 'map' && query.get_equipped_item_name('off_hand') != 'shield') || (query.get_equipped_item_name('off_hand') == 'map' && !query.item_is_charged) || (!query.item_is_charged && (variable.item_use_normalized > 0 && variable.item_use_normalized < 1.0)) || v.hkc_gun"
				}
			]
		},
