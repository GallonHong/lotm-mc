			"scripts": {
				"scale": "0.9375",
				"initialize": [
					"variable.is_holding_right = 0.0;",
					"variable.is_blinking = 0.0;",
					"variable.last_blink_time = 0.0;",
					"variable.hand_bob = 0.0;"
				],
				"pre_animation": [
					"variable.is_third_person = (!variable.is_first_person && !variable.map_face_icon && !variable.is_paperdoll);",
					"variable.helmet_layer_visible = !query.has_head_gear;",
					"variable.leg_layer_visible = 1.0;",
					"variable.boot_layer_visible = 1.0;",
					"variable.chest_layer_visible = 1.0;",
					"variable.attack_body_rot_y = Math.sin(360*Math.sqrt(variable.attack_time)) * 5.0;",
					"variable.tcos0 = (math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
					"variable.first_person_rotation_factor = math.sin((1 - variable.attack_time) * 180.0);",
					"variable.first_person_item_rotation_factor = math.sin((1 - variable.attack_time) * 180.0);",
					"variable.hand_bob = query.life_time < 0.01 ? 0.0 : variable.hand_bob + ((query.is_on_ground && query.is_alive ? math.clamp(math.sqrt(math.pow(query.position_delta(0), 2.0) + math.pow(query.position_delta(2), 2.0)), 0.0, 0.1) : 0.0) - variable.hand_bob) * 0.02;",
					"variable.map_angle = math.clamp(1 - variable.player_x_rotation / 45.1, 0.0, 1.0);",
					"variable.item_use_normalized = query.main_hand_item_use_duration / query.main_hand_item_max_duration;",
					"variable.riding_y_offset = query.is_riding_any_entity_of_type('minecraft:minecart', 'minecraft:boat', 'minecraft:chest_boat', 'minecraft:strider') ? -3.0 : 0.0;",
					"variable.equip_gun = !v.is_paperdoll ? query.mark_variant != 0;",
					"variable.ram_loot = !v.is_paperdoll ? query.mark_variant == 8;",
					"variable.dvd_loot = !v.is_paperdoll ? query.mark_variant == 9;",
					"variable.router_loot = !v.is_paperdoll ? query.mark_variant == 11;",
					"variable.tank_loot = !v.is_paperdoll ? query.mark_variant == 12;",
					"variable.glock_gun = !v.is_paperdoll ? query.mark_variant == 10;",
					"variable.glock_refresh = !v.is_paperdoll ? !query.mark_variant == 10 && q.property('hengker:reload') != 'n';",
					"variable.glock_slot = !v.is_paperdoll ? query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock') && query.property('hengker:reload') == 'heal' && !query.is_sneaking;",
					"variable.colt_gun = !v.is_paperdoll ? query.mark_variant == 13;",
					"variable.colt_refresh = !v.is_paperdoll ? !query.mark_variant == 13 && q.property('hengker:reload') != 'n';",
					"variable.colt_slot = !v.is_paperdoll ? query.is_item_name_any('slot.weapon.mainhand',0,'hengker:colt') && query.property('hengker:reload') == 'heal' && !query.is_sneaking;",
					"variable.mosin_gun = !v.is_paperdoll ? query.mark_variant == 7;",
					"variable.mosin_refresh = !v.is_paperdoll ? !query.mark_variant == 7 && q.property('hengker:reload') != 'n';",
					"variable.mosin_slot = !v.is_paperdoll ? query.is_item_name_any('slot.weapon.mainhand',0,'hengker:mosin') && query.property('hengker:reload') == 'heal' && !query.is_sneaking;",
					"variable.scar_gun = !v.is_paperdoll ? query.mark_variant == 2;",
					"variable.scar_refresh = !v.is_paperdoll ? !query.mark_variant == 2 && q.property('hengker:reload') != 'n';",
					"variable.scar_slot = !v.is_paperdoll ? query.is_item_name_any('slot.weapon.mainhand',0,'hengker:scar') && query.property('hengker:reload') == 'heal' && !query.is_sneaking;",
					"variable.hkc_gun = !v.is_paperdoll ? query.mark_variant == 6;",
					"variable.hkc_refresh = !v.is_paperdoll ? !query.mark_variant == 6 && q.property('hengker:reload') != 'n';",
					"variable.hkc_slot = !v.is_paperdoll ? query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hkc') && query.property('hengker:reload') == 'heal' && !query.is_sneaking;",
					"variable.hb_gun = !v.is_paperdoll ? query.mark_variant == 5;",
					"variable.hb_refresh = !v.is_paperdoll ? !query.mark_variant == 5 && q.property('hengker:reload') != 'n';",
					"variable.hb_slot = !v.is_paperdoll ? query.is_item_name_any('slot.weapon.mainhand',0,'hengker:hb') && query.property('hengker:reload') == 'heal' && !query.is_sneaking;",
					"variable.barret_gun = !v.is_paperdoll ? query.mark_variant == 4;",
					"variable.barret_refresh = !v.is_paperdoll ? !query.mark_variant == 4 && q.property('hengker:reload') != 'n';",
					"variable.barret_slot = !v.is_paperdoll ? query.is_item_name_any('slot.weapon.mainhand',0,'hengker:barret') && query.property('hengker:reload') == 'heal' && !query.is_sneaking;",
					"variable.tactile_gun = !v.is_paperdoll ? query.mark_variant == 3;",
					"variable.tactile_refresh = !v.is_paperdoll ? !query.mark_variant == 3 && q.property('hengker:reload') != 'n';",
					"variable.tactile_slot = !v.is_paperdoll ? query.is_item_name_any('slot.weapon.mainhand',0,'hengker:tactile') && query.property('hengker:reload') == 'heal' && !query.is_sneaking;",
					"variable.flashlight_gun = v.glock_gun || v.scar_gun || v.hb_gun || v.hkc_gun || v.colt_gun;",
					"variable.equip_rifle = v.scar_gun || v.hb_gun || v.hkc_gun;",
					"variable.advanced_vest = query.equipped_item_any_tag('slot.armor.chest', 'advanced_vest');",
					"variable.hazmat_vest = query.equipped_item_any_tag('slot.armor.chest', 'hazmat_suit');",
					"variable.green_vision = query.equipped_item_any_tag('slot.armor.head', 'green_vision');",
					"variable.backpack = query.is_item_name_any('slot.hotbar',0,'hengker:backpack');",
					"variable.backpack_open = query.is_item_name_any('slot.hotbar',0,'hengker:backpack_open');"
				],
