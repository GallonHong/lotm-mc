{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.glock": {
			"initial_state": "default",
			"states": {
				"default": {
					"on_entry": [],
					"transitions": [
						{
							"draw": "q.mark_variant==0&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')"
						},
						{
							"preshoot": "q.mark_variant==10&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')"
						},
						{
							"unequip": "q.mark_variant==10&&!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')"
						}
					],
					"on_exit": [
						"/hud @s hide crosshair",
						"/event entity @s equip:glock"
					]
				},
				"draw": {
					"on_entry": [
						"/tag add @s cooldown"
					],
					"animations": [
						"glock_draw"
					],
					"transitions": [
						{
							"preshoot": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')&&q.all_animations_finished"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')&&q.all_animations_finished"
						}
					]
				},
				"unequip": {
					"on_entry": [
						"/tag @s add cooldown"
					],
					"animations": [
						"glock_unequip"
					],
					"transitions": [
						{
							"default": "query.all_animations_finished"
						}
					],
					"on_exit": [
						"/event entity @s mk556:laser_off",
						"/tag @s remove cooldown",
						"/hud @s reset crosshair"
					]
				},
				"preshoot": {
					"transitions": [
						{
							"shoot": "!q.is_sprinting&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')&&q.main_hand_item_use_duration&&q.scoreboard('glock')>0&&!q.is_sneaking&&q.property('hengker:reload')=='n'&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')"
						},
						{
							"aim": "!q.is_sprinting&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')&&q.main_hand_item_use_duration&&q.scoreboard('glock')>0&&q.is_sneaking&&q.property('hengker:reload')=='n'&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')"
						},
						{
							"check": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')&&q.property('hengker:reload')=='check'&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')"
						},
						{
							"display": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')&&query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')&&q.property('hengker:reload')=='heal'"
						}
					]
				},
				"check": {
					"animations": [
						"glock_check"
					],
					"transitions": [
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')"
						},
						{
							"preshoot": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')&&q.all_animations_finished"
						}
					],
					"on_exit": [
						"/event entity @s hengker:rilotend"
					]
				},
				"display": {
					"on_entry": [
						"/event entity @s hengker:attachment"
					],
					"transitions": [
						{
							"preshoot": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')&&(q.is_sneaking||q.property('hengker:reload')!='heal')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')"
						}
					],
					"on_exit": [
						"/event entity @s hengker:rilotend",
						"/event entity @s gun:display"
					]
				},
				"shoot": {
					"animations": [
						"glock_shoot"
					],
					"on_entry": [
						"/camerashake add @s[tag=!cooldown,scores={glock=2..}] 0.055 0.075 rotational"
					],
					"transitions": [
						{
							"preshoot": "(q.all_animations_finished||!q.is_alive)&&!q.is_using_item"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')"
						}
					]
				},
				"aim": {
					"animations": [
						"glock_aim"
					],
					"on_entry": [
						"/camerashake add @s[tag=!cooldown,scores={glock=2..}] 0.055 0.075 rotational"
					],
					"transitions": [
						{
							"preshoot": "(q.all_animations_finished||!q.is_alive)&&!q.is_using_item"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')"
						}
					]
				}
			}
		},
		"controller.animation.glock.muzzle": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": [
						"cooldown"
					],
					"transitions": [
						{
							"muzzle3": "query.property('hengker:reload')=='heal'&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')&&q.is_using_item&&q.variant==1"
						}
					],
					"on_exit": [
						"/event entity @s[m=c] mk556:silencer",
						"/tag @s[m=c] add glock_silencer",
						"/playsound muzzle.general @s[m=c]",
						"/tag @s[m=c] remove glock_brake"
					]
				},
				"muzzle3": {
					"animations": [
						"cooldown"
					],
					"transitions": [
						{
							"sek_sabar": "query.property('hengker:reload')=='heal'&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')&&q.is_using_item&&q.variant==1&&q.all_animations_finished"
						}
					],
					"on_exit": [
						"/event entity @s[m=c] mk556:muzzle",
						"/playsound muzzle.general @s[m=c]",
						"/tag @s[m=c] remove glock_silencer"
					]
				},
				"sek_sabar": {
					"animations": [
						"cooldown"
					],
					"transitions": [
						{
							"default": "query.all_animations_finished"
						}
					]
				}
			}
		},
		"controller.animation.glock.scope": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": [
						"cooldown"
					],
					"transitions": [
						{
							"scope6": "query.property('hengker:reload')=='heal'&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')&&q.is_using_item&&q.variant==3"
						}
					],
					"on_exit": [
						"/event entity @s[m=c] mk556:reddot",
						"/tag @s[m=c] add glockreddot",
						"/playsound scope.general @s[m=c]"
					]
				},
				"scope6": {
					"animations": [
						"cooldown"
					],
					"transitions": [
						{
							"sek_sabar": "query.property('hengker:reload')=='heal'&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')&&q.is_using_item&&q.variant==3&&q.all_animations_finished"
						}
					],
					"on_exit": [
						"/event entity @s[m=c] mk556:sight",
						"/tag @s[m=c] remove glockreddot",
						"/playsound scope.general @s[m=c]"
					]
				},
				"sek_sabar": {
					"animations": [
						"cooldown"
					],
					"transitions": [
						{
							"default": "query.all_animations_finished"
						}
					]
				}
			}
		},
		"controller.animation.glockinspect": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"inspect": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')&&q.property('hengker:reload')=='inspect'"
						}
					],
					"on_exit": [
						"/tag @s add cooldown"
					]
				},
				"inspect": {
					"animations": [
						"glock_inspect_empty"
					],
					"transitions": [
						{
							"default": "query.all_animations_finished||!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')||q.is_using_item"
						}
					],
					"on_exit": [
						"/tag @s remove cooldown",
						"/stopsound @s",
						"/event entity @s hengker:rilotend"
					]
				}
			}
		},
		"controller.animation.glock.sneak": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"sneak": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')&&q.is_sneaking&&query.property('mk556:scope')=='n'&&q.property('hengker:reload')=='n'"
						},
						{
							"holo": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')&&q.is_sneaking&&(query.property('mk556:scope')=='holo'||query.property('mk556:scope')=='reddot')&&q.property('hengker:reload')=='n'"
						}
					],
					"on_exit": [
						"/hud @s hide status_effects",
						"/effect @s speed infinite 7 true"
					]
				},
				"sneak": {
					"on_entry": [
						"/effect @s slowness infinite 0 true"
					],
					"transitions": [
						{
							"default": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')||!q.is_sneaking||q.property('hengker:reload')!='n'"
						}
					],
					"on_exit": [
						"/hud @s reset status_effects",
						"/effect @s speed 0 0 true",
						"/effect @s slowness 0 0 true"
					]
				},
				"holo": {
					"on_entry": [
						"/effect @s slowness infinite 1 true"
					],
					"transitions": [
						{
							"default": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')||!q.is_sneaking||q.property('hengker:reload')!='n'"
						}
					],
					"on_exit": [
						"/hud @s reset status_effects",
						"/effect @s speed 0 0 true",
						"/effect @s slowness 0 0 true"
					]
				}
			}
		},
		"controller.animation.glockreload": {
			"initial_state": "prereload",
			"states": {
				"prereload": {
					"transitions": [
						{
							"reload": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')&&q.scoreboard('glock')<1&&q.is_using_item&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')&&q.property('hengker:nomag')=='gaada'"
						}
					]
				},
				"fail": {
					"on_entry": [
						"/event entity @s hengker:rilotend",
						"/execute as @s run scriptevent hengker:glock_changemag",
						"/event entity @s hengker:nomag",
						"/tag @s add glocknomag",
						"/stopsound @s"
					],
					"transitions": [
						{
							"prereload": "1"
						}
					]
				},
				"reload": {
					"on_entry": [
						"/execute as @s[tag=!cooldown] run scriptevent hengker:glock_reload",
						"/execute as @s[tag=!cooldown] run tag @s[scores={glock=1..}] remove glocknomag",
						"/execute as @s[tag=!cooldown] run event entity @s[scores={glock=1..}] hengker:mag",
						"/execute as @s[tag=!cooldown] run event entity @s[hasitem={item=bridge:glock_mag,quantity=1..}] hengker:rilot",
						"/execute as @s[tag=!cooldown] run event entity @s[hasitem={item=bridge:glock_mag_extended,quantity=1..}] hengker:rilot",
						"variable.ngentot2=query.life_time;"
					],
					"transitions": [
						{
							"reloading": "q.scoreboard('glock')>0&&q.property('hengker:reload')=='reload'&&q.property('mk556:mag')=='n'&&q.is_alive"
						},
						{
							"reloading_extended": "q.scoreboard('glock')>0&&q.property('hengker:reload')=='reload'&&q.property('mk556:mag')=='extended'&&q.is_alive"
						},
						{
							"fail": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')||(q.property('hengker:reload')!='reload'&&(query.life_time-variable.ngentot2)>=0.25)"
						}
					]
				},
				"reloading": {
					"animations": [
						"glock_reload"
					],
					"transitions": [
						{
							"done": "q.all_animations_finished&&q.is_alive"
						},
						{
							"fail": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')||!q.is_alive||q.property('hengker:reload')=='hit'"
						}
					]
				},
				"reloading_extended": {
					"animations": [
						"glock_reload_extended"
					],
					"transitions": [
						{
							"done": "q.all_animations_finished&&q.is_alive"
						},
						{
							"fail": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')||!q.is_alive||q.property('hengker:reload')=='hit'"
						}
					]
				},
				"done": {
					"on_exit": [
						"/event entity @s hengker:rilotend",
						"/tag @s remove glocknomag",
						"/stopsound @s"
					],
					"transitions": [
						{
							"prereload": "1"
						}
					]
				}
			}
		},
		"controller.animation.glockchangemag": {
			"initial_state": "default",
			"states": {
				"default": {
					"on_entry": [
						"/stopsound @s"
					],
					"transitions": [
						{
							"isi_peluru": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')&&q.property('hengker:reload')=='change'"
						}
					]
				},
				"gagal": {
					"on_entry": [
						"/stopsound @s",
						"/event entity @s hengker:rilotend"
					],
					"transitions": [
						{
							"default": "1"
						}
					]
				},
				"isi_peluru": {
					"on_entry": [
						"variable.ngentot=query.life_time;",
						"/event entity @s[tag=!cooldown] hengker:rilotchange"
					],
					"transitions": [
						{
							"mengisi_peluru": "1"
						}
					]
				},
				"mengisi_peluru": {
					"animations": [
						"glock_changemag"
					],
					"transitions": [
						{
							"gagal": "query.get_equipped_item_name('main_hand')!='glock'||q.property('hengker:reload')!='change'"
						},
						{
							"selesai30": "q.is_alive&&(query.life_time-variable.ngentot)>=2.05"
						}
					]
				},
				"selesai30": {
					"on_entry": [
						"/event entity @s hengker:nomag",
						"/tag @s[tag=!glocknomag] add glocknomag",
						"/event entity @s hengker:rilotend",
						"/execute as @s run scriptevent hengker:glock_changemag"
					],
					"transitions": [
						{
							"default": "1"
						}
					]
				}
			}
		},
		"controller.animation.glock_show": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"glock_show": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')&&q.mark_variant==10"
						},
						{
							"attachment_show": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')&&query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')&&q.mark_variant==10"
						}
					]
				},
				"attachment_show": {
					"transitions": [
						{
							"default": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')"
						}
					],
					"on_entry": [
						"/title @s[tag=!cd] actionbar 您正处于附件模式 || // 到 §b交换 §r|| // to §6连接/分离",
						"/function glock_check"
					]
				},
				"glock_show": {
					"transitions": [
						{
							"default": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')"
						}
					],
					"on_entry": [
						"/execute at @s[hasitem={item=bridge:flashlight,location=slot.weapon.offhand}] positioned as @p run fill ^^2^0 ^^2^1 hengker:light replace air"
					]
				}
			}
		},
		"controller.animation.glock_scope": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"install": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')&&query.property('hengker:reload')=='heal'&&q.is_using_item&&q.variant==3"
						}
					]
				},
				"install": {
					"animations": [
						"cooldown"
					],
					"on_entry": [
						"/execute as @s[m=!c,tag=!glockreddot] run scriptevent hengker:glock_scope"
					],
					"transitions": [
						{
							"cooldown": "q.all_animations_finished&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')&&query.property('hengker:reload')=='heal'&&q.is_using_item&&q.variant==3"
						}
					],
					"on_exit": [
						"/execute as @s[m=!c] run scriptevent hengker:glock_scope_remove"
					]
				},
				"cooldown": {
					"animations": [
						"cooldown"
					],
					"transitions": [
						{
							"default": "query.all_animations_finished"
						}
					]
				}
			}
		},
		"controller.animation.glock_muzzle": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"install": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')&&query.property('hengker:reload')=='heal'&&q.is_using_item&&q.variant==1"
						}
					],
					"on_exit": [
						"/execute as @s[m=!c] run tag @s[hasitem={item=hengker:silencer,quantity=1..}] add glock_silencer",
						"/execute as @s[m=!c] run clear @s[tag=glock_silencer] hengker:silencer 0 1",
						"/playsound muzzle.general @s"
					]
				},
				"install": {
					"animations": [
						"cooldown"
					],
					"transitions": [
						{
							"cooldown": "q.all_animations_finished&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:glock')&&query.property('hengker:reload')=='heal'&&q.is_using_item&&q.variant==1"
						}
					],
					"on_exit": [
						"/give @s[m=!c,tag=glock_silencer] hengker:silencer",
						"/tag @s[m=!c,tag=glock_silencer] remove glock_silencer",
						"/playsound muzzle.general @s"
					]
				},
				"cooldown": {
					"animations": [
						"cooldown"
					],
					"transitions": [
						{
							"default": "query.all_animations_finished"
						}
					]
				}
			}
		}
	}
}