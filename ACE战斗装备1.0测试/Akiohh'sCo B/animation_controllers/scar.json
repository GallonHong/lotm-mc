{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.scar": {
			"initial_state": "default",
			"states": {
				"default": {
					"on_entry": [],
					"transitions": [
						{
							"draw": "q.mark_variant==0&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:scar')"
						},
						{
							"preshoot": "q.mark_variant==2&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:scar')"
						},
						{
							"unequip": "q.mark_variant==2&&!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:scar')"
						}
					],
					"on_exit": [
						"/hud @s hide crosshair",
						"/event entity @s equip:scar"
					]
				},
				"draw": {
					"on_entry": [
						"/tag add @s cooldown"
					],
					"animations": [
						"scar_draw"
					],
					"transitions": [
						{
							"preshoot": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:scar')&&q.all_animations_finished"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:scar')&&q.all_animations_finished"
						}
					]
				},
				"unequip": {
					"on_entry": [
						"/tag @s add cooldown"
					],
					"animations": [
						"scar_unequip"
					],
					"transitions": [
						{
							"default": "query.all_animations_finished"
						}
					],
					"on_exit": [
						"/event entity @s mk556:laser_off",
						"/tag @s remove cooldown",
						"/hud @s reset crosshair"
					]
				},
				"preshoot": {
					"transitions": [
						{
							"shoot": "q.property('mk556:grip')!='n'&&!q.is_sprinting&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:scar')&&q.main_hand_item_use_duration&&q.scoreboard('scar')>0&&!q.is_sneaking&&q.property('hengker:reload')=='n'&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')"
						},
						{
							"nogrip": "q.property('mk556:grip')=='n'&&!q.is_sprinting&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:scar')&&q.main_hand_item_use_duration&&q.scoreboard('scar')>0&&!q.is_sneaking&&q.property('hengker:reload')=='n'&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')"
						},
						{
							"aim": "!q.is_sprinting&&query.is_item_name_any('slot.weapon.mainhand',0,'hengker:scar')&&q.main_hand_item_use_duration&&q.scoreboard('scar')>0&&q.is_sneaking&&q.property('hengker:reload')=='n'&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')"
						},
						{
							"check": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:scar')&&q.property('hengker:reload')=='check'&&!query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:scar')"
						},
						{
							"display": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:scar')&&query.is_item_name_any('slot.hotbar',8,'hengker:lencana_polisi')&&q.property('hengker:reload')=='heal'"
						}
					]
				},
				"check": {
					"animations": [
						"scar_check"
					],
					"transitions": [
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:scar')"
						},
						{
							"preshoot": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:scar')&&q.all_animations_finished"
						}
					],
					"on_exit": [
						"/event entity @s hengker:rilotend"
					]
				},
				"display": {
					"on_entry": [
						"/event entity @s hengker:attachment"
					],
					"transitions": [
						{
							"preshoot": "query.is_item_name_any('slot.weapon.mainhand',0,'hengker:scar')&&(q.is_sneaking||q.property('hengker:reload')!='heal')"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:scar')"
						}
					],
					"on_exit": [
						"/event entity @s hengker:rilotend",
						"/event entity @s gun:display"
					]
				},
				"shoot": {
					"animations": [
						"scar_shoot"
					],
					"on_entry": [
						"/camerashake add @s[tag=!cooldown,scores={scar=2..}] 0.055 0.075 rotational"
					],
					"transitions": [
						{
							"preshoot": "q.all_animations_finished||!q.is_alive"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:scar')"
						}
					]
				},
				"nogrip": {
					"animations": [
						"scar_nguwawor"
					],
					"on_entry": [
						"/camerashake add @s[tag=!cooldown,scores={scar=2..}] 0.055 0.075 rotational"
					],
					"transitions": [
						{
							"preshoot": "q.all_animations_finished||!q.is_alive"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:scar')"
						}
					]
				},
				"aim": {
					"animations": [
						"scar_aim"
					],
					"on_entry": [
						"/camerashake add @s[tag=!cooldown,scores={scar=2..}] 0.055 0.075 rotational"
					],
					"transitions": [
						{
							"preshoot": "q.all_animations_finished||!q.is_alive"
						},
						{
							"unequip": "!query.is_item_name_any('slot.weapon.mainhand',0,'hengker:scar')"
						}
					]
				}
			}
		},
