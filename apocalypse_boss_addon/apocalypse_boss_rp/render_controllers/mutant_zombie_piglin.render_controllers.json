    "controller.render.zombified_mutant_piglin_weapon": {
			"is_hurt_color": {
				"r": 0,
				"g": 0,
				"b": 0,
				"a": "(query.is_alive * 0.0)+(!query.is_alive * 0.0)"
			},
			"on_fire_color": {
				"r": 0,
				"g": 0,
				"b": 0,
				"a": "(query.is_alive * 0.0)+(!query.is_alive * 0.0)"
			},
			"overlay_color": {
			"r": "(query.is_stunned * 0)",
			"g": 0,
			"b": 0,
			"a": "(query.is_stunned * 0.0)"
			  },
			  "textures": [ "Texture.default" ],
			  "geometry": "Geometry.default",
			  "materials": [{
				  "*": "Material.default"
			  }],
			"part_visibility": [ { "*": 0 }, { "rsword": 1 } ]
		  }
