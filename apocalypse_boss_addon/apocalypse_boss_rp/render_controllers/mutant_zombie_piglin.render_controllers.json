{
	"format_version": "1.8.0",
	"render_controllers": {
    "controller.render.zombified_mutant_piglin": {
      "is_hurt_color": {
        "r": 1,
        "g": 0,
        "b": 0,
        "a": "(query.is_alive * 0.6)+(!query.is_alive * 0.6)"
      },
      "overlay_color": {
      "r": "(query.is_stunned * 1)",
      "g": 0,
      "b": 0,
      "a": "(query.is_stunned * 0.6)"
        },
   
      "geometry": "Geometry.default",
      "materials": [ { "*": "Material.default" } ],
      "textures": [ "Texture.default" ],
			"part_visibility": [ { "*": 1 }, { "rsword": 0 } ]
