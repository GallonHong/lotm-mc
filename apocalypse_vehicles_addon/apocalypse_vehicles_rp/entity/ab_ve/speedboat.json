{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "ab_ve:speedboat",
      "materials": {
        "default": "entity_alphatest",
        "light": "entity_emissive_alpha",
        "cracks": "entity_alphablend"
      },
      "textures": {
        "white": "textures/asiagobagels/vehicles/entity/speedboat/white",
        "light_gray": "textures/asiagobagels/vehicles/entity/speedboat/light_gray",
        "gray": "textures/asiagobagels/vehicles/entity/speedboat/gray",
        "black": "textures/asiagobagels/vehicles/entity/speedboat/black",
        "brown": "textures/asiagobagels/vehicles/entity/speedboat/brown",
        "red": "textures/asiagobagels/vehicles/entity/speedboat/red",
        "orange": "textures/asiagobagels/vehicles/entity/speedboat/orange",
        "yellow": "textures/asiagobagels/vehicles/entity/speedboat/yellow",
        "lime": "textures/asiagobagels/vehicles/entity/speedboat/lime",
        "green": "textures/asiagobagels/vehicles/entity/speedboat/green",
        "cyan": "textures/asiagobagels/vehicles/entity/speedboat/cyan",
        "light_blue": "textures/asiagobagels/vehicles/entity/speedboat/light_blue",
        "blue": "textures/asiagobagels/vehicles/entity/speedboat/blue",
        "purple": "textures/asiagobagels/vehicles/entity/speedboat/purple",
        "magenta": "textures/asiagobagels/vehicles/entity/speedboat/magenta",
        "pink": "textures/asiagobagels/vehicles/entity/speedboat/pink",
        "crack_0": "textures/asiagobagels/vehicles/overlay/invisible",
        "crack_1": "textures/asiagobagels/vehicles/overlay/128/crack_0",
        "crack_2": "textures/asiagobagels/vehicles/overlay/128/crack_1",
        "crack_3": "textures/asiagobagels/vehicles/overlay/128/crack_2"
      },
      "geometry": {
        "default": "geometry.ab_ve.speedboat",
        "cracks": "geometry.ab_ve.crack.speedboat"
      },
      "animations": {
        "wheels": "animation.ab_ve.speedboat.steering",
        "speed_lines": "animation.ab_ve.speed_lines",
        "spawn": "animation.ab_ve.spawn",
        "spawning": "controller.animation.ab_ve.spawn_animation",
        "speed_lines_controller": "controller.animation.ab_ve.speed_lines"
      },
      "scripts": {
        "initialize": [
          "variable.speed = 0;",
          "variable.wheel_turns = Math.random(-80, 80);",
          "variable.shake_dir = 1;"
        ],
        "pre_animation": [
          "variable.speed = query.ground_speed;",
          "variable.wheel_turns = (variable.wheel_turns + query.yaw_speed) / 2;"
        ],
        "animate": [
          {
            "wheels": "query.modified_move_speed"
          },
          "spawning"
        ]
      },
      "render_controllers": [
        "controller.render.ab_ve.vehicles.color",
        "controller.render.ab_ve.vehicles.crack"
      ]
    }
  }
}