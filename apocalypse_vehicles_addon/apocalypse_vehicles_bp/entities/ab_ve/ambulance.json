                        0,
                        3
                    ],
                    "type": "int"
                },
                "ab_ve:light": {
                    "client_sync": true,
                    "default": false,
                    "type": "bool"
                }
            }
        },
        "component_groups": {
            "ab_ve:despawn": {
                "minecraft:instant_despawn": {}
            }
        },
        "components": {
