                "engine_sound_animation": "animation.ab_ve.start_engine.vehicle",
                "stop_idle_sound_animation": "animation.ab_ve.stop_idle.vehicle",
                "sound_controller": "controller.animation.ab_ve.sound_controller.vehicle",
                "sirene_controller": "controller.animation.ab_ve.sirene.ambulance",
                "sirene_sound": "animation.ab_ve.ambulance.sirene"
            },
            "scripts": {
                "animate": [
                    "sound_controller",
                    "sirene_controller"
                ]
            },
            "properties": {
                "ab_ve:max_speed": {
                    "client_sync": true,
                    "default": 0,
                    "range": [
                        0,
                        3
                    ],
                    "type": "int"
                },
                "ab_ve:acceleration": {
                    "client_sync": true,
