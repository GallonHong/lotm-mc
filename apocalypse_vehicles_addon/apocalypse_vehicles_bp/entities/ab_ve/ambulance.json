                    "range_min": 0
                }
            },
            "minecraft:conditional_bandwidth_optimization": {},
            "minecraft:damage_sensor": {
                "triggers": [
                    {
                        "on_damage": {
                            "filters": [
                                {
                                    "all_of": [
                                        {
                                            "test": "is_family",
                                            "subject": "damager",
                                            "value": "player"
                                        },
                                        {
                                            "test": "is_riding",
                                            "subject": "damager",
                                            "value": true
                                        }
                                    ]
                                }
                            ],
                            "target": "self",
                            "event": "ab_ve:toggle_headlights"
                        },
                        "deals_damage": false
                    }
                ]
            },
            "minecraft:interact": {
                "interactions": [
                    {
                        "on_interact": {
                            "filters": [
                                {
                                    "all_of": [
                                        {
                                            "test": "has_equipment",
                                            "domain": "hand",
                                            "subject": "other",
                                            "value": "ab_ve:wrench"
                                        },
                                        {
                                            "test": "is_family",
                                            "subject": "other",
                                            "value": "player"
                                        }
                                    ]
                                }
                            ],
                            "target": "self",
                            "event": "ab_ve:open_vehicle_menu"
                        },
                        "use_item": false
                    }
                ]
            }
        },
        "events": {
            "minecraft:entity_spawned": {},
            "ab_ve:remove_car": {
                "add": {
                    "component_groups": [
                        "ab_ve:despawn"
                    ]
                }
            },
            "ab_ve:open_vehicle_menu": {
                "queue_command": {
                    "command": "scriptevent ab_ve:vehicles.open_menu"
                }
            },
            "ab_ve:add_crack_state": {
                "queue_command": {
                    "command": "scriptevent ab_ve:vehicles.crack"
                }
            },
            "ab_ve:toggle_headlights": {
                "sequence": [
                    {
                        "sequence": [
                            {
                                "filters": {
                                    "all_of": [
                                        {
                                            "test": "bool_property",
                                            "domain": "ab_ve:light",
                                            "value": false
                                        }
                                    ]
                                },
                                "set_property": {
                                    "ab_ve:light": true
                                },
                                "queue_command": {
                                    "command": [
                                        "playsound ab_ve.cars.light_on @a[r=3]"
                                    ]
                                }
                            },
                            {
                                "filters": {
                                    "all_of": [
                                        {
                                            "test": "bool_property",
                                            "domain": "ab_ve:light",
                                            "value": true
                                        }
                                    ]
                                },
                                "set_property": {
                                    "ab_ve:light": false
                                },
                                "queue_command": {
                                    "command": [
                                        "playsound ab_ve.cars.light_off @a[r=3]"
                                    ]
                                }
                            }
                        ]
                    }
                ]
            },
