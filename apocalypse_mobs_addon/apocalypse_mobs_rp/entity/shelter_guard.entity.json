{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "apoc:shelter_guard",
      "enable_attachables": true,
      "materials": { "default": "entity_alphatest" },
      "textures": { "default": "textures/entity/shelter_guard" },
      "geometry": { "default": "geometry.apoc.infected" },
      "animations": {
        "base": "animation.humanoid.base_pose",
        "move": "animation.humanoid.move",
        "look": "animation.humanoid.look_at_target.default",
        "hold": "animation.guns.hold_npc",
        "attack": "animation.humanoid.attack.rotations"
      },
      "scripts": {
        "pre_animation": [
          "variable.tcos0 = (math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / 1.0) * 57.3;"
        ],
        "animate": ["base", "move", "look", "hold", "attack"]
      },
      "render_controllers": ["controller.render.default"],
      "spawn_egg": { "base_color": "#2C3E50", "overlay_color": "#27AE60" }
    }
  }
}
