{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.survival.gun_states": {
      "initial_state": "equip",
      "states": {
        "equip": {
          "animations": [ "equip" ],
          "transitions": [ { "idle": "query.any_animation_finished" } ]
        },
        "idle": {
          "animations": [ "idle" ],
          "transitions": [
            { "reload": "query.has_tag('survival_reloading')" },
            { "ads": "query.is_sneaking" },
            { "sprint": "query.is_sprinting && !query.is_in_water" },
            { "swim": "query.is_swimming && query.is_in_water" }
          ]
        },
        "ads": {
          "animations": [ "ads" ],
          "transitions": [
            { "reload": "query.has_tag('survival_reloading')" },
            { "idle": "!query.is_sneaking" }
          ]
        },
        "sprint": {
          "animations": [ "sprint" ],
          "transitions": [
            { "reload": "query.has_tag('survival_reloading')" },
            { "idle": "!query.is_sprinting" },
            { "swim": "query.is_swimming && query.is_in_water" }
          ]
        },
        "swim": {
          "animations": [ "swim" ],
          "transitions": [
            { "reload": "query.has_tag('survival_reloading')" },
            { "idle": "!query.is_swimming || !query.is_in_water" }
          ]
        },
        "reload": {
          "animations": [ "reload" ],
          "transitions": [ { "idle": "!query.has_tag('survival_reloading')" } ]
        }
      }
    }
  }
}
