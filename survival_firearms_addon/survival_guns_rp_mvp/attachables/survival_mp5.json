{
  "format_version": "1.20.30",
  "minecraft:attachable": {
    "description": {
      "identifier": "survival:mp5",
      "item": { "survival:mp5": "query.is_owner_identifier_any('minecraft:player')" },
      "materials": { "default": "entity" },
      "textures": { "default": "textures/entity/temporary_deadzone_assets/mp5" },
      "geometry": { "default": "geometry.mp5" },
      "render_controllers": [ "controller.render.item_default" ]
    }
  }
}
