{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "survival:mp5",
      "materials": { "default": "entity_alphatest" },
      "textures": { "default": "textures/entity/temporary_deadzone_assets/mp5" },
      "geometry": { "default": "geometry.mp5" },
      "animations": {
        "controller": "controller.animation.survival.gun_states",
        "equip": "animation.guns.draw", "idle": "animation.guns.hold",
        "ads": "animation.guns.aim", "sprint": "animation.guns.sprint",
        "swim": "animation.guns.back", "reload": "animation.slap.reload_full",
        "fire": "animation.mp5.shoots"
      },
      "scripts": { "animate": [ "controller" ] },
      "sound_effects": { "draw.sound": "gun.draw" },
      "particle_effects": { "muzzle.flash": "minecraft:basic_flame_particle" },
      "render_controllers": [ "controller.render.survival_gun" ]
    }
  }
}
