{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "survival:m1911",
      "materials": { "default": "entity_alphatest" },
      "textures": { "default": "textures/entity/temporary_deadzone_assets/m1911" },
      "geometry": { "default": "geometry.m1911" },
      "animations": {
        "controller": "controller.animation.survival.gun_states",
        "equip": "animation.pistol.draw", "idle": "animation.pistol.hold",
        "ads": "animation.pistol.aim", "sprint": "animation.pistol.sprint",
        "swim": "animation.pistol.waist", "reload": "animation.pistol.reload_full",
        "fire": "animation.m1911.shoots"
      },
      "scripts": { "animate": [ { "controller": "context.is_first_person" } ] },
      "sound_effects": { "draw.sound": "gun.draw" },
      "particle_effects": { "muzzle.flash": "minecraft:basic_flame_particle" },
      "render_controllers": [ "controller.render.default" ]
    }
  }
}
