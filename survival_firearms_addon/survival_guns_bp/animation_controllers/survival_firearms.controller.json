{
  "format_version": "1.21.0",
  "animation_controllers": {
    "controller.animation.survival.firearms": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "transitions": [
            { "m1911_fire": "q.is_item_name_any('slot.weapon.mainhand','survival:m1911') && q.main_hand_item_use_duration > 0 && q.is_alive" },
            { "akm_fire_a": "q.is_item_name_any('slot.weapon.mainhand','survival:akm') && q.main_hand_item_use_duration > 0 && q.is_alive" },
            { "mp5_fire_a": "q.is_item_name_any('slot.weapon.mainhand','survival:mp5') && q.main_hand_item_use_duration > 0 && q.is_alive" },
            { "m870_fire": "q.is_item_name_any('slot.weapon.mainhand','survival:m870') && q.main_hand_item_use_duration > 0 && q.is_alive" }
          ]
        },
        "m1911_fire": {
          "animations": ["survival_fire_m1911"],
          "on_entry": ["/scriptevent survival:fire m1911"],
          "transitions": [
            { "idle": "!q.is_alive || !q.is_item_name_any('slot.weapon.mainhand','survival:m1911')" },
            { "m1911_wait_release": "q.all_animations_finished" }
          ]
        },
        "m1911_wait_release": {
          "transitions": [
            { "idle": "q.main_hand_item_use_duration <= 0 || !q.is_item_name_any('slot.weapon.mainhand','survival:m1911') || !q.is_alive" }
          ]
        },
        "akm_fire_a": {
          "animations": ["survival_fire_akm"],
          "on_entry": ["/scriptevent survival:fire akm"],
          "transitions": [
            { "idle": "q.main_hand_item_use_duration <= 0 || !q.is_item_name_any('slot.weapon.mainhand','survival:akm') || !q.is_alive" },
            { "akm_fire_b": "q.all_animations_finished" }
          ]
        },
        "akm_fire_b": {
          "animations": ["survival_fire_akm"],
          "on_entry": ["/scriptevent survival:fire akm"],
          "transitions": [
            { "idle": "q.main_hand_item_use_duration <= 0 || !q.is_item_name_any('slot.weapon.mainhand','survival:akm') || !q.is_alive" },
            { "akm_fire_a": "q.all_animations_finished" }
          ]
        },
        "mp5_fire_a": {
          "animations": ["survival_fire_mp5"],
          "on_entry": ["/scriptevent survival:fire mp5"],
          "transitions": [
            { "idle": "q.main_hand_item_use_duration <= 0 || !q.is_item_name_any('slot.weapon.mainhand','survival:mp5') || !q.is_alive" },
            { "mp5_fire_b": "q.all_animations_finished" }
          ]
        },
        "mp5_fire_b": {
          "animations": ["survival_fire_mp5"],
          "on_entry": ["/scriptevent survival:fire mp5"],
          "transitions": [
            { "idle": "q.main_hand_item_use_duration <= 0 || !q.is_item_name_any('slot.weapon.mainhand','survival:mp5') || !q.is_alive" },
            { "mp5_fire_a": "q.all_animations_finished" }
          ]
        },
        "m870_fire": {
          "animations": ["survival_fire_m870"],
          "on_entry": ["/scriptevent survival:fire m870"],
          "transitions": [
            { "idle": "!q.is_alive || !q.is_item_name_any('slot.weapon.mainhand','survival:m870')" },
            { "m870_wait_release": "q.all_animations_finished" }
          ]
        },
        "m870_wait_release": {
          "transitions": [
            { "idle": "q.main_hand_item_use_duration <= 0 || !q.is_item_name_any('slot.weapon.mainhand','survival:m870') || !q.is_alive" }
          ]
        }
      }
    }
  }
}
