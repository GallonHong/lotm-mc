{
  "namespace": "server_form",

  "long_form": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          { "binding_name": "#title_text" },
          {
            "binding_type": "view",
            "source_property_name": "((#title_text - '§l§2末日生存联盟§r') = #title_text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },

  "main_screen_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "apoc_survival_factory": {
              "type": "panel",
              "factory": {
                "name": "server_form_factory",
                "control_ids": {
                  "long_form": "@server_form.apoc_survival_form"
                }
              }
            }
          }
        ]
      }
    ]
  },

  "apoc_survival_form@common_dialogs.main_panel_no_buttons": {
    "$title_panel": "common_dialogs.standard_title_label",
    "$title_size": ["100% - 14px", 14],
    "size": [560, 326],
    "$text_name": "#title_text",
    "$title_text_binding_type": "none",
    "$child_control": "server_form.apoc_survival_panel",
    "layer": 3,
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(#title_text = '§l§2末日生存联盟§r')",
        "target_property_name": "#visible"
      }
    ]
  },

  "apoc_survival_panel": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": ["100%", "100%"],
    "collection_name": "form_buttons",
    "controls": [
      {
        "apoc_status": {
          "type": "label",
          "text": "#form_text",
          "size": ["100% - 14px", 46],
          "offset": [7, 3],
          "color": [0.84, 0.88, 0.77],
          "font_size": "small",
          "layer": 5,
          "bindings": [{ "binding_name": "#form_text" }]
        }
      },
      {
        "apoc_top": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [548, 148],
          "offset": [6, 2],
          "collection_name": "form_buttons",
          "controls": [
            {
              "apoc_top_left": {
                "type": "stack_panel",
                "orientation": "vertical",
                "size": [160, 148],
                "collection_name": "form_buttons",
                "controls": [
                  {
                    "apoc_left_row_1": {
                      "type": "stack_panel",
                      "orientation": "horizontal",
                      "size": [160, 74],
                      "collection_name": "form_buttons",
                      "controls": [
                        { "apoc_shop@server_form.apoc_picture_tile": { "$texture": "textures/ui/apocalypse/shop", "$label": "全球商店", "$slot": [80, 74], "$button": [76, 70], "collection_index": 7 } },
                        { "apoc_lottery@server_form.apoc_picture_tile": { "$texture": "textures/ui/apocalypse/lottery", "$label": "幸运抽奖", "$slot": [80, 74], "$button": [76, 70], "collection_index": 9 } }
                      ]
                    }
                  },
                  {
                    "apoc_left_row_2": {
                      "type": "stack_panel",
                      "orientation": "horizontal",
                      "size": [160, 74],
                      "collection_name": "form_buttons",
                      "controls": [
                        { "apoc_bank@server_form.apoc_picture_tile": { "$texture": "textures/ui/apocalypse/bank", "$label": "个人银行", "$slot": [80, 74], "$button": [76, 70], "collection_index": 6 } },
                        { "apoc_market@server_form.apoc_picture_tile": { "$texture": "textures/ui/apocalypse/market", "$label": "玩家寄卖", "$slot": [80, 74], "$button": [76, 70], "collection_index": 10 } }
                      ]
                    }
                  }
                ]
              }
            },
            { "apoc_world_event@server_form.apoc_picture_tile": { "$texture": "textures/ui/apocalypse/world_event", "$label": "联盟委托 · 世界事件", "$slot": [236, 148], "$button": [232, 144], "collection_index": 3 } },
            {
              "apoc_top_right": {
                "type": "stack_panel",
                "orientation": "vertical",
                "size": [152, 148],
                "collection_name": "form_buttons",
                "controls": [
                  { "apoc_welfare@server_form.apoc_picture_tile": { "$texture": "textures/ui/apocalypse/lottery", "$label": "每日福利", "$slot": [152, 74], "$button": [148, 70], "collection_index": 2 } },
                  { "apoc_dungeon@server_form.apoc_picture_tile": { "$texture": "textures/ui/apocalypse/world_event", "$label": "副本行动", "$slot": [152, 74], "$button": [148, 70], "collection_index": 4 } }
                ]
              }
            }
          ]
        }
      },
      {
        "apoc_bottom": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [548, 88],
          "offset": [6, 3],
          "collection_name": "form_buttons",
          "controls": [
            { "apoc_public_warp@server_form.apoc_picture_tile": { "$texture": "textures/ui/apocalypse/teleport", "$label": "公共传送", "$slot": [137, 88], "$button": [133, 84], "collection_index": 0 } },
            { "apoc_personal@server_form.apoc_picture_tile": { "$texture": "textures/ui/apocalypse/home", "$label": "个人传送", "$slot": [137, 88], "$button": [133, 84], "collection_index": 1 } },
            { "apoc_land@server_form.apoc_picture_tile": { "$texture": "textures/ui/apocalypse/land", "$label": "地皮领地", "$slot": [137, 88], "$button": [133, 84], "collection_index": 8 } },
            { "apoc_extraction@server_form.apoc_picture_tile": { "$texture": "textures/ui/apocalypse/extraction", "$label": "末日摸金都市", "$slot": [137, 88], "$button": [133, 84], "collection_index": 5 } }
          ]
        }
      },
      { "apoc_more@server_form.apoc_picture_tile": { "$texture": "textures/ui/apocalypse/more", "$label": "更多功能 · 排行 · 秘典 · 管理", "$slot": [548, 36], "$button": [544, 32], "collection_index": 11, "offset": [6, 2] } }
    ]
  },

  "apoc_picture_tile": {
    "$texture|default": "textures/ui/apocalypse/more",
    "$label|default": "功能",
    "$slot|default": [80, 74],
    "$button|default": [76, 70],
    "type": "panel",
    "size": "$slot",
    "controls": [
      {
        "apoc_tile_inner": {
          "type": "panel",
          "size": "$button",
          "controls": [
            {
              "apoc_tile_art": {
                "type": "image",
                "texture": "$texture",
                "size": ["100%", "100%"],
                "layer": 2,
                "propagate_alpha": true,
                "ignored": true
              }
            },
            {
              "apoc_tile_scrim": {
                "type": "image",
                "texture": "textures/ui/apocalypse/scrim",
                "size": ["100%", 25],
                "anchor_from": "bottom_middle",
                "anchor_to": "bottom_middle",
                "alpha": 0.62,
                "layer": 3,
                "ignored": true
              }
            },
            {
              "apoc_tile_label": {
                "type": "label",
                "text": "$label",
                "size": ["100% - 8px", 23],
                "anchor_from": "bottom_middle",
                "anchor_to": "bottom_middle",
                "offset": [0, -1],
                "text_alignment": "center",
                "color": [0.96, 0.93, 0.82],
                "font_size": "small",
                "shadow": true,
                "layer": 4,
                "ignored": true
              }
            },
            {
              "apoc_tile_click": {
                "type": "button",
                "size": ["100%", "100%"],
                "layer": 10,
                "default_control": "default",
                "hover_control": "hover",
                "pressed_control": "pressed",
                "sound_name": "random.click",
                "controls": [
                  { "default": { "type": "panel", "size": ["100%", "100%"] } },
                  { "hover": { "type": "image", "texture": "textures/ui/apocalypse/highlight", "alpha": 0.16, "size": ["100%", "100%"] } },
                  { "pressed": { "type": "image", "texture": "textures/ui/apocalypse/scrim", "alpha": 0.28, "size": ["100%", "100%"] } }
                ],
                "bindings": [
                  {
                    "binding_type": "collection_details",
                    "binding_collection_name": "form_buttons"
                  }
                ],
                "button_mappings": [
                  {
                    "from_button_id": "button.menu_select",
                    "to_button_id": "button.form_button_click",
                    "mapping_type": "pressed",
                    "button_up": true
                  },
                  {
                    "from_button_id": "button.menu_ok",
                    "to_button_id": "button.form_button_click",
                    "mapping_type": "focused"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
