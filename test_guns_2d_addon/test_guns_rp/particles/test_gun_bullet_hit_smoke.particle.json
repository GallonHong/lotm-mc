{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "test_gun:bullet_hit_smoke",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 3
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.22, 0.30)"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 180)"
      },
      "minecraft:particle_initial_speed": "math.random(0.5, 1.2)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.random(-0.3, 0.3)",
          "math.random(0.3, 0.8)",
          "math.random(-0.3, 0.3)"
        ],
        "linear_drag_coefficient": 2.2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.08 + (v.particle_age / v.particle_lifetime) * 0.20",
          "0.08 + (v.particle_age / v.particle_lifetime) * 0.20"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [
              32,
              72
            ],
            "size_UV": [
              8,
              8
            ],
            "step_UV": [
              -8,
              0
            ],
            "frames_per_second": 4,
            "max_frame": 4,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.05": "#F2FFF219",
            "0.15": "#70444444",
            "1.0": "#005E5E5E"
          }
        }
      }
    }
  }
}