{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.ak74u_old": {
			"initial_state": "inactive",
			"states": {
				"inactive": {
					"transitions": [
						{
							"fire": "q.get_equipped_item_name(0) == 'ak74u_old' && q.is_using_item && (q.scoreboard('ak74u') >= 1) && (q.scoreboard('reload') != 4)"
						}
					]
				},
				"firing": {
					"on_entry": [
						"v.bullet_fire = q.life_time;"
					],
					"transitions": [
						{
							"inactive": "q.get_equipped_item_name(0) != 'ak74u_old' || !q.is_using_item || (q.scoreboard('ak74u') == 0) || (q.scoreboard('reload') == 4)"
						},
						{
							"fire": "(q.life_time - v.bullet_fire) >= 0.05"
						}
					]
				},
				"fire": {
					"on_entry": [
						"@s ak74u_old:fire",
						"/scoreboard players remove @s[m=!c,scores={ak74u=1..30}] ak74u 1",
						"/particle minecraft:eyeofender_death_explode_particle ^ ^1 ^1",
						"/camerashake add @s 0.253 0.1 rotational",
                                                "/execute @s[scores={ak74u=0}] ~~~ function show408_2",
						"/summon sound:ak74u_old ^^^"
					],
					"transitions": [
						{
							"firing": "1.0"
						}
					],
					"on_exit": [
						"v.bullet_fire = q.life_time;"
					]
				}
			}
		}
	}
}