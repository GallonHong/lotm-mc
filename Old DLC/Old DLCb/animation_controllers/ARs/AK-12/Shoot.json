{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.ak12_old": {
			"initial_state": "inactive",
			"states": {
				"inactive": {
					"transitions": [
						{
							"fire": "q.get_equipped_item_name(0) == 'ak12_old' && q.is_using_item && (q.scoreboard('ak12') >= 1) && (q.scoreboard('reload') != 4)"
						}
					]
				},
				"firing": {
					"on_entry": [
						"v.bullet_fire = q.life_time;"
					],
					"transitions": [
						{
							"inactive": "q.get_equipped_item_name(0) != 'ak12_old' || !q.is_using_item || (q.scoreboard('ak12') == 0) || (q.scoreboard('reload') == 4)"
						},
						{
							"fire": "(q.life_time - v.bullet_fire) >= 0.07"
						}
					]
				},
				"fire": {
					"on_entry": [
						"@s ak12_old:fire",
						"/scoreboard players remove @s[m=!c,scores={ak12=1..30}] ak12 1",
						"/particle minecraft:eyeofender_death_explode_particle ^ ^1 ^1",
						"/camerashake add @s 0.09 0.1 rotational",
						"/summon sound:ak12_old ^^^"
					],
					"transitions": [
						{
							"firing": "1.0"
						}
					],
					"on_exit": [
						"v.bullet_fire = q.life_time;"
					]
				}
			}
		}
	}
}