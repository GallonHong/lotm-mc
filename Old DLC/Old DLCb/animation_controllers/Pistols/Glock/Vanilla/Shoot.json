{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.glock_old": {
			"initial_state": "inactive",
			"states": {
				"inactive": {
					"transitions": [
						{
							"fire": "q.get_equipped_item_name(0) == 'glock_old' && q.is_using_item"
						}
					]
				},
				"firing": {
					"on_entry": [
						"v.bullet_fire = q.life_time;"
					],
					"transitions": [
						{
							"inactive": "q.get_equipped_item_name(0) != 'glock_old' || !q.is_using_item"
						},
						{
							"fire": "(q.life_time - v.bullet_fire) >= 0.30"
						}
					]
				},
				"fire": {
					"on_entry": [
						"@s glock_old:fire",
						"/scoreboard players remove @s[m=!c,scores={glock=1..20}] glock 1",
						"/particle minecraft:eyeofender_death_explode_particle ^ ^1 ^1",
						"/camerashake add @s 0.18 0.1 rotational",
"/execute @s[scores={glock=0}] ~~~ function show407_2",
						"/summon sound:glock_old ^^^"
					],
					"transitions": [
						{
							"firing": "1.0"
						}
					],
					"on_exit": [
						"v.bullet_fire = q.life_time;"
					]
				}
			}
		}
	}
}